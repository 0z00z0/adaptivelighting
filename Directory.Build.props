<Project>

  <!--
    Shared build + package metadata. Each project adds only its own PackageId and Description.
    Version is set here so the three packages always ship as a matched set: the engine, the UI and the
    extensions are compiled against each other, so a mixed set is not a supported combination.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0-preview.1</Version>
    <Authors>0z00z0</Authors>
    <PackageProjectUrl>https://github.com/0z00z0/adaptivelighting</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0z00z0/adaptivelighting</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>netdaemon;home-assistant;homeassistant;lighting;circadian;adaptive-lighting;home-automation</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Source Link: a stack trace from someone else's house should lead back to real source. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The code documents intent, not every public member; CS1591 would be noise, not a finding. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
