<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>NetDaemon_Test</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest" Version="3.6.3" />
    <PackageReference Include="Microsoft.Reactive.Testing" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AdaptiveLighting\AdaptiveLighting.csproj" />
    <!--
      AdaptiveLighting.Web is here for AreaOption and for the Starts picker: the area picker's label is what
      tells somebody an area resolves to no lights before they save it, and a label nobody tests is a label
      that quietly rots into the entity count it replaced. PeriodStartEditorTests does render a component, but
      through the shared framework's own HtmlRenderer, so this still costs a reference and nothing else.
    -->
    <ProjectReference Include="..\..\src\AdaptiveLighting.Web\AdaptiveLighting.Web.csproj" />
    <ProjectReference Include="..\..\src\AdaptiveLighting.Extensions\AdaptiveLighting.Extensions.csproj" />
    <!--
      AdaptiveLighting.NetDaemon is the one reference here that pulls in a web host. It earns that: the
      registration it performs is the whole product of the package, and the key-ring guard it carries had a bug
      that no test would have caught because nothing else in this suite builds a WebApplicationBuilder.
    -->
    <ProjectReference Include="..\..\src\AdaptiveLighting.NetDaemon\AdaptiveLighting.NetDaemon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="AdaptiveLighting.Extensions" />
  </ItemGroup>

</Project>
