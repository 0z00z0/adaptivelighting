<?xml version="1.0" encoding="utf-8"?>
<!--
	The core test set: about a tenth of the suite, chosen by hand.
	A test is here when its failure would reach a person in a house, or when it guards a stored value that must
	never change. Wording, layout and cosmetic tests are left to the full suite.
	Rule, commands and upkeep: docs/mechanisms.md, "Running the tests".
	A whole class is named with ~ and a trailing dot, so its new and renamed tests stay in.
	Everything else is named exactly with =, and a renamed test silently leaves the set until its line is updated.
-->
<RunSettings>
	<RunConfiguration>
		<TestCaseFilter>
			<!-- Override detection, away decided by the house mode, stored raw brightness: whole classes. -->
			FullyQualifiedName~AdaptiveLighting.Tests.Lighting.OverrideDetectorTests.
			| FullyQualifiedName~AdaptiveLighting.Tests.Lighting.ConfiguredAwayTests.
			| FullyQualifiedName~AdaptiveLighting.Tests.Lighting.RawBrightnessStorageTests.

			<!-- A room: auto-on gates, vacancy and pre-off, manual override, away sweep, sleep, adoption. -->
			| FullyQualifiedName=AdaptiveLighting.Tests.Lighting.AreaControllerTests.Motion_When_Dark_Turns_The_Area_On_At_The_Periods_Levels
			| FullyQualifiedName=AdaptiveLighting.Tests.Lighting.AreaControllerTests.Motion_When_Not_Dark_Is_Logged_But_Not_Acted_On
			| FullyQualifiedName=AdaptiveLighting.Tests.Lighting.AreaControllerTests.Auto_On_Is_Blocked_While_An_IgnoreWhenOn_Entity_Is_On
