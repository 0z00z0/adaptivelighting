@inherits LayoutComponentBase

@* The sprite is hosted here and never by a page: two copies mean two elements per glyph id, and <use>
   resolves to whichever the browser saw first. *@
<IconSprite />

<div class="shell">
	<header class="topbar">
		<div class="brand">
			<Icon Name="@Glyph.App" Class="brand-mark" Label="Adaptive lighting" />
			<span class="brand-text">Adaptive lighting</span>
		</div>
		<nav class="nav">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
			<NavLink class="nav-link" href="activity">Activity</NavLink>
			<NavLink class="nav-link" href="config">Configuration</NavLink>
		</nav>
		<ThemePicker />
		@* In the bar and not the footer: nothing here is sticky, so a footer link on the Configuration page
		   is only reachable after a full scroll. The wording is hidden, not dropped, below 560px. *@
		@* aria-label and not a labelled Icon: the wording is on screen at desktop width, so labelling both
		   reads it twice, and the anchor still has a name once only the glyph is showing. *@
		<a class="feedback-link" href="@FeedbackHref" target="_blank" rel="noopener"
		   aria-label="Give feedback" title="Give feedback">
			<Icon Name="@Glyph.Feedback" Class="ic-sm" />
			<span class="feedback-link-text">Give feedback</span>
		</a>
	</header>

	<main class="content">
		@Body
	</main>

	<footer class="footer">
		<span class="footer-warn">
			LAN only &mdash; no login. Anyone on your network can change these settings.
		</span>
	</footer>
</div>

@code {
	// Built once: the version cannot change while the process runs, and this renders on every page.
	private static readonly string FeedbackHref = FeedbackUrl.Build(AppVersion.Text);
}
