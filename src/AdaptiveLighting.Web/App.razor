<!DOCTYPE html>
<html lang="en-GB">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<title>Adaptive lighting</title>
	@* Every asset carries ?v=: without it a browser keeps its cached app.css across a deploy. *@
	<link rel="stylesheet" href="@($"_content/AdaptiveLighting.Web/app.css?v={Build}")" />
	@* After app.css: a control's rule has to win a tie with the generic element rules there. *@
	<link rel="stylesheet" href="@($"_content/AdaptiveLighting.Web/controls.css?v={Build}")" />
	<link rel="icon" type="image/svg+xml" href="_content/AdaptiveLighting.Web/favicon.svg" />
	@* Blocking and above the body: the server paints this page, so a theme applied after render arrives a repaint
		late. data-themes is the allow-list, and an id outside it falls back to the device. *@
	<script src="@($"_content/AdaptiveLighting.Web/theme.js?v={Build}")" data-themes="@AppThemes.DataThemeIds"></script>
	<HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
	<Routes @rendermode="InteractiveServer" />
	<script src="@($"_content/AdaptiveLighting.Web/lux-curve.js?v={Build}")"></script>
	<script src="@($"_content/AdaptiveLighting.Web/preset-slider.js?v={Build}")"></script>
	<script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
	private static readonly string Build = AssetToken.Text;
}
