@*
	The root component. Lives in the RCL, not the host, so a host's whole web payload is one
	MapRazorComponents<App>() call in program.cs.
*@
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<title>Adaptive lighting</title>
	@*
		Every asset carries ?v=. Without it a browser keeps its cached app.css after a deploy, so a fixed layout
		stays broken on the deployed machine and looks fine on the development one.
	*@
	<link rel="stylesheet" href="@($"_content/AdaptiveLighting.Web/app.css?v={Build}")" />
	<link rel="icon" type="image/svg+xml" href="_content/AdaptiveLighting.Web/favicon.svg" />
	@*
		Blocking and above the body on purpose. The server paints this page, so a theme applied after render arrives
		a repaint late. data-themes is the allow-list: an id from a withdrawn theme falls back to the device.
	*@
	<script src="@($"_content/AdaptiveLighting.Web/theme.js?v={Build}")" data-themes="@AppThemes.DataThemeIds"></script>
	<HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
	<Routes @rendermode="InteractiveServer" />
	@* End of body: this decides nothing about the first paint, and it is needed on one page. *@
	<script src="@($"_content/AdaptiveLighting.Web/lux-curve.js?v={Build}")"></script>
	<script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
	/// <summary>
	///     The cache-busting token on every asset URL.
	/// </summary>
	/// <remarks>
	///     The commit sha Source Link puts after the '+' in the informational version, because the version number
	///     alone is bumped per release and two deploys off one preview would share a URL.
	/// </remarks>
	private static readonly string Build = BuildToken();

	private static string BuildToken()
	{
		string version = System.Reflection.CustomAttributeExtensions
			.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(App).Assembly)
			?.InformationalVersion
			?? typeof(App).Assembly.GetName().Version?.ToString()
			?? "0";

		int plus = version.IndexOf('+');
		string token = plus >= 0 ? version[(plus + 1)..] : version;

		return token.Length > 12 ? token[..12] : token;
	}
}
