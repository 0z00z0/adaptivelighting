@*
	The (i) beside a control, revealing the longer "what it does and why you'd change it".

	A button, not a hover title, so a phone and a keyboard both reach it. The panel is a floating card
	on a desktop and a fixed bottom sheet under 560px. All plain CSS, no script: nothing for the CSP to
	refuse. Escape, the icon, the Close button and the scrim all close it.
*@

<span class="info" @onkeydown="OnKeyDown">
	<button type="button"
			class="info-icon"
			aria-expanded="@(_open ? "true" : "false")"
			aria-label="@($"More about {Label}")"
			title="@($"More about {Label}")"
			@onclick="Toggle">i</button>

	@if (_open)
	{
		@*
			A span and aria-hidden: Escape and the Close button are the accessible ways out, so this need not
			be a control.

			preventDefault is load-bearing. Nearly every (i) sits inside a <label>, and a click on any
			descendant of a label is forwarded to the first labelable element inside it, which here is the (i)
			button. Without it the scrim closes the panel and the forwarded click reopens it at once.
		*@
		<span class="info-scrim" aria-hidden="true" @onclick="Close" @onclick:preventDefault="true"></span>

		<span class="info-panel" role="note">
			<span class="info-title">@Label</span>
			<span class="info-body">@ChildContent</span>
			<button type="button" class="info-close" @onclick="Toggle">Close</button>
		</span>
	}
</span>

@code {
	/// <summary>What the icon explains. Titles the panel and names the icon for a screen reader.</summary>
	[Parameter, EditorRequired]
	public string Label { get; set; } = "";

	/// <summary>The explanation itself: what this does, and why somebody would change it.</summary>
	[Parameter, EditorRequired]
	public RenderFragment? ChildContent { get; set; }

	private bool _open;

	private void Toggle() => _open = !_open;

	/// <summary>Shuts the panel. Separate from <see cref="Toggle"/>: a scrim wired to the toggle would reopen it.</summary>
	private void Close() => _open = false;

	private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
	{
		if (args.Key == "Escape")
			_open = false;
	}
}
