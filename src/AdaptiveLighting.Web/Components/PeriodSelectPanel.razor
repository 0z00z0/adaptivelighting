@*
	Ties a Home Assistant dropdown helper to the engine's period table, in either direction.

	The picker, the direction switch and the unknown-entity notice are SelectAuthorityPanel's, shared with the
	house mode. The rows come from the helper's live options, not from the document; a stored row the helper no
	longer offers is shown apart as the rename case and can be moved onto a live option.
*@

<div class="periodselect">
	<SelectAuthorityPanel Label="Dropdown helper"
						  Entity="@Select?.Entity"
						  EntityChanged="@EntityChanged"
						  Entities="@InputSelects"
						  NameResolver="@NameResolver"
						  KnownResolver="@KnownResolver"
						  NoneLabel="(none — the schedule decides the time of day)"
						  EmptyNote="@EmptyNote"
						  Placeholder="input_select.tid_pa_dagnet"
						  Group="period-authority"
						  AuthorityLabel="Changes to periods are set by:"
						  HomeAssistant="@(Authority == PeriodAuthority.HomeAssistant)"
						  HomeAssistantChanged="@SetAuthority"
						  AuthorityNote="@AuthorityNote"
						  UnavailableNote="@UnavailableNote"
						  IsAvailable="@IsAvailable"
						  IsReady="@IsReady"
						  LiveOptions="@LiveOptions">
		<LabelHelp>
			Which <code>input_select</code> holds the time of day. No helper yet? Make one in Home Assistant
			under <strong>Settings &rarr; Devices &amp; services &rarr; Helpers &rarr; Create helper &rarr;
			Dropdown</strong>, give it one option per period, then pick it here.
		</LabelHelp>
		<Note>
			Without one, periods change at the start times in the schedule above and nothing else is read or written.
		</Note>
		<AuthorityHelp>
			<strong>Home Assistant</strong> means the engine follows this dropdown: whatever option it
			stands on names the period every room runs, and the start times in the schedule stop
			deciding anything. <strong>Adaptive lighting</strong> means the engine decides from its own
			schedule and keeps the dropdown pointing at the answer, so the rest of your house can read it.
		</AuthorityHelp>
		<Body Context="state">
			@* Faults in the order they cost the household: an unreadable helper first, then an unmapped current
			   option, the one fault already happening. *@
			@if (!state.ShowsUnavailable && CurrentIsUnmapped)
			{
				<div class="notice warn periodselect-warning">
					<strong>The helper is on &ldquo;@ActiveValue&rdquo;, and nothing maps it to a period.</strong>
					<span>@UnmappedNote</span>
				</div>
			}

			@if (Shortfall > 0)
			{
				<div class="notice periodselect-warning">
					<strong>@ShortfallTitle</strong>
					<span>
						Every option needs a period of its own &mdash; two options cannot share one, because the engine
						would have no way to tell them apart.
					</span>
					<div class="panel-actions">
						<button type="button" @onclick="AddPeriod">Add a period</button>
					</div>
				</div>
			}

			@if (state.LiveValues.Count == 0)
			{
				<div class="empty">
					@if (state.IsReady)
					{
						<text>This helper has no options yet. Add one option per period in Home Assistant, then come back here.</text>
					}
					else
					{
						<text>Waiting for Home Assistant to list the helper's options.</text>
					}
				</div>
			}
			else
			{
				<div class="periodselect-rows">
					@foreach (string live in state.LiveValues)
					{
						@* Captured per iteration: the handlers outlive the loop, and a closure over the loop variable
						   would map every row to whichever option was last. *@
						string option = live;
						PeriodSelectOptionConfig? row = Find(option);
						string chosen = row?.PeriodId ?? string.Empty;

						<div class="periodselect-row" @key="option">
							<span class="periodselect-option">
								<code>@option</code>
								@if (IsActive(option))
								{
									<span class="badge active-now" title="The helper is standing on this option right now.">now</span>
								}
							</span>

							<select class="cell wide" @bind:get="chosen" @bind:set="@(value => SetPeriod(option, value))">
								<option value="">(none — this option changes nothing)</option>
								@foreach (TimePeriodConfig period in PeriodChoices(chosen))
								{
									<option value="@period.Key">@period.Name</option>
								}
								@if (IsDeadPeriod(chosen))
								{
									<option value="@chosen">@chosen — no such period</option>
								}
							</select>
						</div>
					}
				</div>
			}

			@if (Orphans.Count > 0)
			{
				<div class="periodselect-orphans">
					@foreach (PeriodSelectOptionConfig stale in Orphans)
					{
						PeriodSelectOptionConfig orphan = stale;

						<div class="periodselect-orphan" @key="orphan">
							<span class="badge bad" title="This value is no longer one of the helper's options.">renamed in Home Assistant</span>
							<span class="periodselect-orphan-text">
								<code>@orphan.Value</code> means <b>@OrphanPeriod(orphan)</b>, and the helper no longer offers it.
							</span>

							@if (UnmappedLiveValues.Count > 0)
							{
								<select class="cell" value="" @onchange="@(args => Remap(orphan, args.Value as string))">
									<option value="">move it to&hellip;</option>
									@foreach (string free in UnmappedLiveValues)
									{
										<option value="@free">@free</option>
									}
								</select>
							}

							<button type="button" class="danger" @onclick="@(() => Forget(orphan))">Remove</button>
						</div>
					}
				</div>
			}
		</Body>
	</SelectAuthorityPanel>
</div>

@code {
	/// <summary>The house settings, which own <see cref="GlobalConfig.PeriodSelect"/> and are edited in place.</summary>
	[Parameter, EditorRequired]
	public GlobalConfig Global { get; set; } = new();

	/// <summary>The document's period list, edited in place, only ever by appending a <c>PeriodsEditor.NewPeriod</c>.</summary>
	[Parameter, EditorRequired]
	public List<TimePeriodConfig> Periods { get; set; } = [];

	/// <summary>The <c>input_select</c> entities the helper picker offers.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> InputSelects { get; set; } = [];

	/// <summary>
	///     The helper's live options. Empty means Home Assistant has not answered, never "the helper has no
	///     options"; see <see cref="IsReady"/>.
	/// </summary>
	[Parameter]
	public IReadOnlyList<string> LiveOptions { get; set; } = [];

	/// <summary>The helper's current option, or <c>null</c> when it is unknown or unavailable.</summary>
	[Parameter]
	public string? ActiveValue { get; set; }

	/// <summary>Whether Home Assistant knows the configured entity at all.</summary>
	[Parameter]
	public bool IsAvailable { get; set; }

	/// <summary>Whether Home Assistant is answering, so an empty option list can say which of the two it is.</summary>
	[Parameter]
	public bool IsReady { get; set; } = true;

	[Parameter]
	public string EmptyNote { get; set; } = "Nothing to pick from yet — type an id instead.";

	[Parameter]
	public Func<string, string>? NameResolver { get; set; }

	[Parameter]
	public Func<string, bool>? KnownResolver { get; set; }

	/// <summary>Raised with the chosen entity id, or <c>null</c> for none.</summary>
	// The one field this component does not write itself: changing it changes which helper's live options the
	// rows are drawn from, and only the page can re-read those.
	[Parameter]
	public EventCallback<string?> EntityChanged { get; set; }

	/// <summary>Raised after any change this component made, so the page can re-validate.</summary>
	[Parameter]
	public EventCallback Changed { get; set; }

	/// <summary>The configured block, or <c>null</c> before a helper has ever been picked.</summary>
	private PeriodSelectConfig? Select => Global.PeriodSelect;

	/// <summary>Which side currently owns the time of day.</summary>
	private PeriodAuthority Authority => Select?.Authority ?? PeriodAuthority.AdaptiveLighting;

	/// <summary>The stored mappings, never <c>null</c>. A block that does not exist yet has none.</summary>
	private IReadOnlyList<PeriodSelectOptionConfig> Options => Select?.Options ?? [];

	/// <summary>The helper's live options, blank-free and de-duplicated the way every value here is compared.</summary>
	// Cached per parameter set, and safe only because it is a pure function of the LiveOptions parameter. The
	// lists that read it stay properties: they also read Options, which this component mutates between renders.
	private List<string> _liveValues = [];

	/// <inheritdoc/>
	protected override void OnParametersSet() => _liveValues = HouseModeSync.Clean(LiveOptions);

	/// <summary>Live options no mapping names yet: what an orphan can be moved onto in one pick.</summary>
	private List<string> UnmappedLiveValues =>
		[.. _liveValues.Where(value => Find(value) is null)];

	/// <summary>Stored mappings the helper no longer offers: the rename case.</summary>
	// Empty when LiveOptions is empty. That is a Home Assistant that has not answered, not a helper with no
	// options; read as an answer it strikes the entire table through the moment the connection blinks.
	private List<PeriodSelectOptionConfig> Orphans
	{
		get
		{
			List<string> live = _liveValues;

			return live.Count == 0
				? []
				: [.. Options.Where(option =>
					!string.IsNullOrWhiteSpace(option.Value)
					&& !live.Any(value => Eq(value, option.Value)))];
		}
	}

	/// <summary>Whether the helper's current option maps to nothing.</summary>
	// Only asked under Home Assistant's authority. Under adaptive lighting's the engine writes this helper, so
	// an unmapped value is one somebody moved by hand and the engine is about to correct.
	private bool CurrentIsUnmapped =>
		Authority is PeriodAuthority.HomeAssistant
		&& ActiveValue is { Length: > 0 }
		&& Select?.PeriodFor(ActiveValue) is not { Length: > 0 };

	/// <summary>How many live options cannot be mapped, because the schedule has fewer periods than the helper has options.</summary>
	private int Shortfall => Math.Max(0, _liveValues.Count - Periods.Count);

	private bool IsActive(string value) => ActiveValue is { Length: > 0 } && Eq(ActiveValue, value);

	/// <summary>The mapping for a live option, or <c>null</c> when nothing names it.</summary>
	private PeriodSelectOptionConfig? Find(string value) =>
		Options.FirstOrDefault(option => Eq(option.Value, value));

	private string OrphanPeriod(PeriodSelectOptionConfig orphan) =>
		orphan.PeriodId is { Length: > 0 } key
			? Periods.FirstOrDefault(period => Eq(period.Key, key))?.Name ?? key.Trim()
			: "no period";

	/// <summary>The periods a row may choose: the untaken ones, plus whatever this row already holds.</summary>
	// Two options mapping to one period is an ambiguity the writing direction cannot resolve, so it is not
	// offered. The row's own choice stays on the list, or remapping would be impossible.
	private List<TimePeriodConfig> PeriodChoices(string chosen)
	{
		List<string> taken = [.. Options
			.Select(option => option.PeriodId)
			.Where(periodId => !string.IsNullOrWhiteSpace(periodId) && !Eq(periodId, chosen))];

		return
		[
			.. Periods.Where(period => !taken.Any(other => Eq(period.Key, other)))
		];
	}

	/// <summary>Whether a stored choice names a period the schedule no longer has, so the dropdown must still show it.</summary>
	// The validator refuses the document over this; a dropdown that quietly reset itself would leave the
	// refusal with nothing on screen to explain it.
	private bool IsDeadPeriod(string chosen) =>
		chosen is { Length: > 0 } && !Periods.Any(period => Eq(period.Key, chosen));

	private string AuthorityNote => Authority is PeriodAuthority.HomeAssistant
		? "The engine reads this helper and never writes it. Start times in the schedule above are kept, but they "
			+ "stop deciding anything until you hand the time of day back."
		: "The engine writes this helper to match whatever its schedule resolved. Moving the helper by hand changes "
			+ "nothing — it is put back on the next re-check.";

	private string UnavailableNote => Authority is PeriodAuthority.HomeAssistant
		? "Until it appears, every room follows the schedule's start times instead. Check the id for a typo."
		: "Until it appears, the engine has nothing to write the time of day to. Check the id for a typo.";

	private string UnmappedNote =>
		"Every room is following the schedule's start times until it does. Give this option a period below, or pick "
		+ "a different one in Home Assistant.";

	private string ShortfallTitle
	{
		get
		{
			int options = _liveValues.Count;
			int periods = Periods.Count;
			string shortfall = Shortfall == 1 ? "one of them has" : $"{Shortfall} of them have";

			return $"This helper has {options} {(options == 1 ? "option" : "options")} and the schedule has "
				+ $"{periods} {(periods == 1 ? "period" : "periods")}, so {shortfall} no period to point at.";
		}
	}

	/// <summary>Sets which side owns the time of day. The mappings mean something in both directions, so they stand.</summary>
	private Task SetAuthority(bool homeAssistant) => Set(() => Block().Authority =
		homeAssistant ? PeriodAuthority.HomeAssistant : PeriodAuthority.AdaptiveLighting);

	/// <summary>Points a live option at a period, or clears it.</summary>
	// A cleared row is removed, not emptied. IsEmpty needs Value and Period both blank, so a row still carrying
	// its option string survives the normaliser and the validator then raises a document-level error, blocking
	// every save on the Configuration page.
	private Task SetPeriod(string value, string? periodId) => Set(() =>
	{
		PeriodSelectOptionConfig? existing = Find(value);

		if (string.IsNullOrWhiteSpace(periodId))
		{
			if (existing is not null)
				Block().Options.Remove(existing);

			return;
		}

		if (existing is null)
			Block().Options.Add(new PeriodSelectOptionConfig { Value = value, PeriodId = periodId.Trim() });
		else
			existing.PeriodId = periodId.Trim();
	});

	/// <summary>Moves a stale mapping onto a live option, keeping the period it named.</summary>
	private Task Remap(PeriodSelectOptionConfig orphan, string? live) =>
		string.IsNullOrWhiteSpace(live) ? Task.CompletedTask : Set(() => orphan.Value = live.Trim());

	/// <summary>Drops a stale mapping outright, for the option that was removed and not renamed.</summary>
	private Task Forget(PeriodSelectOptionConfig orphan) => Set(() => Block().Options.Remove(orphan));

	/// <summary>Appends a period, so a helper with more options than periods can be finished without leaving here.</summary>
	// PeriodsEditor.NewPeriod's row, not one built here: the two "add a period" buttons must agree.
	private Task AddPeriod() => Set(() => Periods.Add(PeriodsEditor.NewPeriod(Periods)));

	/// <summary>The block to write into, created on first use.</summary>
	// Creating it here is safe: ConfigNormalizer drops a block that ends up saying nothing.
	private PeriodSelectConfig Block() => Global.PeriodSelect ??= new PeriodSelectConfig();

	private Task Set(Action mutate)
	{
		mutate();
		return Changed.InvokeAsync();
	}

	/// <summary>How two option strings are compared everywhere on this panel.</summary>
	// Trimmed and case-insensitive, matching PeriodSelectConfig.PeriodFor. An editor stricter than the engine
	// would draw an "unmapped" row for a mapping the engine is reading happily.
	private static bool Eq(string? left, string? right) =>
		string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);
}
