@*
	The picker and the direction switch shared by both Home Assistant dropdowns the engine binds to: the period
	select and the house mode.

	What is shared is the order the two controls come in, the unknown-entity notice, and reading an empty
	live-option list as a Home Assistant that has not answered. Everything below the switch is the consumer's,
	because the direction decides what it means.
*@

<div class="field">
	<div class="field-head">
		<label class="field-label">@Label
			@if (LabelHelp is not null)
			{
				<InfoPopover Label="@Label">@LabelHelp</InfoPopover>
			}
		</label>
	</div>
	<div class="field-control">
		<EntityPicker Value="@Entity"
					  ValueChanged="@EntityChanged"
					  Options="@Entities"
					  NameResolver="@NameResolver"
					  KnownResolver="@KnownResolver"
					  NoneLabel="@NoneLabel"
					  EmptyNote="@EmptyNote"
					  Placeholder="@Placeholder" />
	</div>
	@if (Note is not null)
	{
		<div class="field-help">@Note</div>
	}
</div>

@if (EntityId is not null)
{
	@* The authority decides what everything below means, so it comes before it. *@
	<div class="field">
		<div class="field-head">
			<span class="field-label">@AuthorityLabel
				@if (AuthorityHelp is not null)
				{
					<InfoPopover Label="@AuthorityLabel">@AuthorityHelp</InfoPopover>
				}
			</span>
		</div>
		@* periodselect-* named before this was shared. Renaming either class breaks the house mode too. *@
		<div class="field-control periodselect-authority">
			<label class="periodselect-choice">
				<input type="radio" name="@Group" checked="@HomeAssistant"
					   @onchange="@(() => SetAuthority(true))" />
				Home Assistant
			</label>
			<label class="periodselect-choice">
				<input type="radio" name="@Group" checked="@(!HomeAssistant)"
					   @onchange="@(() => SetAuthority(false))" />
				Adaptive lighting
			</label>
		</div>
		<div class="field-help">@AuthorityNote</div>
	</div>

	@if (ShowsUnavailable)
	{
		<div class="notice bad periodselect-warning">
			<strong>Home Assistant doesn't know <code>@EntityId</code>.</strong>
			<span>@UnavailableNote</span>
		</div>
	}

	@Body?.Invoke(new State(_liveValues, IsReady, ShowsUnavailable))
}

@code {
	/// <summary>What the shared markup has settled before the consumer's own body renders.</summary>
	/// <param name="LiveValues">
	///     The helper's options, trimmed and named once each. Empty is a Home Assistant that has not answered
	///     whenever <paramref name="IsReady"/> is false, never a helper with no options.
	/// </param>
	/// <param name="ShowsUnavailable">
	///     Whether the unknown-entity notice is already on screen, so a body does not stack a second fault
	///     under the one that causes it.
	/// </param>
	public sealed record State(IReadOnlyList<string> LiveValues, bool IsReady, bool ShowsUnavailable);

	[Parameter, EditorRequired]
	public string Label { get; set; } = "";

	/// <summary>The picker label's popover body. <c>null</c> leaves the label bare.</summary>
	[Parameter]
	public RenderFragment? LabelHelp { get; set; }

	/// <summary>The help line under the picker, saying what having no helper at all means.</summary>
	[Parameter]
	public RenderFragment? Note { get; set; }

	/// <summary>The configured entity as stored, untrimmed, so a hand-edited value shows as it is on disk.</summary>
	[Parameter]
	public string? Entity { get; set; }

	/// <summary>Raised with the chosen entity id, or <c>null</c> for none.</summary>
	// The one field this component does not write itself: changing it changes which helper's live options the
	// body is drawn from, and only the page can re-read those.
	[Parameter]
	public EventCallback<string?> EntityChanged { get; set; }

	/// <summary>The <c>input_select</c> entities the picker offers.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> Entities { get; set; } = [];

	[Parameter]
	public string NoneLabel { get; set; } = "(none)";

	[Parameter]
	public string Placeholder { get; set; } = "input_select.helper";

	[Parameter]
	public string EmptyNote { get; set; } = "Nothing to pick from yet — type an id instead.";

	[Parameter]
	public Func<string, string>? NameResolver { get; set; }

	[Parameter]
	public Func<string, bool>? KnownResolver { get; set; }

	/// <summary>The radio group's name. Two panels on one page sharing it would make one pair of radios.</summary>
	[Parameter, EditorRequired]
	public string Group { get; set; } = "";

	[Parameter]
	public string AuthorityLabel { get; set; } = "Set by:";

	[Parameter]
	public RenderFragment? AuthorityHelp { get; set; }

	/// <summary>Whether Home Assistant currently owns this dropdown.</summary>
	[Parameter]
	public bool HomeAssistant { get; set; }

	/// <summary>Raised with the chosen direction. The consumer owns the enum; this component only knows which side.</summary>
	[Parameter]
	public EventCallback<bool> HomeAssistantChanged { get; set; }

	/// <summary>The help line under the radios, worded for the direction in force.</summary>
	[Parameter]
	public string AuthorityNote { get; set; } = "";

	/// <summary>What an entity Home Assistant does not know costs, which differs by direction.</summary>
	[Parameter]
	public string UnavailableNote { get; set; } = "";

	/// <summary>Whether Home Assistant knows the configured entity at all.</summary>
	[Parameter]
	public bool IsAvailable { get; set; }

	/// <summary>Whether Home Assistant is answering, so an empty option list can say which of the two it is.</summary>
	[Parameter]
	public bool IsReady { get; set; } = true;

	/// <summary>
	///     The helper's live options. Empty means Home Assistant has not answered; see <see cref="IsReady"/>.
	/// </summary>
	[Parameter]
	public IReadOnlyList<string> LiveOptions { get; set; } = [];

	/// <summary>Everything below the switch, rendered only once an entity is picked.</summary>
	[Parameter]
	public RenderFragment<State>? Body { get; set; }

	// Cached per parameter set, and safe only because it is a pure function of the LiveOptions parameter.
	private List<string> _liveValues = [];

	/// <summary>The entity as anything reading Home Assistant asks for it, matching the config accessors.</summary>
	private string? EntityId => Entity is { Length: > 0 } entity && entity.Trim() is { Length: > 0 } trimmed
		? trimmed
		: null;

	// An entity nobody has answered about is not yet a fault: IsReady false means the connection, not the id.
	private bool ShowsUnavailable => !IsAvailable && IsReady;

	/// <inheritdoc/>
	protected override void OnParametersSet() => _liveValues = HouseModeSync.Clean(LiveOptions);

	private Task SetAuthority(bool homeAssistant)
	{
		HomeAssistant = homeAssistant;
		return HomeAssistantChanged.InvokeAsync(homeAssistant);
	}
}
