@*
	A room's behaviour as prose, with the values inline and editable.

	It renders sentences and does not build them: the projection from document to prose is a pure function
	(AreaSentences, SentenceBuilder) so it can be tested, and this repo has no Razor render harness. It does
	not save either; every edit leaves through a callback.
*@

<div class="sentences">
	@foreach (Sentence sentence in Sentences)
	{
		<p class="sentence">
			@foreach (SentencePart part in sentence.Parts)
			{
				@switch (part)
				{
					case SentenceText text:
						@text.Text
						break;

					case SentenceToken token:
						<SentenceTokenView Token="@token"
										   Editable="@Editable"
										   Note="@Note"
										   Edited="@Edited"
										   Reverted="@Reverted" />
						break;

					case SentenceFigure figure:
						<span class="sentence-figure" role="img" aria-label="@figure.AltText">@figure.Content</span>
						break;
				}
			}
		</p>
	}
</div>

@if (ShowLegend && Editable && HasOwnValues)
{
	<p class="sentence-legend">
		<span class="tok-own-dot" aria-hidden="true"></span>
		<span>@LegendText</span>
	</p>
}

@code {
	/// <summary>The sentences to draw, in reading order.</summary>
	[Parameter, EditorRequired]
	public IReadOnlyList<Sentence> Sentences { get; set; } = [];

	/// <summary>Whether the values are controls or just words. Off renders the same sentences in bold.</summary>
	[Parameter]
	public bool Editable { get; set; } = true;

	/// <summary>
	///     Raised when a value is picked. The key is the setting's property name, so a handler reads
	///     <c>case nameof(AreaSettings.VacancyTimeoutSeconds)</c> and cannot drift from the schema silently.
	/// </summary>
	[Parameter]
	public EventCallback<SentenceEdit> Edited { get; set; }

	/// <summary>Raised when the reader asks a value to follow the house again, carrying the setting's key.</summary>
	// The handler must clear the room's property, not copy the house's current number into it, so the room
	// keeps following the house the next time the house changes.
	[Parameter]
	public EventCallback<string> Reverted { get; set; }

	/// <summary>
	///     One line in each popover about when a pick takes effect. Left to the page: a room editor behind the
	///     save bar and a surface that applies at once need different sentences.
	/// </summary>
	[Parameter]
	public string? Note { get; set; }

	/// <summary>Whether to explain the amber dot underneath. On by default, and shown only when a dot exists.</summary>
	[Parameter]
	public bool ShowLegend { get; set; } = true;

	/// <summary>What the legend says. Worded for a room by default.</summary>
	[Parameter]
	public string LegendText { get; set; } = "= this room's own setting, not the house's";

	private bool HasOwnValues => Sentences.Sum(sentence => sentence.OwnValueCount) > 0;
}
