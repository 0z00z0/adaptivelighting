@inject IJSRuntime Js
@inject ILogger<ThemePicker> Logger

@*
	Which palette this browser paints in.

	It lives on the top bar rather than in the House tab because it is not house configuration: it is stored in
	this browser, it takes effect on the tap, and nothing about it reaches the YAML. Every other control on the
	House tab is a document edit sitting behind a save bar, and a control that applies at once among controls
	that apply on save is the worst kind of ambiguity to introduce — "a promise about saving is the worst kind
	of thing to be wrong about". The bar also puts it on every page, including the board, which is the page
	somebody would be looking at while deciding whether they like a theme.

	The list, and what an unrecognised stored id falls back to, are AppThemes' job — this component renders the
	list and hands the chosen id to the browser.
*@
<label class="theme-picker">
	<span class="theme-picker-label">Theme</span>
	<select class="theme-select" @bind:get="_selected" @bind:set="OnPicked">
		@foreach (AppTheme theme in AppThemes.All)
		{
			<option value="@theme.Id">@theme.Name</option>
		}
	</select>
</label>

@code {
	// The default, and what the server necessarily renders: the first paint happens before any circuit exists,
	// so the server cannot know what this browser stored. theme.js has already painted the page correctly by
	// then; the only thing still to correct is which option this select shows as chosen, which is why the
	// round trip below is worth its one interop call and a cookie is not worth the request weight.
	private string _selected = AppThemes.System.Id;

	/// <summary>
	///     Whether an interop failure is one to survive rather than one to crash on.
	/// </summary>
	/// <remarks>
	///     <para>
	///         All three are ordinary in a long-lived Blazor Server process, and none of them is worth a page for.
	///         <see cref="JSDisconnectedException"/> is the circuit going away between the render and the reply — a
	///         closed tab, a dropped link. <see cref="OperationCanceledException"/> is the interop call timing out
	///         (a minute, by default) because the browser never answered. <see cref="JSException"/> is the script
	///         itself missing: <c>theme.js</c> is a separate file, and a request that 404s or is blocked leaves
	///         <c>window.adaptiveLightingTheme</c> undefined.
	///     </para>
	///     <para>
	///         <b>Why this matters more than it looks.</b> An exception out of <c>OnAfterRenderAsync</c> or an event
	///         handler is an unhandled circuit exception, and Blazor tears the circuit down for it — the reader gets
	///         the reload page instead of the app. This component sits in the layout, so that would be every page.
	///         <c>theme.js</c> already refuses to take the page down over storage it cannot read; the C# half must
	///         hold to the same bargain, or the script's care is undone from the other side. The cost of degrading
	///         is one select showing the default while the page itself is painted correctly by the head script.
	///     </para>
	/// </remarks>
	private static bool IsSurvivable(Exception exception) =>
		exception is JSDisconnectedException or JSException or OperationCanceledException;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		string? stored;

		try
		{
			stored = await Js.InvokeAsync<string?>("adaptiveLightingTheme.stored");
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			Logger.LogDebug(exception, "Could not read the stored theme; the picker keeps its default selection.");
			return;
		}

		AppTheme theme = AppThemes.Resolve(stored);

		if (theme.Id == _selected)
		{
			return;
		}

		_selected = theme.Id;
		StateHasChanged();
	}

	// Resolved rather than trusted, so the id written to storage is always one this build ships — the same
	// rule the head script applies, from the same list.
	private async Task OnPicked(string picked)
	{
		AppTheme theme = AppThemes.Resolve(picked);
		_selected = theme.Id;

		try
		{
			await Js.InvokeVoidAsync("adaptiveLightingTheme.apply", theme.Id);
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			// The pick is lost, not the page. Saying so is the honest thing, but there is no surface here to say
			// it on that would not cost the top bar a row on every page for a failure nobody will ever see.
			Logger.LogWarning(exception, "Could not apply the theme '{Theme}' in the browser.", theme.Id);
		}
	}
}
