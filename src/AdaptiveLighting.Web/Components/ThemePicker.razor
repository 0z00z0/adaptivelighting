@inject IJSRuntime Js
@inject ILogger<ThemePicker> Logger

@*
	Which palette this browser paints in. Stored in the browser, applied on the tap, never in the YAML, which
	is why it sits on the top bar and not among the House tab's save-bar controls.

	The list and the fallback for an unrecognised id are AppThemes' job.
*@
<label class="theme-picker">
	<span class="theme-picker-label">Theme</span>
	<select class="theme-select" @bind:get="_selected" @bind:set="OnPicked">
		@foreach (AppTheme theme in AppThemes.All)
		{
			<option value="@theme.Id">@theme.Name</option>
		}
	</select>
</label>

@code {
	// The first paint happens before any circuit exists, so the server cannot know what this browser stored.
	// theme.js has already painted the page by then; only the select's chosen option needs correcting.
	private string _selected = AppThemes.System.Id;

	/// <summary>Whether an interop failure is one to survive and not crash on.</summary>
	// An exception out of OnAfterRenderAsync or an event handler is an unhandled circuit exception, and this
	// component sits in the layout, so it would take every page down. All three are ordinary: a closed tab, a
	// browser that never answered, or theme.js missing.
	private static bool IsSurvivable(Exception exception) =>
		exception is JSDisconnectedException or JSException or OperationCanceledException;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		string? stored;

		try
		{
			stored = await Js.InvokeAsync<string?>("adaptiveLightingTheme.stored");
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			Logger.LogDebug(exception, "Could not read the stored theme; the picker keeps its default selection.");
			return;
		}

		AppTheme theme = AppThemes.Resolve(stored);

		if (theme.Id == _selected)
		{
			return;
		}

		_selected = theme.Id;
		StateHasChanged();
	}

	// Resolved, not trusted, so the id written to storage is one this build ships. The head script
	// applies the same rule from the same list.
	private async Task OnPicked(string picked)
	{
		AppTheme theme = AppThemes.Resolve(picked);
		_selected = theme.Id;

		try
		{
			await Js.InvokeVoidAsync("adaptiveLightingTheme.apply", theme.Id);
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			// The pick is lost, not the page. There is no surface in the top bar to report it on.
			Logger.LogWarning(exception, "Could not apply the theme '{Theme}' in the browser.", theme.Id);
		}
	}
}
