@*
	Setting rooms up again: pick the rooms, read what it costs, then rebuild. There is no merge, so every line
	in the warning is computed from the plan the engine will carry out.

	Nothing here writes. Confirming mutates the in-memory document and arms the ordinary save bar.
*@

<div class="panel setup-panel">
	@if (_plan is null || _step == Step.Pick)
	{
		<h3 class="setup-title">Set up rooms again</h3>
		<p class="lede">
			Each room you tick is rebuilt from what Home Assistant knows right now, as if it were newly found.
			Nothing changes until you confirm on the next step.
		</p>

		@if (Rebuildable.Count == 0)
		{
			<p class="hint">No room here names a Home Assistant area, so there is nothing to rebuild.</p>
		}
		else
		{
			@* A label around the box, never a control inside one. Same shape and wording as the first-run board's. *@
			<label class="setup-all">
				<input type="checkbox" @bind:get="IncludesEveryRoom" @bind:set="SetIncludeAll" />
				Include all
			</label>

			<ul class="setup-rooms">
				@foreach (AreaConfig area in Rebuildable)
				{
					string areaId = area.AreaId!;
					<li>
						<label>
							<input type="checkbox"
								   checked="@_ticked.Contains(areaId)"
								   @onchange="args => Tick(areaId, args.Value is true)" />
							<span class="setup-room-name">@AreaNaming.DisplayName(area, NameOf)</span>
							<code class="area-slug">@areaId</code>
						</label>
					</li>
				}
			</ul>
		}

		@if (Skipped > 0)
		{
			<p class="hint">
				@Skipped @(Skipped == 1 ? "room has" : "rooms have") no Home Assistant area and can't be rebuilt, so
				@(Skipped == 1 ? "it isn't" : "they aren't") listed.
			</p>
		}

		@if (NewRoomsNote is { Length: > 0 } newRooms)
		{
			<p class="hint">@newRooms</p>
		}

		<div class="panel-actions">
			<button type="button" class="primary" @onclick="Preview" disabled="@Nothing">Continue</button>
			<button type="button" @onclick="Cancel">Cancel</button>
		</div>
	}
	else
	{
		<h3 class="setup-title">@SetupWarning.Title(_plan)</h3>

		@if (_lines.Count > 0)
		{
			<p>
				Each room is rebuilt from what Home Assistant knows right now, as if it were newly found. Its
				automatically-guessed behaviour is re-guessed; everything you changed by hand is lost:
			</p>
			<ul class="setup-losses">
				@foreach (SetupWarningLine line in _lines)
				{
					<li>
						<strong>@line.Name</strong> — @line.Consequence
						@if (line.Note is { Length: > 0 } note)
						{
							<span class="hint">@note</span>
						}
					</li>
				}
			</ul>
		}

		@if (NewRoomsNote is { Length: > 0 } added)
		{
			<p>@added</p>
		}

		@* What confirming commits to is the host page's business: the settings page arms its save bar, the room
		   page applies and saves by itself. Hence CommitNote, in place of a default sentence here. *@
		<p class="hint">
			Rooms stay switched on or off as they are now. Rooms you didn't tick are untouched.
			@if (CommitNote is { Length: > 0 } commitNote)
			{
				@commitNote
			}
			else
			{
				<text>
					Nothing is written until you press <em>Save and apply</em> &mdash; <em>Discard changes</em> undoes this.
				</text>
			}
		</p>

		<div class="panel-actions">
			<button type="button" class="primary" @onclick="Confirm">Set up again</button>
			<button type="button" @onclick="Cancel">Cancel</button>
		</div>
	}
</div>

@code {
	private enum Step
	{
		Pick,
		Confirm
	}

	/// <summary>The document being edited. Read for the room list and the names the warning quotes; never written.</summary>
	[Parameter, EditorRequired]
	public AdaptiveLightingConfig Config { get; set; } = new();

	/// <summary>The area ids ticked when the panel opens.</summary>
	[Parameter]
	public IReadOnlyCollection<string> PreTicked { get; set; } = [];

	/// <summary>Works out what a scope would do. Supplied by the page, which owns the registry connection.</summary>
	[Parameter, EditorRequired]
	public Func<IReadOnlyCollection<string>, SetupPlan> PlanFor { get; set; } = _ => new SetupPlan([], [], []);

	/// <summary>Resolves an area id to the name Home Assistant shows. Supplied by the page.</summary>
	[Parameter]
	public Func<string, string>? NameOf { get; set; }

	/// <summary>Raised with the confirmed plan. The page applies it and arms the save bar.</summary>
	[Parameter]
	public EventCallback<SetupPlan> Confirmed { get; set; }

	/// <summary>Raised when the operator backs out. Nothing has changed at that point.</summary>
	[Parameter]
	public EventCallback Cancelled { get; set; }

	/// <summary>
	///     What the host page does with the rebuild once it is confirmed. Left unset, the warning keeps the save
	///     bar's wording. Only the page knows whether confirming arms a save bar or writes at once.
	/// </summary>
	[Parameter]
	public string? CommitNote { get; set; }

	private readonly HashSet<string> _ticked = new(StringComparer.Ordinal);

	private SetupPlan? _plan;
	private IReadOnlyList<SetupWarningLine> _lines = [];
	private Step _step = Step.Pick;

	/// <summary>The rooms a rebuild can act on. One that names no area has nothing to be rebuilt from.</summary>
	private IReadOnlyList<AreaConfig> Rebuildable =>
		[.. Config.Areas.Where(area => area.AreaId is { Length: > 0 })];

	private int Skipped => Config.Areas.Count - Rebuildable.Count;

	/// <summary>Whether confirming would do nothing: no room ticked, and no new room to add.</summary>
	private bool Nothing => _ticked.Count == 0 && (_plan?.NewAreas.Count ?? 0) == 0;

	private string? NewRoomsNote => _plan is null ? null : SetupWarning.NewRooms(_plan, NameOf);

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		foreach (string areaId in PreTicked)
			_ticked.Add(areaId);

		// The rooms this run would add are the same whatever is ticked, so the pick step can name them already.
		_plan = PlanFor(_ticked);
	}

	private void Tick(string areaId, bool on)
	{
		if (on)
			_ticked.Add(areaId);
		else
			_ticked.Remove(areaId);
	}

	/// <summary>Whether every rebuildable room is ticked. An empty list is not "all": nothing has been included.</summary>
	private bool IncludesEveryRoom =>
		Rebuildable.Count > 0 && Rebuildable.All(area => _ticked.Contains(area.AreaId!));

	private void SetIncludeAll(bool include)
	{
		_ticked.Clear();

		if (!include)
			return;

		foreach (AreaConfig area in Rebuildable)
			_ticked.Add(area.AreaId!);
	}

	private void Preview()
	{
		// Re-planned against what is ticked: the plan the warning counts must be the plan Confirm applies.
		_plan = PlanFor(_ticked);
		_lines = SetupWarning.Lines(_plan, Config);
		_step = Step.Confirm;
	}

	private Task Confirm() => _plan is { } plan ? Confirmed.InvokeAsync(plan) : Task.CompletedTask;

	private Task Cancel() => Cancelled.InvokeAsync();
}
