@*
	One entity, chosen by the name Home Assistant shows, stored as the id the engine needs.

	The select is the primary path and the text box is the fallback, never the other way round. A household
	has no reason to know that "Stuelampe" is light.stuelampe_2, and every time we ask them to type it we
	are asking them to make a mistake the engine can only report hours later, in the dark.

	The text box still exists, for two honest reasons: Home Assistant may not be connected yet (Kestrel
	serves before NetDaemon finishes connecting), and an entity may legitimately be named here before it
	exists in HA. When HA is unreachable the picker has nothing to offer and says so rather than rendering
	an empty dropdown that looks like "you have no lights".
*@

<div class="picker">
	@if (_manual || !HasOptions)
	{
		<input type="text"
			   class="picker-text"
			   placeholder="@Placeholder"
			   value="@Value"
			   @onchange="OnTyped" />
	}
	else
	{
		<select class="picker-select" @bind:get="Value ?? string.Empty" @bind:set="OnPicked">
			<option value="">@NoneLabel</option>
			@foreach (EntityOption option in Options)
			{
				<option value="@option.EntityId">@option.Label</option>
			}
			@if (IsUnlisted)
			{
				@* Never silently drop a configured value just because HA does not know it — that is exactly
				   the REPLACE_ME case, and the operator needs to see it sitting there to replace it. *@
				<option value="@Value">@UnlistedLabel</option>
			}
		</select>
	}

	<button type="button" class="picker-mode" @onclick="ToggleMode" disabled="@(!HasOptions)">
		@(_manual ? "Pick from list" : "Type an id")
	</button>

	@if (!HasOptions)
	{
		<span class="picker-note">@EmptyNote</span>
	}
	else if (IsUnknown)
	{
		<span class="picker-note bad">Home Assistant doesn't know this id — check for typos.</span>
	}
</div>

@code {
	/// <summary>The currently configured entity id, or <c>null</c>/empty for none.</summary>
	[Parameter]
	public string? Value { get; set; }

	/// <summary>Raised with the new entity id, or <c>null</c> when the operator chose none.</summary>
	[Parameter]
	public EventCallback<string?> ValueChanged { get; set; }

	/// <summary>The entities to offer, already filtered to the domains this field accepts.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> Options { get; set; } = [];

	/// <summary>What the empty choice is called, phrased for what "none" means to this particular field.</summary>
	[Parameter]
	public string NoneLabel { get; set; } = "(none)";

	/// <summary>Example id shown in the free-text fallback.</summary>
	[Parameter]
	public string Placeholder { get; set; } = "domain.entity_id";

	/// <summary>
	///     Why there is nothing to pick, in words the caller is in a position to be right about.
	/// </summary>
	/// <remarks>
	///     An empty list is not self-explanatory and this component cannot tell the reasons apart. Home Assistant
	///     may be down; or it may be perfectly healthy and the caller may have filtered the list to an area that
	///     genuinely holds no such entity, which is the ordinary case for a lux sensor. Blaming the connection for
	///     the second is a lie that sends somebody to debug a connection that is fine, so the caller says.
	/// </remarks>
	[Parameter]
	public string EmptyNote { get; set; } = "Nothing to pick from yet — type an id instead.";

	/// <summary>Resolves an id to the name Home Assistant shows, for a configured value not in the offered list. Optional.</summary>
	[Parameter]
	public Func<string, string>? NameResolver { get; set; }

	/// <summary>Whether Home Assistant knows an id, so an out-of-list value reads as "filtered out" rather than "unknown". Optional.</summary>
	[Parameter]
	public Func<string, bool>? KnownResolver { get; set; }

	private bool _manual;

	private bool HasOptions => Options.Count > 0;

	private bool IsUnlisted =>
		Value is { Length: > 0 } && !Options.Any(option => string.Equals(option.EntityId, Value, StringComparison.Ordinal));

	/// <summary>Whether an out-of-list value is genuinely unknown to Home Assistant, not merely filtered out of this field's domain.</summary>
	private bool IsUnknown => IsUnlisted && !(KnownResolver?.Invoke(Value!) ?? false);

	/// <summary>Label for the out-of-list value: its friendly name if resolvable, flagged when Home Assistant does not know it.</summary>
	private string UnlistedLabel
	{
		get
		{
			string name = NameResolver?.Invoke(Value!) ?? Value!;
			return IsUnknown ? $"{name} — not known to Home Assistant" : name;
		}
	}

	private Task OnPicked(string picked) => Commit(picked);

	private Task OnTyped(ChangeEventArgs args) => Commit(args.Value as string);

	private void ToggleMode() => _manual = !_manual;

	private Task Commit(string? raw)
	{
		// Normalise "" to null at the edge. The config schema uses null for "not set", and a stray empty
		// string would be validated as an entity id that Home Assistant does not know.
		string? value = string.IsNullOrWhiteSpace(raw) ? null : raw.Trim();
		Value = value;
		return ValueChanged.InvokeAsync(value);
	}
}
