@*
	One zone.

	The shape of this component is an argument about what a zone is. A zone is, in the common case, an area
	and nothing else — discovery finds the lights, the motion sensors and the lux sensor from the registry,
	and it keeps finding them after somebody renames a bulb. So the area picker is at the top, the discovery
	preview sits directly under it showing what that choice actually resolves to right now, and everything
	that overrides discovery is folded away behind "the area is wrong" — because reaching for it is a
	statement that Home Assistant's own area assignments are not to be trusted for this room, and that
	should feel like a decision rather than the default path.

	The preview is the real ZoneEntityResolver, not a lookalike. What it says is what the engine will do.

	The whole zone is a fold. Collapsed, it is a header — name, area, and how far it strays from the
	defaults — because a settings page with six zones is read far more often than it is edited, and the
	reading case wants six lines, not six panels. A zone with no area yet starts open: it is not configured,
	and a fold that hides the one thing demanding attention would be tidiness at the expense of the task.
*@

<details class="panel zone-fold" open="@_openInitially">
	@*
		The zone's header is a header — a name to read, not a text box to squint at. The name is edited in
		the Name field inside; the summary just says who this is and how far it strays from the defaults,
		which is what you want a collapsed list of six zones to answer at a glance.
	*@
	<summary class="zone-summary">
		<span class="zone-title">@DisplayName</span>
		@if (Zone.Enabled == false)
		{
			<span class="badge bad">disabled</span>
		}
		@if (Zone.AreaId is { Length: > 0 } areaId)
		{
			<code class="zone-area">@areaId</code>
		}
		else
		{
			<span class="badge bad">no area</span>
		}
		<span class="zone-summary-hint">@SummaryHint</span>
		<span class="zone-chevron" aria-hidden="true"></span>
	</summary>

	<div class="field">
		<div class="field-head"><label class="field-label">Name</label></div>
		<div class="field-control">
			<input type="text" class="cell wide" @bind="Zone.Name" @bind:event="oninput" placeholder="@(Zone.AreaId ?? "Zone name")" />
		</div>
		<div class="field-help">The room's name on the dashboard. Follows the area's name until you type one.</div>
	</div>

	<div class="field">
		<div class="field-head"><label class="field-label">Area</label></div>
		<div class="field-control">
			<AreaPicker Value="@Zone.AreaId" ValueChanged="@OnAreaChanged" Areas="@Areas" />
		</div>
		<div class="field-help">
			Pick the room. That's normally all a zone needs — lights and sensors are found automatically.
		</div>
	</div>

	@* ------------------------------------------------------------------------------------------------
	   The discovery preview. This is the thing that makes the area picker trustworthy: choose an area and
	   see the actual lights, sensors and lux source the engine will drive, before saving anything.
	   ------------------------------------------------------------------------------------------------ *@
	<div class="preview @(Preview.Resolved is null ? "preview-bad" : "preview-ok")">
		<div class="preview-head">What was found in this room</div>

		@if (Preview.Resolved is { } resolved)
		{
			<table>
				<tbody>
					<tr>
						<th>Lights</th>
						<td>
							<ul class="chips chips-plain">
								@foreach (string light in resolved.Lights)
								{
									<li class="chip"><span class="chip-name">@Name(light)</span><code class="chip-id">@light</code></li>
								}
							</ul>
						</td>
					</tr>
					<tr>
						<th>Motion</th>
						<td>
							<ul class="chips chips-plain">
								@foreach (string sensor in resolved.MotionSensors)
								{
									<li class="chip"><span class="chip-name">@Name(sensor)</span><code class="chip-id">@sensor</code></li>
								}
							</ul>
						</td>
					</tr>
					<tr>
						<th>Lux</th>
						<td>
							@if (resolved.LuxSensor is { Length: > 0 } lux)
							{
								<span class="chip-name">@Name(lux)</span> <code class="chip-id">@lux</code>
							}
							else
							{
								<span class="inherit">none — darkness is judged by the sun instead</span>
							}
						</td>
					</tr>
				</tbody>
			</table>
		}
		else
		{
			<div class="preview-error">@Preview.Error</div>
		}
	</div>

	<details class="advanced" open="@HasExplicitEntities">
		<summary>Pick lights and sensors by hand</summary>

		<p class="lede">
			Each list you fill in here <strong>replaces</strong> the automatic choice for that list only. Use it when
			Home Assistant's room assignments don't match reality — a hallway sensor that watches the living room, a
			lamp assigned to the wrong room. Fixing the room in Home Assistant is usually better.
		</p>

		@* ------------------------------------------------------------------------------------------------
		   The lists below offer this area's entities, because a living-room light picker that offered every
		   light in the house was offering an ESP dev board's status LED and a browser_mod screen as candidate
		   living-room lights, and burying the three real answers somewhere in the middle.

		   But it is a default, not a wall. This whole block exists for the case where HA's area assignment is
		   the thing that is wrong — a sensor in the hallway that watches this room is not in this area and
		   never will be — so widening the lists has to stay one click away. Anything already configured stays
		   listed and selected either way: a filter must never be the reason a stored value disappears.
		   ------------------------------------------------------------------------------------------------ *@
		@if (Zone.AreaId is { Length: > 0 })
		{
			<div class="field">
				<div class="field-control checks">
					<label>
						<input type="checkbox" @bind:get="_showAllEntities" @bind:set="OnShowAllChanged" />
						show entities from other rooms too
					</label>
				</div>
				<div class="field-help">
					@if (_showAllEntities)
					{
						<text>Showing everything in the house.</text>
					}
					else
					{
						<text>
							Showing what's in this room. Anything already chosen stays listed even if it's elsewhere.
						</text>
					}
				</div>
			</div>
		}

		<div class="field">
			<div class="field-head"><label class="field-label">Lights</label></div>
			<div class="field-control">
				<EntityListPicker Value="@(Zone.Lights ?? [])"
								  ValueChanged="@(value => SetList(value, list => Zone.Lights = list))"
								  Options="@_lightOptions"
								  NameResolver="@Name"
								  KnownResolver="@Catalog.Knows"
								  EmptyLabel="Discovered from the area."
								  AddLabel="Add a light…"
								  EmptyNote="@EmptyNote("lights")"
								  Placeholder="light.example" />
			</div>
		</div>

		<div class="field">
			<div class="field-head"><label class="field-label">Motion sensors</label></div>
			<div class="field-control">
				<EntityListPicker Value="@(Zone.MotionSensors ?? [])"
								  ValueChanged="@(value => SetList(value, list => Zone.MotionSensors = list))"
								  Options="@_motionOptions"
								  NameResolver="@Name"
								  KnownResolver="@Catalog.Knows"
								  EmptyLabel="Discovered from the area."
								  AddLabel="Add a motion sensor…"
								  EmptyNote="@EmptyNote("motion sensors")"
								  Placeholder="binary_sensor.example" />
			</div>
			<div class="field-help">
				Sensors that report motion, occupancy or presence. A sensor with an odd type can be given the motion
				label in Home Assistant instead.
			</div>
		</div>

		<div class="field">
			<div class="field-head"><label class="field-label">Lux sensor</label></div>
			<div class="field-control">
				<EntityPicker Value="@Zone.LuxSensor"
							  ValueChanged="@(value => Set(() => Zone.LuxSensor = value))"
							  Options="@_luxOptions"
							  NoneLabel="(discovered from the area)"
							  EmptyNote="@EmptyNote("illuminance sensors")"
							  Placeholder="sensor.example_illuminance" />
			</div>
			<div class="field-help">
				Only needed when the room has more than one light-level sensor.
			</div>
		</div>

		<div class="field">
			<div class="field-head"><label class="field-label">Blocked while on</label></div>
			<div class="field-control">
				<EntityListPicker Value="@(Zone.IgnoreWhenOn ?? [])"
								  ValueChanged="@(value => SetList(value, list => Zone.IgnoreWhenOn = list))"
								  Options="@Blockers"
								  NameResolver="@Name"
								  KnownResolver="@Catalog.Knows"
								  EmptyLabel="Nothing blocks this zone."
								  AddLabel="Add a blocker…"
								  Placeholder="binary_sensor.projector_is_on" />
			</div>
			<div class="field-help">
				While any of these is on, the lights won't turn on by themselves. A projector, a "do not disturb" switch.
			</div>
		</div>
	</details>

	<details class="advanced" open="@HasOverrides">
		<summary>Room-specific settings (@OverrideCount of 17 changed)</summary>

		<OverrideField Label="Enabled"
					   IsOverridden="@(Zone.Enabled is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.Enabled = on ? Defaults.Enabled : null))"
					   InheritedText="@YesNo(Defaults.Enabled)"
					   Help="A disabled zone is still observed and published, just never commanded.">
			<select class="cell" @bind:get="_enabled" @bind:set="OnEnabledChanged">
				<option value="true">yes — lights are managed</option>
				<option value="false">no — watch only</option>
			</select>
		</OverrideField>

		<OverrideField Label="Vacancy timeout"
					   IsOverridden="@(Zone.VacancyTimeoutSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.VacancyTimeoutSeconds = on ? Defaults.VacancyTimeoutSeconds : null))"
					   InheritedText="@($"{Defaults.VacancyTimeoutSeconds} s")"
					   Help="Motion-free time before the zone dims to its pre-off warning.">
			<input class="cell num" type="number" min="1" @bind="ZoneVacancyTimeout" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Pre-off warning"
					   IsOverridden="@(Zone.PreOffSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.PreOffSeconds = on ? Defaults.PreOffSeconds : null))"
					   InheritedText="@($"{Defaults.PreOffSeconds} s")"
					   Help="The grace in which motion still cancels darkness. Must be shorter than the vacancy timeout.">
			<input class="cell num" type="number" min="0" @bind="ZonePreOff" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Pre-off brightness"
					   IsOverridden="@(Zone.PreOffBrightnessFactor is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.PreOffBrightnessFactor = on ? Defaults.PreOffBrightnessFactor : null))"
					   InheritedText="@($"{Defaults.PreOffBrightnessFactor:0.##} of target")"
					   Help="Fraction of the circadian brightness used for the warning dim. Between 0 and 1.">
			<input class="cell num" type="number" step="0.05" min="0" max="1" @bind="ZonePreOffFactor" />
		</OverrideField>

		<OverrideField Label="Override holds for"
					   IsOverridden="@(Zone.OverrideDurationMinutes is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.OverrideDurationMinutes = on ? Defaults.OverrideDurationMinutes : null))"
					   InheritedText="@($"{Defaults.OverrideDurationMinutes} min")"
					   Help="How long a manual change holds the zone before automatic control resumes.">
			<input class="cell num" type="number" min="0" @bind="ZoneOverrideDuration" /> <span class="unit">min</span>
		</OverrideField>

		<OverrideField Label="Vacancy reset"
					   IsOverridden="@(Zone.VacancyResetMinutes is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.VacancyResetMinutes = on ? Defaults.VacancyResetMinutes : null))"
					   InheritedText="@($"{Defaults.VacancyResetMinutes} min")"
					   Help="Motion-free time after a manual turn-off before the suppression is lifted.">
			<input class="cell num" type="number" min="0" @bind="ZoneVacancyReset" /> <span class="unit">min</span>
		</OverrideField>

		<OverrideField Label="Darkness source"
					   IsOverridden="@(Zone.Darkness is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.Darkness = on ? Defaults.Darkness : null))"
					   InheritedText="@Defaults.Darkness.ToString()"
					   Help="Which signal decides the zone is dark enough to light.">
			<select class="cell" @bind:get="_darkness" @bind:set="OnDarknessChanged">
				<option value="@nameof(DarknessSource.Lux)">Lux sensor (falls back to the sun if there is none)</option>
				<option value="@nameof(DarknessSource.Sun)">Sun height</option>
				<option value="@nameof(DarknessSource.Either)">Either — dark when either says so</option>
				<option value="@nameof(DarknessSource.Always)">Always — no daylight check (windowless rooms)</option>
			</select>
		</OverrideField>

		<OverrideField Label="Lux threshold"
					   IsOverridden="@(Zone.LuxThreshold is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.LuxThreshold = on ? Defaults.LuxThreshold : null))"
					   InheritedText="@($"{Defaults.LuxThreshold} lx")"
					   Help="Lux at or below which the zone counts as dark.">
			<input class="cell num" type="number" min="0" @bind="ZoneLuxThreshold" /> <span class="unit">lx</span>
		</OverrideField>

		<OverrideField Label="Lux hysteresis"
					   IsOverridden="@(Zone.LuxHysteresis is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.LuxHysteresis = on ? Defaults.LuxHysteresis : null))"
					   InheritedText="@($"{Defaults.LuxHysteresis} lx")"
					   Help="Extra lux required to leave the dark state, so a sensor sitting on the threshold cannot flap.">
			<input class="cell num" type="number" min="0" @bind="ZoneLuxHysteresis" /> <span class="unit">lx</span>
		</OverrideField>

		<OverrideField Label="Sun elevation"
					   IsOverridden="@(Zone.SunElevationThreshold is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.SunElevationThreshold = on ? Defaults.SunElevationThreshold : null))"
					   InheritedText="@($"{Defaults.SunElevationThreshold}°")"
					   Help="Sun elevation below which the zone counts as dark.">
			<input class="cell num" type="number" step="0.5" min="-90" max="90" @bind="ZoneSunElevation" /> <span class="unit">°</span>
		</OverrideField>

		<OverrideField Label="Sun entity"
					   IsOverridden="@(Zone.SunEntity is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.SunEntity = on ? Defaults.SunEntity : null))"
					   InheritedText="@Defaults.SunEntity">
			<EntityPicker Value="@Zone.SunEntity"
						  ValueChanged="@(value => Set(() => Zone.SunEntity = value))"
						  Options="@SunEntities"
						  NoneLabel="(none)"
						  Placeholder="sun.sun" />
		</OverrideField>

		<OverrideField Label="Day fade"
					   IsOverridden="@(Zone.DayTransitionSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.DayTransitionSeconds = on ? Defaults.DayTransitionSeconds : null))"
					   InheritedText="@($"{Defaults.DayTransitionSeconds} s")"
					   Help="Fade length used while the zone is not dark.">
			<input class="cell num" type="number" step="0.5" min="0" @bind="ZoneDayFade" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Night fade"
					   IsOverridden="@(Zone.NightTransitionSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.NightTransitionSeconds = on ? Defaults.NightTransitionSeconds : null))"
					   InheritedText="@($"{Defaults.NightTransitionSeconds} s")"
					   Help="Gentler, because eyes are dark-adapted.">
			<input class="cell num" type="number" step="0.5" min="0" @bind="ZoneNightFade" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Respects sleep mode"
					   IsOverridden="@(Zone.RespectSleepMode is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.RespectSleepMode = on ? Defaults.RespectSleepMode : null))"
					   InheritedText="@YesNo(Defaults.RespectSleepMode)"
					   Help="Clamps to the sleep period's caps while the house is asleep, whatever the clock says.">
			<select class="cell" @bind:get="_respectSleep" @bind:set="OnRespectSleepChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>

		<OverrideField Label="Sleep blocks auto-on"
					   IsOverridden="@(Zone.SleepBlocksAutoOn is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.SleepBlocksAutoOn = on ? Defaults.SleepBlocksAutoOn : null))"
					   InheritedText="@YesNo(Defaults.SleepBlocksAutoOn)"
					   Help="Refuses to auto-on at all while sleep mode is on.">
			<select class="cell" @bind:get="_sleepBlocks" @bind:set="OnSleepBlocksChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>

		<OverrideField Label="Skips the away sweep"
					   IsOverridden="@(Zone.SkipAwaySweep is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.SkipAwaySweep = on ? Defaults.SkipAwaySweep : null))"
					   InheritedText="@YesNo(Defaults.SkipAwaySweep)"
					   Help="Outdoor and security lights set this: they stay on when the house empties.">
			<select class="cell" @bind:get="_skipAway" @bind:set="OnSkipAwayChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>

		<OverrideField Label="Welcome home"
					   IsOverridden="@(Zone.WelcomeHome is not null)"
					   IsOverriddenChanged="@(on => Set(() => Zone.WelcomeHome = on ? Defaults.WelcomeHome : null))"
					   InheritedText="@YesNo(Defaults.WelcomeHome)"
					   Help="Lights up on first arrival when it is dark.">
			<select class="cell" @bind:get="_welcomeHome" @bind:set="OnWelcomeHomeChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>
	</details>

	@* At the bottom, deliberately: destroying a zone should take a scroll past everything it is, not sit
	   one stray tap from its own header. *@
	<div class="zone-actions">
		<button type="button" class="danger" @onclick="Remove">Remove this room</button>
	</div>
</details>

@code {
	/// <summary>The zone being edited, in place.</summary>
	[Parameter, EditorRequired]
	public ZoneConfig Zone { get; set; } = new();

	/// <summary>The document's defaults, for showing what each unset knob inherits.</summary>
	[Parameter, EditorRequired]
	public ZoneSettings Defaults { get; set; } = new();

	/// <summary>The document's globals, which supply the discovery conventions the preview uses.</summary>
	[Parameter, EditorRequired]
	public GlobalConfig Global { get; set; } = new();

	/// <summary>The registry, for the pickers and the preview.</summary>
	[Parameter, EditorRequired]
	public HaCatalog Catalog { get; set; } = default!;

	/// <summary>Every area, hoisted to the page so one registry read serves every zone.</summary>
	[Parameter]
	public IReadOnlyList<AreaOption> Areas { get; set; } = [];

	/// <summary>Every light in the house, for when the operator widens the pickers past this zone's area.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> Lights { get; set; } = [];

	/// <summary>Every binary sensor in the house discovery would accept as motion.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> MotionSensors { get; set; } = [];

	/// <summary>Every illuminance sensor in the house.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> LuxSensors { get; set; } = [];

	/// <summary>Everything that can act as an auto-on blocker.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> Blockers { get; set; } = [];

	/// <summary>Every sun entity.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> SunEntities { get; set; } = [];

	/// <summary>Raised when the zone changes, so the page can re-validate and re-preview.</summary>
	[Parameter]
	public EventCallback Changed { get; set; }

	/// <summary>Raised when the operator removes this zone.</summary>
	[Parameter]
	public EventCallback Removed { get; set; }

	private ZonePreview Preview { get; set; } = new(null, null);

	/// <summary>
	///     Whether the fold starts open. Decided once: a zone with no area is unconfigured and demands
	///     attention, so it opens; a configured zone starts folded to a header. After that the fold belongs
	///     to the operator — this renders the same value every time, so Blazor's diff never overrides a
	///     toggle a human made.
	/// </summary>
	private bool _openInitially;

	/// <summary>The header's name: whatever the dashboard would call this zone.</summary>
	private string DisplayName =>
		Zone.Name is { Length: > 0 } name ? name
		: Zone.AreaId is { Length: > 0 } areaId ? areaId
		: "New zone";

	/// <summary>
	///     One collapsed line on how far this zone strays from the defaults — the question a folded list of
	///     zones should answer without being opened.
	/// </summary>
	/// <remarks>
	///     The explicit-entities case states what is pinned and counts it — "2 lights, 1 motion sensor set
	///     explicitly" — rather than the old "hand-picked entities", which implied the operator picked them by
	///     hand. Often nobody did: the lists may have been written by an import or an earlier tool, and a
	///     summary line is there to report the document, not to attribute intent.
	/// </remarks>
	private string SummaryHint
	{
		get
		{
			int overrides = OverrideCount;

			return (overrides, HasExplicitEntities) switch
			{
				(0, false) => "all automatic",
				(0, true) => $"{PinnedSummary} picked by hand",
				(_, false) => $"{overrides} of 17 changed",
				_ => $"{PinnedSummary} picked by hand · {overrides} of 17 changed"
			};
		}
	}

	/// <summary>Counts what the zone lists instead of discovering: "2 lights, 1 motion sensor, lux sensor".</summary>
	private string PinnedSummary
	{
		get
		{
			List<string> parts = new List<string>(4);

			if (Zone.Lights is { Count: > 0 } lights)
				parts.Add($"{lights.Count} light{(lights.Count == 1 ? "" : "s")}");

			if (Zone.MotionSensors is { Count: > 0 } motion)
				parts.Add($"{motion.Count} motion sensor{(motion.Count == 1 ? "" : "s")}");

			if (Zone.LuxSensor is { Length: > 0 })
				parts.Add("lux sensor");

			if (Zone.IgnoreWhenOn is { Count: > 0 } blockers)
				parts.Add($"{blockers.Count} blocker{(blockers.Count == 1 ? "" : "s")}");

			return string.Join(", ", parts);
		}
	}

	/// <inheritdoc/>
	protected override void OnInitialized() => _openInitially = Zone.AreaId is not { Length: > 0 };

	// Computed once per Refresh rather than read from the catalog in a getter: these are read during render,
	// and Blazor renders this component on every keystroke in it.
	private IReadOnlyList<EntityOption> _lightOptions = [];
	private IReadOnlyList<EntityOption> _motionOptions = [];
	private IReadOnlyList<EntityOption> _luxOptions = [];

	private bool _showAllEntities;

	/// <summary>Whether the pickers are filtered to the zone's area. With no area chosen there is nothing to filter to.</summary>
	private bool ScopeToArea => !_showAllEntities && Zone.AreaId is { Length: > 0 };

	/// <summary>
	///     Whether the registry answered at all — the areas are hoisted from the page, so an empty list here means
	///     nothing came back rather than that this house has no areas.
	/// </summary>
	private bool RegistryAnswered => Areas.Count > 0;

	/// <summary>
	///     Why a picker has nothing to offer. Scoping to an area makes an empty list ordinary rather than alarming
	///     — most areas have no lux sensor — so it must not be reported as a broken connection.
	/// </summary>
	private string EmptyNote(string what) =>
		!RegistryAnswered ? "Waiting for Home Assistant — type an id for now."
		: ScopeToArea ? $"No {what} in this room. Tick “show entities from other rooms” to pick from the whole house."
		: $"No {what} found anywhere in Home Assistant — type an id if one is coming.";

	private bool HasExplicitEntities =>
		Zone.Lights is { Count: > 0 } || Zone.MotionSensors is { Count: > 0 }
		|| Zone.LuxSensor is { Length: > 0 } || Zone.IgnoreWhenOn is { Count: > 0 };

	private int OverrideCount =>
		(Zone.VacancyTimeoutSeconds is not null ? 1 : 0) + (Zone.PreOffSeconds is not null ? 1 : 0)
		+ (Zone.PreOffBrightnessFactor is not null ? 1 : 0) + (Zone.OverrideDurationMinutes is not null ? 1 : 0)
		+ (Zone.VacancyResetMinutes is not null ? 1 : 0) + (Zone.Darkness is not null ? 1 : 0)
		+ (Zone.LuxThreshold is not null ? 1 : 0) + (Zone.LuxHysteresis is not null ? 1 : 0)
		+ (Zone.SunElevationThreshold is not null ? 1 : 0) + (Zone.SunEntity is not null ? 1 : 0)
		+ (Zone.DayTransitionSeconds is not null ? 1 : 0) + (Zone.NightTransitionSeconds is not null ? 1 : 0)
		+ (Zone.RespectSleepMode is not null ? 1 : 0) + (Zone.SleepBlocksAutoOn is not null ? 1 : 0)
		+ (Zone.SkipAwaySweep is not null ? 1 : 0) + (Zone.WelcomeHome is not null ? 1 : 0)
		+ (Zone.Enabled is not null ? 1 : 0);

	private bool HasOverrides => OverrideCount > 0;

	// The nullable twins cannot be bound directly by @bind on a control that is only rendered while the
	// override is on: @bind on an int? input treats a cleared box as null, which would silently turn an
	// override back into "inherit" the moment somebody selected the text. These properties keep the null
	// question where it belongs — the override switch — and the input to a plain value.
	private int ZoneVacancyTimeout { get => Zone.VacancyTimeoutSeconds ?? Defaults.VacancyTimeoutSeconds; set => Assign(() => Zone.VacancyTimeoutSeconds = value); }
	private int ZonePreOff { get => Zone.PreOffSeconds ?? Defaults.PreOffSeconds; set => Assign(() => Zone.PreOffSeconds = value); }
	private double ZonePreOffFactor { get => Zone.PreOffBrightnessFactor ?? Defaults.PreOffBrightnessFactor; set => Assign(() => Zone.PreOffBrightnessFactor = value); }
	private int ZoneOverrideDuration { get => Zone.OverrideDurationMinutes ?? Defaults.OverrideDurationMinutes; set => Assign(() => Zone.OverrideDurationMinutes = value); }
	private int ZoneVacancyReset { get => Zone.VacancyResetMinutes ?? Defaults.VacancyResetMinutes; set => Assign(() => Zone.VacancyResetMinutes = value); }
	private double ZoneLuxThreshold { get => Zone.LuxThreshold ?? Defaults.LuxThreshold; set => Assign(() => Zone.LuxThreshold = value); }
	private double ZoneLuxHysteresis { get => Zone.LuxHysteresis ?? Defaults.LuxHysteresis; set => Assign(() => Zone.LuxHysteresis = value); }
	private double ZoneSunElevation { get => Zone.SunElevationThreshold ?? Defaults.SunElevationThreshold; set => Assign(() => Zone.SunElevationThreshold = value); }
	private double ZoneDayFade { get => Zone.DayTransitionSeconds ?? Defaults.DayTransitionSeconds; set => Assign(() => Zone.DayTransitionSeconds = value); }
	private double ZoneNightFade { get => Zone.NightTransitionSeconds ?? Defaults.NightTransitionSeconds; set => Assign(() => Zone.NightTransitionSeconds = value); }

	private string _darkness = nameof(DarknessSource.Either);
	private string _enabled = "true";
	private string _respectSleep = "false";
	private string _sleepBlocks = "false";
	private string _skipAway = "false";
	private string _welcomeHome = "false";

	/// <inheritdoc/>
	protected override void OnParametersSet()
	{
		_darkness = (Zone.Darkness ?? Defaults.Darkness).ToString();
		_enabled = Lower(Zone.Enabled ?? Defaults.Enabled);
		_respectSleep = Lower(Zone.RespectSleepMode ?? Defaults.RespectSleepMode);
		_sleepBlocks = Lower(Zone.SleepBlocksAutoOn ?? Defaults.SleepBlocksAutoOn);
		_skipAway = Lower(Zone.SkipAwaySweep ?? Defaults.SkipAwaySweep);
		_welcomeHome = Lower(Zone.WelcomeHome ?? Defaults.WelcomeHome);

		Refresh();
	}

	private string Name(string entityId) => Catalog.FriendlyNameOf(entityId) ?? entityId;

	private static string YesNo(bool value) => value ? "yes" : "no";

	private static string Lower(bool value) => value ? "true" : "false";

	private async Task OnAreaChanged(string? areaId)
	{
		Zone.AreaId = areaId;

		// The name follows the area unless somebody has typed one. A zone called "stue" is worse than a zone
		// called "Stue", and making them type it again is worse than both.
		if (string.IsNullOrWhiteSpace(Zone.Name) && areaId is { Length: > 0 })
			Zone.Name = Areas.FirstOrDefault(area => string.Equals(area.Id, areaId, StringComparison.Ordinal))?.Name ?? areaId;

		await Notify().ConfigureAwait(false);
	}

	private Task Set(Action mutate)
	{
		mutate();
		return Notify();
	}

	private Task SetList(IReadOnlyList<string> value, Action<List<string>?> assign)
	{
		// An empty list and a null list are different instructions: null means "discover", [] would mean "this
		// zone has no lights", which is never what clearing the last chip meant.
		assign(value.Count == 0 ? null : [.. value]);
		return Notify();
	}

	private void Assign(Action mutate)
	{
		mutate();
		Refresh();
		_ = Changed.InvokeAsync();
	}

	private async Task Notify()
	{
		Refresh();
		await Changed.InvokeAsync().ConfigureAwait(false);
	}

	private Task Remove() => Removed.InvokeAsync();

	// Each select writes straight through to the zone rather than leaving the field to be swept up later:
	// a shadow field that is only reconciled on the next Refresh is a value that is briefly a lie, and the
	// discovery preview reads the zone.
	private Task OnDarknessChanged(string value)
	{
		_darkness = value;
		if (Enum.TryParse<DarknessSource>(value, out DarknessSource darkness))
			Zone.Darkness = darkness;

		return Notify();
	}

	private Task OnEnabledChanged(string value) { _enabled = value; Zone.Enabled = IsYes(value); return Notify(); }

	private Task OnRespectSleepChanged(string value) { _respectSleep = value; Zone.RespectSleepMode = IsYes(value); return Notify(); }

	private Task OnSleepBlocksChanged(string value) { _sleepBlocks = value; Zone.SleepBlocksAutoOn = IsYes(value); return Notify(); }

	private Task OnSkipAwayChanged(string value) { _skipAway = value; Zone.SkipAwaySweep = IsYes(value); return Notify(); }

	private Task OnWelcomeHomeChanged(string value) { _welcomeHome = value; Zone.WelcomeHome = IsYes(value); return Notify(); }

	private static bool IsYes(string value) => string.Equals(value, "true", StringComparison.Ordinal);

	// Widening the pickers changes what they offer, so the lists have to be rebuilt rather than left showing
	// the area's entities under a checkbox that says otherwise. It changes no configured value, so the page is
	// not told: this is a view of the zone, not an edit to it.
	private void OnShowAllChanged(bool showAll)
	{
		_showAllEntities = showAll;
		Refresh();
	}

	private void Refresh()
	{
		Preview = Catalog.PreviewZone(Zone, Defaults, Global);

		AreaEntities inArea = Catalog.EntitiesInArea(Zone.AreaId, Global);

		_lightOptions = Scope(inArea.Lights, Lights, Zone.Lights);
		_motionOptions = Scope(inArea.MotionSensors, MotionSensors, Zone.MotionSensors);
		_luxOptions = Scope(inArea.LuxSensors, LuxSensors, Zone.LuxSensor is { Length: > 0 } lux ? [lux] : null);
	}

	/// <summary>
	///     The options one picker offers: the area's, unless the operator has widened them.
	/// </summary>
	/// <remarks>
	///     <paramref name="inArea"/> is discovery's own answer, so the scoped list cannot disagree with the
	///     preview above it — a ghost the engine drops is not offered here either.
	/// </remarks>
	private IReadOnlyList<EntityOption> Scope(
		IReadOnlyList<EntityOption> inArea,
		IReadOnlyList<EntityOption> everywhere,
		IReadOnlyList<string>? configured)
	{
		if (!ScopeToArea)
			return everywhere;

		// An entity already configured from outside the area stays listed and stays selected. A filter is a
		// default; it is never a reason to silently drop a value somebody chose on purpose, and "the area
		// assignment is wrong" is precisely why this list exists at all.
		IEnumerable<EntityOption> outsiders = configured is null
			? []
			: everywhere.Where(option =>
				configured.Contains(option.EntityId, StringComparer.Ordinal)
				&& !inArea.Any(local => string.Equals(local.EntityId, option.EntityId, StringComparison.Ordinal)));

		return [.. inArea.Concat(outsiders).OrderBy(option => option.FriendlyName, StringComparer.CurrentCulture)];
	}
}
