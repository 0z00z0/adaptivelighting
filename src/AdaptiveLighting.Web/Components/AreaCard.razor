@*
	One area, told as a story rather than dumped as fields: what the lights are doing, what happened
	last, what happens next, and the conditions the engine saw — each dated, so nothing stale can pass
	itself off as current. The colour language is the state-machine diagram's: blue when the engine
	decides, amber when a human did, grey when the engine is watching but not commanding. A lit area
	glows in the warmth it was actually commanded to, straight off the Kelvin value. The countdown bar
	draws the span the engine published — both ends — and ticks on the page's own clock; when an event
	predates NextChangeFrom the bar is simply absent rather than drawn from an invented start.
*@

<article class="area family-@Family" aria-label="@Snapshot.AreaName">
	@*
		The badge used to be a word in a colour, and the colour was the only thing saying which state this
		was — invisible to a colourblind reader and to every greyscale screenshot. It is now a shared chip
		carrying a shape as well, and the words come from the same mapping the rest of the UI reads, so no
		two surfaces can name one state two ways.
	*@
	<header class="area-head">
		<span class="lamp @LampClass" style="@LampStyle" aria-hidden="true"></span>
		<span class="area-name">@Snapshot.AreaName</span>
		<StateChip State="@Snapshot.State" Kelvin="@Snapshot.ColorTempKelvin" Title="@($"State: {Snapshot.State}")" />
	</header>

	<p class="area-line">@Headline</p>

	<p class="area-event">
		<span class="event-text">@EventText</span>
		<span class="event-when" title="@Local(Snapshot.Timestamp)">@Ago(Snapshot.Timestamp)</span>
	</p>

	@if (NextLine is { Length: > 0 } next)
	{
		<p class="area-next @(IsOverdue ? "overdue" : null)">@next</p>
	}

	@if (CountdownRemaining is { } remaining)
	{
		<div class="area-countdown" role="progressbar" aria-valuemin="0" aria-valuemax="100"
			 aria-valuenow="@((int)(remaining * 100))" aria-label="Time until the next change"
			 title="@CountdownTitle">
			<div class="area-countdown-fill" style="width: @((remaining * 100).ToString("0.0", CultureInfo.InvariantCulture))%"></div>
		</div>
	}

	<dl class="area-stats">
		<div class="stat" title="@MotionTitle">
			<dt>motion</dt>
			<dd>@MotionStat</dd>
		</div>
		<div class="stat" title="@LightsTitle">
			<dt>command</dt>
			<dd>@CommandStat</dd>
		</div>
		<div class="stat" title="@NextTitle">
			<dt>next</dt>
			<dd>@NextStat</dd>
		</div>
	</dl>

	<footer class="area-meta">
		@if (Snapshot.KillSwitchActive)
		{
			<span class="chip chip-alert" title="Adaptive lighting is switched off for the whole house.">kill switch on</span>
		}
		<span class="chip" title="@DarknessTitle">@DarknessChip</span>
		<span class="chip" title="The schedule period this room is in. It sets brightness and warmth.">@(Snapshot.PeriodName ?? "no period")</span>
		<span class="chip" title="The house-wide mode at the last report.">@HouseChip</span>
		<span class="chip chip-when" title="When this room last reported. The card shows that moment.">
			reported @Local(Snapshot.Timestamp)
		</span>
	</footer>
</article>

@code {
	/// <summary>The area's most recent report. Everything on the card derives from it.</summary>
	[Parameter, EditorRequired]
	public AreaSnapshot Snapshot { get; set; } = default!;

	/// <summary>
	///     The page's "now", passed in rather than read here so every card on a render agrees on it and the
	///     page's one-second tick moves them all together.
	/// </summary>
	[Parameter]
	public DateTimeOffset Now { get; set; }

	private bool IsLitByEngine => Snapshot.State is AreaState.AutoActive or AreaState.PreOff
		&& Snapshot.BrightnessPct is not null;

	/// <summary>
	///     The card's colour family. Shared with the settings list through <see cref="AreaView.Family"/> so the
	///     two pages cannot drift: a person who learns "amber means somebody touched it" here must read the same
	///     fact in Settings.
	/// </summary>
	private string Family => AreaView.Family(Snapshot.State);

	// An adopted area's lights are on, but at levels the engine never chose and cannot read back — so the lamp
	// is lit and colourless rather than either dark (a lie) or warm (a level it would be inventing).
	private string LampClass => IsLitByEngine ? "lamp-lit"
		: IsAdopted ? "lamp-adopted"
		: Snapshot.State == AreaState.OverriddenOn ? "lamp-human"
		: "lamp-off";

	/// <summary>
	///     A lit lamp glows in the commanded warmth, at a strength that follows the commanded brightness.
	///     Decoration derived from data, not a palette choice: the 2200 K night dim and the 4500 K midday
	///     white are visibly different rooms, so they should be visibly different dots.
	/// </summary>
	private string LampStyle
	{
		get
		{
			if (!IsLitByEngine)
				return string.Empty;

			string colour = KelvinCss(Snapshot.ColorTempKelvin ?? 3000);
			double strength = 4 + (Snapshot.BrightnessPct ?? 50) / 8;
			return $"background:{colour}; box-shadow: 0 0 {strength:0}px {colour};";
		}
	}

	/// <summary>
	///     Whether the engine is running this area on lights it never turned on — adopted at start-up and held
	///     since, with no command of its own. The card must not describe those levels as the engine's doing.
	/// </summary>
	private bool IsAdopted => Snapshot.State is AreaState.AutoActive && Snapshot.LastCommandAt is null;

	private string Headline => Snapshot.State switch
	{
		AreaState.AutoActive when IsAdopted =>
			"These lights were already on at startup. They're managed now — their levels weren't touched.",
		AreaState.AutoActive => Levels("Lit at"),
		AreaState.PreOff => Levels("Dimmed to", " as a warning"),
		AreaState.AutoVacant when Snapshot.LastCommandAt is null =>
			"Watching for movement. The lights haven't been touched yet.",
		AreaState.AutoVacant when Snapshot.BrightnessPct is null =>
			"Lights off, watching for movement.",
		AreaState.AutoVacant => "Watching for movement.",
		AreaState.OverriddenOn => "Someone set these lights by hand — they're being left alone.",
		AreaState.SuppressedOff => "Someone switched these lights off. Movement is ignored for now.",
		AreaState.Away when Snapshot.BrightnessPct is not null => "Nobody home. This area keeps its lights on.",
		AreaState.Away when Snapshot.LastCommandAt is not null => "Nobody home. The lights were swept off.",
		AreaState.Away => "Nobody home.",
		AreaState.Disabled when Snapshot.KillSwitchActive =>
			"Paused by the master switch.",
		AreaState.Disabled => "Automatic lighting is switched off for this room.",
		_ => string.Empty
	};

	private string Levels(string prefix, string suffix = "")
	{
		if (Snapshot.BrightnessPct is not { } brightness)
			return $"{prefix.TrimEnd()} — level unknown{suffix}.";

		return Snapshot.ColorTempKelvin is { } kelvin
			? $"{prefix} {brightness:0} %{suffix} — {Warmth(kelvin)}, {kelvin} K."
			: $"{prefix} {brightness:0} %{suffix}.";
	}

	private static string Warmth(int kelvin) => kelvin switch
	{
		< 2600 => "candlelight warm",
		< 3300 => "warm white",
		< 4100 => "neutral white",
		_ => "cool daylight"
	};

	private string EventText => Snapshot.Reason switch
	{
		TransitionReason.Startup => "Started up and took the room as it was",
		TransitionReason.AdoptedAtStartup => "Started up and found these lights already on",
		TransitionReason.Motion => "Movement",
		TransitionReason.VacancyTimeout => "No movement for the area's timeout",
		TransitionReason.PreOffElapsed => "Nobody answered the dim warning, so the lights went off",
		TransitionReason.ManualOn => "Someone set the lights by hand",
		TransitionReason.ManualOff => "Someone switched the lights off by hand",
		TransitionReason.OverrideExpired => "The hand-set levels ran their course",
		TransitionReason.SuppressionLifted => "Quiet long enough — back under automatic control",
		TransitionReason.EveryoneLeft => "The last person left the house",
		TransitionReason.FirstPersonArrived => "The first person came home",
		TransitionReason.EnablementChanged => "Automatic lighting was switched on or off for this room",
		TransitionReason.CircadianTick => "Retuned the lights to the time of day",
		TransitionReason.HouseModeChanged => "The house changed mode",
		_ => Snapshot.Reason.ToString()
	};

	private bool IsOverdue =>
		Snapshot.NextChangeAt is { } due && Now - due > TimeSpan.FromSeconds(90);

	/// <summary>
	///     The future, from the deadline the engine armed. When the deadline is long past and no new report
	///     replaced it, the honest reading is that the page has lost touch — so it says that instead.
	/// </summary>
	private string? NextLine
	{
		get
		{
			if (IsOverdue)
				return $"An update was due {Ago(Snapshot.NextChangeAt!.Value)} and hasn't arrived. " +
					"The Home Assistant connection may be down.";

			string? countdown = Snapshot.NextChangeAt is { } due ? In(due) : null;

			return Snapshot.State switch
			{
				AreaState.AutoActive when countdown is not null =>
					$"Starts dimming {countdown} unless someone moves.",
				AreaState.PreOff when countdown is not null =>
					$"Lights out {countdown} — any movement keeps them on.",
				AreaState.OverriddenOn when countdown is not null =>
					$"Back under automatic control {countdown}; movement in the meantime keeps the room counted as occupied.",
				AreaState.SuppressedOff when countdown is not null =>
					$"Starts answering movement again {countdown}, sooner if the room stays quiet.",
				AreaState.AutoVacant when Snapshot is { IsDark: false, DarknessDetail: { Length: > 0 } detail } =>
					$"Too bright to turn on right now ({detail}). Movement will light it once it's dark.",
				AreaState.AutoVacant when Snapshot.IsDark is false =>
					"Too bright to turn on right now. Movement will light it once it's dark.",
				AreaState.AutoVacant => "Movement in the dark turns the lights on.",
				AreaState.Away => "Wakes when the first person comes home.",
				AreaState.Disabled => "Nothing will be commanded until it is switched back on.",
				_ => null
			};
		}
	}

	private string DarknessChip => Snapshot.IsDark switch
	{
		true => "dark enough",
		false => "too light",
		null => "darkness unchecked"
	};

	private string DarknessTitle => Snapshot.IsDark is null
		? "Darkness hasn't been checked here yet."
		: Snapshot.DarknessDetail is { Length: > 0 } detail
			? $"Dark enough to light? Last checked {Local(Snapshot.Timestamp)} — {detail}."
			: $"Whether the room was dark enough to light, last checked {Local(Snapshot.Timestamp)}.";

	private string HouseChip => Snapshot.HouseModeValue is { Length: > 0 } raw
		? raw
		: Snapshot.Mode switch
		{
			HouseMode.Home => "somebody home",
			HouseMode.Away => "house empty",
			HouseMode.Sleep => "house asleep",
			HouseMode.Guest => "guests over",
			_ => Snapshot.Mode.ToString()
		};

	/// <summary>
	///     How much of the armed countdown is left, 1 down to 0 — the bar drains toward the deadline rather
	///     than filling, which reads as time running out. <c>null</c> when there is no honest bar to draw:
	///     no deadline, no armed instant (events from builds that predate <see cref="AreaSnapshot.NextChangeFrom"/>),
	///     a degenerate span, or an overdue deadline that the overdue line already explains. A missing start is
	///     a missing bar, never an invented one.
	/// </summary>
	private double? CountdownRemaining
	{
		get
		{
			if (IsOverdue || Snapshot.NextChangeAt is not { } due || Snapshot.NextChangeFrom is not { } from || due <= from)
				return null;

			return Math.Clamp((due - Now).TotalSeconds / (due - from).TotalSeconds, 0, 1);
		}
	}

	private string CountdownTitle =>
		Snapshot.NextChangeAt is { } due && Snapshot.NextChangeFrom is { } from
			? $"{Span(due - Now)} of {Span(due - from)} left. The countdown was armed at {Local(from)}."
			: string.Empty;

	private string MotionStat => Snapshot.LastMotionAt is { } at ? Ago(at) : "none seen";

	private string MotionTitle => Snapshot.LastMotionAt is { } at
		? $"Motion was last seen at {Local(at)}."
		: "No motion seen since startup.";

	/// <summary>
	///     The engine's standing command with its age. "None yet" is a different fact from "off" — after a
	///     restart the first is true while the ceiling light may well be on, and the card must not claim
	///     otherwise.
	/// </summary>
	private string CommandStat => Snapshot.LastCommandAt is { } at
		? Snapshot.BrightnessPct is { } brightness ? $"{brightness:0} % · {Ago(at)}" : $"off · {Ago(at)}"
		: "none yet";

	private string NextStat =>
		IsOverdue ? "overdue"
		: Snapshot.NextChangeAt is { } due ? In(due)
		: "—";

	private string NextTitle => Snapshot.NextChangeAt is { } due
		? $"The next change is due at {Local(due)}."
		: "Nothing is scheduled — waiting for movement or the time of day.";

	private string LightsTitle => Snapshot.LastCommandAt is { } at
		? $"The last automatic change to these lights, at {Local(at)}."
		: "These lights haven't been changed automatically since startup.";

	private static string Local(DateTimeOffset at) => at.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture);

	/// <summary>Relative past time, kept truthful by the page's one-second tick.</summary>
	private string Ago(DateTimeOffset at)
	{
		TimeSpan span = Now - at;

		if (span < TimeSpan.FromSeconds(10))
			return "just now";
		if (span < TimeSpan.FromMinutes(1))
			return $"{(int)span.TotalSeconds} s ago";
		if (span < TimeSpan.FromHours(1))
			return $"{(int)span.TotalMinutes} min ago";
		if (span < TimeSpan.FromDays(1))
			return span.Minutes == 0 ? $"{(int)span.TotalHours} h ago" : $"{(int)span.TotalHours} h {span.Minutes} min ago";

		return $"{(int)span.TotalDays} d ago";
	}

	/// <summary>Relative future time. Never negative: the overdue path takes over before it could be.</summary>
	private string In(DateTimeOffset due)
	{
		TimeSpan span = due - Now;

		if (span <= TimeSpan.Zero)
			return "any moment now";
		if (span < TimeSpan.FromMinutes(2))
			return $"in {(int)span.TotalSeconds} s";
		if (span < TimeSpan.FromHours(1))
			return $"in {(int)span.TotalMinutes} min";

		return span.Minutes == 0 ? $"in {(int)span.TotalHours} h" : $"in {(int)span.TotalHours} h {span.Minutes} min";
	}

	/// <summary>A bare duration, for the countdown tooltip's "x of y left".</summary>
	private static string Span(TimeSpan span)
	{
		if (span < TimeSpan.Zero)
			span = TimeSpan.Zero;
		if (span < TimeSpan.FromMinutes(2))
			return $"{(int)span.TotalSeconds} s";
		if (span < TimeSpan.FromHours(1))
			return $"{(int)span.TotalMinutes} min";

		return span.Minutes == 0 ? $"{(int)span.TotalHours} h" : $"{(int)span.TotalHours} h {span.Minutes} min";
	}

	/// <summary>
	///     Colour temperature to CSS colour, by the usual blackbody approximation. Purely decorative — the
	///     engine's Kelvin number is the source, no palette is hard-coded.
	/// </summary>
	private static string KelvinCss(int kelvin)
	{
		double k = Math.Clamp(kelvin, 1500, 6600) / 100.0;

		int g = (int)Math.Clamp(99.4708025861 * Math.Log(k) - 161.1195681661, 0, 255);
		int b = (int)Math.Clamp(138.5177312231 * Math.Log(k - 10) - 305.0447927307, 0, 255);

		return $"rgb(255, {g}, {b})";
	}
}
