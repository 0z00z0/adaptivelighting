@*
	What a room says for itself the moment somebody switches it on: how many lights "on" now reaches, which of
	them look like something other than room lighting, and the one setting that narrows what is managed.

	Advisory, and after the fact. The switch has already worked — nothing here blocks it, and nothing here has to
	be answered — so somebody who knows their house carries on without a second click and dismisses this when they
	feel like it. A dialog in front of the switch would tax every honest two-lamp room forever to catch the rare
	room that resolves to thirty-four entities including an access point.

	One component rather than two copies, because the house tab's room row and the room page's header raise the
	same note about the same room, and two copies would eventually word it two ways.
*@

<div class="notice @(Note.IsWarning ? "warn" : "info") switch-note">
	<strong class="switch-note-lead">@Note.Lead</strong>

	@if (Note.Suspicious.Count > 0)
	{
		<div class="switch-note-suspects">
			@foreach (SuspectLight suspect in Note.Suspicious)
			{
				<span class="gchip gchip-suspect">
					<span class="chip-name">@suspect.Name</span>
					<code class="chip-id">@suspect.EntityId</code>
					<span class="chip-why">@suspect.Reason</span>
				</span>
			}
		</div>
	}

	@if (Note.OthersLine is { Length: > 0 } others)
	{
		<p class="switch-note-rest">@others</p>
	}

	@if (Note.Advice is { Length: > 0 } advice)
	{
		<p class="switch-note-advice">
			@advice
			@if (AdviceHref is { Length: > 0 } href)
			{
				<a href="@href">Open Finding lights &amp; sensors</a>
			}
		</p>
	}

	<div class="panel-actions">
		<button type="button" @onclick="Dismiss">Got it</button>
	</div>
</div>

@code {
	/// <summary>The note to render, from <see cref="SwitchOnWarning.For"/>. Never built here.</summary>
	[Parameter, EditorRequired]
	public SwitchOnNote Note { get; set; } = new("", [], [], null);

	/// <summary>
	///     Where the include-label setting lives, when it is on another page.
	/// </summary>
	/// <remarks>
	///     Left unset on the House tab, where the setting is a fold further down the same section and a link would
	///     send somebody away from the thing they are already looking at.
	/// </remarks>
	[Parameter]
	public string? AdviceHref { get; set; }

	/// <summary>Raised when the note is dismissed. The page decides not to raise it again for that room.</summary>
	[Parameter]
	public EventCallback Dismissed { get; set; }

	private Task Dismiss() => Dismissed.InvokeAsync();
}
