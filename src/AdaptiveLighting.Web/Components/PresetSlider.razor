@using System.Text.Json
@inject IJSRuntime Js
@inject ILogger<PresetSlider> Logger
@implements IAsyncDisposable

@* Fixed stops on a rail, so a value is dragged rather than hunted for in a list. The leftmost stop is not a
   number: where Inheritable is set it means "state nothing here". It sits in a recessed pocket before the real
   0-100 rail (psl-inheritable draws the seam), so it can never be read as the dimmest setting rather than as
   something outside the range entirely. The hollow thumb marks the pocket is where the thumb currently sits.

   A stored value the ladder does not carry gets a position of its own, never the nearest stop. Opening the
   page has to leave a hand-edited document exactly as it was.

   Rail and readout share one line, the number after the rail: a settings row on a phone is read left to right,
   and a readout on a line of its own doubles the height of every row on the page.

   The readout tracks the thumb during a drag from plain JS (preset-slider.js), reading data-psl-readouts rather
   than waiting for the server round trip @onchange commits on release. Brightness alone also carries a
   press-and-hold satellite handle for single 8-bit raw-brightness steps; colour temperature has no raw unit
   worth exposing that way. *@

<div class="psl @(OnDefault ? "psl-default" : null) @(Inheritable ? "psl-inheritable" : null)">
	<div class="psl-line">
		@if (Label is { Length: > 0 })
		{
			<span class="psl-label">@Label</span>
		}

		@if (Inheritable)
		{
			<span class="psl-home" title="@DefaultLabel" aria-hidden="true"></span>
		}

		<input class="psl-range" type="range" min="0" max="@Invariant(Max)" step="1" value="@Invariant(_position)"
			   style="@Fill"
			   aria-label="@AriaLabel"
			   aria-valuetext="@SpokenValue"
			   data-psl-readouts="@ReadoutsJson"
			   data-psl-fine="@FineHandleOffered"
			   @ref="_range"
			   @onchange="OnMoved" />

		@if (FineAdjustable)
		{
			<div class="psl-satellite" hidden aria-hidden="true" @ref="_satellite"></div>
		}

		<span class="psl-read">
			@if (Mark is not null)
			{
				@Mark
			}

			@if (Inheritable)
			{
				<span class="psl-borrow-group" hidden="@(!OnDefault)">
					<span class="psl-glyph" aria-hidden="true"></span>
					<span class="psl-default-text">@DefaultLabel</span>
					<span class="psl-borrowed">@PlainText</span>
				</span>
				<span class="psl-value-group" hidden="@OnDefault">
					<span class="psl-value">@StepText</span>
					@if (_unlisted)
					{
						<span class="psl-custom">custom</span>
					}
				</span>
			}
			else
			{
				<span class="psl-value">@StepText</span>
				@if (_unlisted)
				{
					<span class="psl-custom">custom</span>
				}
			}
		</span>
	</div>
</div>

@code {
	/// <summary>The number in force here: this surface's own, or the one it is borrowing.</summary>
	[Parameter]
	public double Value { get; set; }

	/// <summary>Whether <see cref="Value"/> is borrowed from above rather than stated on this surface.</summary>
	[Parameter]
	public bool AtDefault { get; set; }

	/// <summary>The stops to offer, from <see cref="Presets"/>.</summary>
	[Parameter, EditorRequired]
	public IReadOnlyList<PresetChoice> Options { get; set; } = [];

	/// <summary>Whether the rail carries a leftmost stop meaning "state nothing here".</summary>
	/// <remarks><c>false</c> where there is nothing above to borrow from, as on the house's own schedule.</remarks>
	[Parameter]
	public bool Inheritable { get; set; }

	/// <summary>What the leftmost stop is called, e.g. <c>the schedule's</c>.</summary>
	[Parameter]
	public string DefaultLabel { get; set; } = "the house default";

	/// <summary>Unit written after a bare number, e.g. <c>%</c> or <c>K</c>.</summary>
	[Parameter]
	public string? Unit { get; set; }

	/// <summary>Whether the readout carries each stop's own wording, or only its number.</summary>
	[Parameter]
	public bool ShowStepWording { get; set; }

	/// <summary>Shown beside the control on a narrow screen, where the table's heading row is gone.</summary>
	[Parameter]
	public string? Label { get; set; }

	/// <summary>Names the control for a screen reader, which has no heading row to read.</summary>
	[Parameter]
	public string AriaLabel { get; set; } = "";

	/// <summary>Drawn at the start of the readout: a warmth swatch, an own-setting dot.</summary>
	[Parameter]
	public RenderFragment? Mark { get; set; }

	/// <summary>Brightness only: press-and-hold the thumb to reveal a satellite handle that nudges the value in
	/// single 8-bit raw-brightness steps. Colour temperature has no raw unit this would mean anything against.</summary>
	[Parameter]
	public bool FineAdjustable { get; set; }

	/// <summary><c>null</c> asks to go back to the default; a number states one here.</summary>
	[Parameter]
	public EventCallback<double?> ValueChanged { get; set; }

	private List<double> _steps = [];
	private int _position;
	private bool _unlisted;
	private List<Readout> _readouts = [];

	private ElementReference _range;
	private ElementReference _satellite;
	private DotNetObjectReference<PresetSlider>? _self;
	private bool _watchingFine;
	private int _fineRaw;

	// Worked out once per parameter change, not per read: Max, the fill fraction and the readout all want it,
	// on a page that re-renders at 1 Hz.
	protected override void OnParametersSet()
	{
		_steps = [.. Options.Select(option => option.Value)];

		double shown = Shown;
		int found = _steps.FindIndex(step => Matches(step, shown));

		_unlisted = !OnDefault && found < 0;

		if (_unlisted)
		{
			_steps.Add(shown);
			_steps.Sort();
			found = _steps.FindIndex(step => Matches(step, shown));
		}

		_position = OnDefault ? 0 : Math.Max(found, 0) + Offset;

		BuildReadouts();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender || !FineAdjustable || _watchingFine)
			return;

		_self ??= DotNetObjectReference.Create(this);

		try
		{
			await Js.InvokeVoidAsync("adaptiveLightingPresetSlider.watchFine", _range, _satellite, _self)
				.ConfigureAwait(true);
			_watchingFine = true;
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			// An exception out of OnAfterRenderAsync tears the circuit down. A missing script costs only the fine
			// handle; the coarse rail still works exactly as it did before this control existed.
			Logger.LogDebug(exception, "The brightness satellite could not attach its pointer handler; it stays coarse-only.");
		}
	}

	private static bool IsSurvivable(Exception exception) =>
		exception is JSDisconnectedException or JSException or OperationCanceledException;

	private bool OnDefault => Inheritable && AtDefault;

	// Arming the fine handle hands pointer capture to the satellite, and the coarse rail stops moving for the rest
	// of that gesture. A nudge clamps to a real byte and can never mean "borrow", so a rail docked in the pocket
	// would have no way back out of it. preset-slider.js refuses to arm without this attribute.
	private string? FineHandleOffered => FineAdjustable && !OnDefault ? "1" : null;

	// A half percent can arrive from a hand-edited file. It is shown rounded and moving the rail stores the
	// rounded number, so two surfaces never show one setting as two numbers. The file itself is left alone
	// until a save, which is ConfigNormalizer's job.
	private double Shown => ConfigNormalizer.Whole(Value);

	private int Offset => Inheritable ? 1 : 0;

	private int Max => Math.Max(_steps.Count - 1 + Offset, 0);

	/// <summary>The stop's own wording where the surface asks for it, and the bare number otherwise.</summary>
	private string StepText =>
		ShowStepWording && Options.FirstOrDefault(option => Matches(option.Value, Shown)) is { } named
			? named.Label
			: PlainText;

	private string PlainText => Format(Shown);

	private string SpokenValue => OnDefault ? $"{DefaultLabel}, {PlainText}" : StepText;

	private string Format(double value) => Unit is { Length: > 0 } unit ? $"{Invariant(value)} {unit}" : Invariant(value);

	private string Describe(double stepValue) =>
		ShowStepWording && Options.FirstOrDefault(option => Matches(option.Value, stepValue)) is { } named
			? named.Label
			: Format(stepValue);

	// A decimal comma in a style attribute is not a length, and the track would render unfilled under nb-NO.
	private string Fill
	{
		get
		{
			string fill = $"--psl-fill: {Invariant(Max > 0 ? _position * 100.0 / Max : 0)}%";

			// The pocket is drawn as the same fraction of the track that position 0 already occupies, so the
			// seam lines up with where the thumb actually docks rather than an arbitrary pixel width.
			return Inheritable && Max > 0
				? $"{fill}; --psl-pocket: {Invariant(100.0 / Max)}%"
				: fill;
		}
	}

	private static string Invariant(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

	private static bool Matches(double left, double right) => Math.Abs(left - right) < 0.001;

	/// <summary>One entry per slider position, so the client can show the right words while dragging without
	/// asking the server what a position means.</summary>
	private readonly record struct Readout(string Text, bool IsDefault, bool Custom);

	private void BuildReadouts()
	{
		List<Readout> readouts = new(Max + 1);

		if (Inheritable)
			readouts.Add(new Readout(PlainText, true, false));

		for (int index = 0; index < _steps.Count; index++)
			readouts.Add(new Readout(Describe(_steps[index]), false, _unlisted && index == _position - Offset));

		_readouts = readouts;
	}

	private string ReadoutsJson => JsonSerializer.Serialize(
		_readouts.Select(readout => new { t = readout.Text, d = readout.IsDefault, c = readout.Custom }));

	private Task OnMoved(ChangeEventArgs args)
	{
		if (!int.TryParse(args.Value as string, NumberStyles.Integer, CultureInfo.InvariantCulture, out int picked))
			return Task.CompletedTask;

		if (Inheritable && picked == 0)
			return ValueChanged.InvokeAsync(null);

		int index = picked - Offset;

		return index >= 0 && index < _steps.Count
			? ValueChanged.InvokeAsync(_steps[index])
			: Task.CompletedTask;
	}

	/// <summary>Snapshots the raw value the satellite starts nudging from, at the moment a hold is recognised.</summary>
	[JSInvokable]
	public void BeginFine() => _fineRaw = RawBrightnessStep.FromPercent(Shown);

	/// <summary>Moves the satellite's raw value by whole 8-bit steps and commits at once, clamped to a real byte.</summary>
	[JSInvokable]
	public Task NudgeFine(int steps)
	{
		if (!FineAdjustable)
			return Task.CompletedTask;

		_fineRaw = RawBrightnessStep.Nudge(_fineRaw, steps);

		return ValueChanged.InvokeAsync(RawBrightnessStep.ToPercent(_fineRaw));
	}

	// Order matters: the listener goes before the .NET reference it calls into, so a pointer already down when
	// the page is left cannot invoke a disposed component.
	public async ValueTask DisposeAsync()
	{
		if (_watchingFine)
		{
			try
			{
				await Js.InvokeVoidAsync("adaptiveLightingPresetSlider.releaseFine", _range).ConfigureAwait(false);
			}
			catch (Exception exception) when (IsSurvivable(exception))
			{
				Logger.LogDebug(exception, "The brightness satellite could not release its pointer handler.");
			}
		}

		_self?.Dispose();
	}
}
