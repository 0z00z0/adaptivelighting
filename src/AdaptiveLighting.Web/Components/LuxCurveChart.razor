@inject IJSRuntime Js
@inject ILogger<LuxCurveChart> Logger
@implements IAsyncDisposable

@*
	The room's daylight curve, drawn and dragged.

	Five numbers decide how far a bright day lifts this room above its schedule, and four of them are anchors on
	one line. Read as four rows of digits they are a puzzle; drawn as a line with the room's own reading standing
	on it, they are a picture — which is why the owner asked for a chart rather than better help text.

	The x axis is logarithmic, and not as a preference: illuminance spans four decades between a dark night and a
	bright day, and a linear axis spends nine tenths of its width on the top one. It is the same log-space
	interpolation the engine performs, so the axis is a picture of the arithmetic rather than a second opinion
	about it. Every y on the line comes from LuxBrightnessCurve.Raise itself — see Services/LuxCurve.cs.

	THREE WAYS TO SET THE SAME NUMBERS. The handles drag with a mouse, a pen or a finger (pointer events, with
	the surface capturing the pointer so a drag may leave the plot, and touch-action: none so a finger drags the
	curve instead of scrolling the page). Each handle is also a focusable slider: Tab reaches it and the arrow
	keys move it by the setting's own step. And the numbers themselves sit under the chart as the same steppers
	the settings rows use, because a value only a drag can reach is a value some people cannot reach at all.

	It writes nothing. Every change leaves as a CurveEdit and the page puts it through its own save path.
*@

<div class="luxc @(_grip == Grip.None ? null : "luxc-dragging")">
	<div class="luxc-plot">
		<svg class="luxc-svg"
			 viewBox="@_viewBox"
			 preserveAspectRatio="xMidYMid meet"
			 role="group"
			 aria-label="@Description">
			@((MarkupString)_backdrop)

			<g transform="@_plotOrigin">
				<path d="@_path" class="luxc-line" />

				@if (_start is { } start)
				{
					<circle class="luxc-handle @(_grip == Grip.Start ? "luxc-held" : null)"
							cx="@LuxCurve.Num(start.X)"
							cy="@LuxCurve.Num(start.Y)"
							r="7"
							tabindex="0"
							role="slider"
							aria-label="Daylight level where brightening starts"
							aria-valuemin="@LuxCurve.Num(StartSetting.Min)"
							aria-valuemax="@LuxCurve.Num(StartSetting.Max ?? LuxCurve.AxisMaxCeilingLux)"
							aria-valuenow="@LuxCurve.Num(Settings.LuxBrightnessStartLux)"
							aria-valuetext="@LuxCurve.Lux(Settings.LuxBrightnessStartLux)"
							@onkeydown="@(args => OnKey(Grip.Start, args))" />
				}

				@if (_full is { } full)
				{
					<circle class="luxc-handle @(_grip == Grip.Full ? "luxc-held" : null)"
							cx="@LuxCurve.Num(full.X)"
							cy="@LuxCurve.Num(full.Y)"
							r="7"
							tabindex="0"
							role="slider"
							aria-label="Daylight level for full brightness, and the brightest this room goes"
							aria-valuemin="@LuxCurve.Num(FullSetting.Min)"
							aria-valuemax="@LuxCurve.Num(FullSetting.Max ?? LuxCurve.AxisMaxCeilingLux)"
							aria-valuenow="@LuxCurve.Num(Settings.LuxBrightnessFullLux)"
							aria-valuetext="@($"{LuxCurve.Lux(Settings.LuxBrightnessFullLux)}, {TokenFormat.Percent(Settings.LuxBrightnessMaxPct)}")"
							@onkeydown="@(args => OnKey(Grip.Full, args))" />
				}

				@if (_shape is { } shape)
				{
					<circle class="luxc-handle luxc-shape @(_grip == Grip.Shape ? "luxc-held" : null)"
							cx="@LuxCurve.Num(shape.X)"
							cy="@LuxCurve.Num(shape.Y)"
							r="6"
							tabindex="0"
							role="slider"
							aria-label="Curve shape"
							aria-valuemin="@LuxCurve.Num(ShapeSetting.Min)"
							aria-valuemax="@LuxCurve.Num(ShapeSetting.Max ?? 5)"
							aria-valuenow="@LuxCurve.Num(Settings.LuxBrightnessGamma)"
							aria-valuetext="@CurvePath.Describe(Settings.LuxBrightnessGamma)"
							@onkeydown="@(args => OnKey(Grip.Shape, args))" />
				}
			</g>
		</svg>

		@*
			The thing a finger actually touches, laid exactly over the plot area by LuxCurve.SurfaceStyle so the
			drawing and the target can never disagree about where the plot is. It is on top of the handles on
			purpose: a tap anywhere grabs the nearest one, which is the difference between a chart that works on a
			phone and one that demands a seven-pixel hit. Tab still reaches the handles themselves.
		*@
		<div class="luxc-surface" style="@LuxCurve.SurfaceStyle()" @ref="_surface"></div>
	</div>

	<p class="luxc-caption">@Description</p>
</div>

@code {
	/// <summary>Which handle a gesture is steering.</summary>
	private enum Grip
	{
		/// <summary>Nothing is being dragged.</summary>
		None,

		/// <summary>The foot of the curve: the reading at which brightening starts.</summary>
		Start,

		/// <summary>The head: the reading for full brightness, and how bright that is.</summary>
		Full,

		/// <summary>The middle: the shaping exponent.</summary>
		Shape
	}

	/// <summary>The room's settings with its inheritance already resolved — the curve as the engine would run it.</summary>
	[Parameter, EditorRequired]
	public AreaSettings Settings { get; set; } = new();

	/// <summary>
	///     The level the curve rises from: what the period in force asks this room for.
	/// </summary>
	/// <remarks>
	///     The adjustment raises the schedule's own brightness rather than replacing it, so the foot of the line
	///     sits at whatever the period wants. Drawn against a fixed 0 % it would be a different rule's picture.
	/// </remarks>
	[Parameter]
	public double BaseBrightnessPct { get; set; } = 80;

	/// <summary>The period the base level came from, so the caption can name it. <c>null</c> when none resolves.</summary>
	[Parameter]
	public string? PeriodName { get; set; }

	/// <summary>The room's light-level reading right now, or <c>null</c> when it has no sensor that answers.</summary>
	[Parameter]
	public double? Reading { get; set; }

	/// <summary>Raised for each setting a drag or a key changes. The page decides what applying it means.</summary>
	[Parameter]
	public EventCallback<CurveEdit> Changed { get; set; }

	private ElementReference _surface;
	private DotNetObjectReference<LuxCurveChart>? _self;
	private bool _watching;

	private Grip _grip = Grip.None;

	// Rebuilt in OnParametersSet rather than read in getters: this sits on a page that redraws once a second,
	// and the backdrop is a hundred-odd string appends.
	private double _axisMax = 10_000;
	private string _backdrop = "";
	private string _path = "";
	private CurvePoint? _start;
	private CurvePoint? _full;
	private CurvePoint? _shape;

	private readonly string _viewBox = string.Create(CultureInfo.InvariantCulture,
		$"0 0 {LuxCurve.ViewWidth} {LuxCurve.ViewHeight}");

	private readonly string _plotOrigin = string.Create(CultureInfo.InvariantCulture,
		$"translate({LuxCurve.PlotLeft},{LuxCurve.PlotTop})");

	private static RoomSetting StartSetting => RoomSettings.Of(nameof(AreaSettings.LuxBrightnessStartLux));

	private static RoomSetting FullSetting => RoomSettings.Of(nameof(AreaSettings.LuxBrightnessFullLux));

	private static RoomSetting MaxSetting => RoomSettings.Of(nameof(AreaSettings.LuxBrightnessMaxPct));

	private static RoomSetting ShapeSetting => RoomSettings.Of(nameof(AreaSettings.LuxBrightnessGamma));

	/// <inheritdoc/>
	protected override void OnParametersSet() => Rebuild();

	private void Rebuild()
	{
		_axisMax = LuxCurve.AxisMaxLux(Settings, Reading);
		_path = LuxCurve.Path(Settings, BaseBrightnessPct, _axisMax);
		_start = LuxCurve.StartHandle(Settings, BaseBrightnessPct, _axisMax);
		_full = LuxCurve.FullHandle(Settings, _axisMax);
		_shape = LuxCurve.HasHeadroom(Settings, BaseBrightnessPct)
			? LuxCurve.ShapeHandle(Settings, BaseBrightnessPct, _axisMax)
			: null;

		_backdrop = Backdrop();
	}

	/// <inheritdoc/>
	/// <remarks>
	///     Attached once, and never re-attached: the surface element is stable for the life of the component, and
	///     a second <c>watch</c> on the same element is refused by the script rather than doubling every report.
	/// </remarks>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender || _watching)
			return;

		_self ??= DotNetObjectReference.Create(this);

		try
		{
			await Js.InvokeVoidAsync("adaptiveLightingCurve.watch", _surface, _self).ConfigureAwait(true);
			_watching = true;
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			// The chart is still readable and every value it sets is still reachable from the numbers under it,
			// so a missing script costs the drag and nothing else. Taking the circuit down for it would cost the
			// page — an exception out of OnAfterRenderAsync is an unhandled circuit exception.
			Logger.LogDebug(exception, "The daylight curve could not attach its pointer handler; it stays read-only.");
		}
	}

	/// <summary>Which interop failures are ordinary in a long-lived circuit — the same three <c>ThemePicker</c> survives.</summary>
	private static bool IsSurvivable(Exception exception) =>
		exception is JSDisconnectedException or JSException or OperationCanceledException;

	/// <summary>
	///     Takes hold of whichever handle the gesture started nearest.
	/// </summary>
	/// <remarks>
	///     Nearest rather than hit-tested, so the whole plot is a target: a seven-pixel circle is a fair mouse
	///     target and an unfair finger one. The grab also applies at once, so a tap moves the curve rather than
	///     waiting for a drag that a tap never produces.
	/// </remarks>
	/// <param name="x">Where the pointer went down, as a fraction across the plot.</param>
	/// <param name="y">The same, down the plot.</param>
	[JSInvokable]
	public Task Grab(double x, double y)
	{
		double pointX = LuxCurve.X(x);
		double pointY = y * LuxCurve.PlotHeight;

		_grip = Nearest(pointX, pointY);

		return Apply(x, y);
	}

	/// <summary>Moves the held handle. Ignored when nothing is held, which is a report that outran a drop.</summary>
	/// <param name="x">Where the pointer is, as a fraction across the plot.</param>
	/// <param name="y">The same, down the plot.</param>
	[JSInvokable]
	public Task Move(double x, double y) => _grip == Grip.None ? Task.CompletedTask : Apply(x, y);

	/// <summary>Lets go.</summary>
	[JSInvokable]
	public Task Drop()
	{
		_grip = Grip.None;
		StateHasChanged();

		return Task.CompletedTask;
	}

	private Grip Nearest(double x, double y)
	{
		Grip nearest = Grip.Start;
		double best = double.MaxValue;

		Consider(Grip.Start, _start);
		Consider(Grip.Full, _full);
		Consider(Grip.Shape, _shape);

		return nearest;

		void Consider(Grip grip, CurvePoint? point)
		{
			if (point is not { } candidate)
				return;

			double distance = ((candidate.X - x) * (candidate.X - x)) + ((candidate.Y - y) * (candidate.Y - y));

			if (distance >= best)
				return;

			best = distance;
			nearest = grip;
		}
	}

	/// <summary>Turns a position in the plot into the settings the held handle stands for.</summary>
	private Task Apply(double x, double y) => _grip switch
	{
		Grip.Start => SetStartLux(LuxCurve.RoundLux(LuxCurve.LuxAt(x, _axisMax))),
		Grip.Full => SetFull(LuxCurve.RoundLux(LuxCurve.LuxAt(x, _axisMax)), Math.Round((1 - Math.Clamp(y, 0, 1)) * 100)),
		Grip.Shape => SetGamma(GammaAt(y)),
		_ => Task.CompletedTask
	};

	/// <summary>
	///     The exponent that puts the curve through a point dragged to <paramref name="y"/>.
	/// </summary>
	/// <remarks>
	///     Read as a position within the headroom rather than as a brightness, because that is what the engine's
	///     shaping acts on: the same drag means a different exponent under a period asking 20 % than under one
	///     asking 70 %, and taking the brightness literally would make the handle disagree with the line it sits on.
	/// </remarks>
	private double GammaAt(double y)
	{
		double brightness = (1 - Math.Clamp(y, 0, 1)) * 100;
		double headroom = Settings.LuxBrightnessMaxPct - BaseBrightnessPct;

		if (headroom <= 0)
			return Settings.LuxBrightnessGamma;

		double gamma = LuxCurve.GammaFor(
			LuxCurve.ShapeFraction,
			(brightness - BaseBrightnessPct) / headroom,
			ShapeSetting.Min,
			ShapeSetting.Max ?? 5);

		// To the stepper's own grain, so a value reached by dragging is one the arrows can reach again.
		return Math.Round(gamma / ShapeSetting.Step, MidpointRounding.AwayFromZero) * ShapeSetting.Step;
	}

	/// <summary>
	///     Moves the foot of the curve, keeping it below the head.
	/// </summary>
	/// <remarks>
	///     The validator refuses anchors that cross, and a chart that can produce a document the validator refuses
	///     is a chart that turns a drag into a red banner. So the two anchors hold each other apart here, at the
	///     point where the number is made rather than after it has been written.
	/// </remarks>
	private Task SetStartLux(double lux)
	{
		double ceiling = Math.Max(StartSetting.Min, Settings.LuxBrightnessFullLux - 1);

		return Raise(nameof(AreaSettings.LuxBrightnessStartLux), Math.Clamp(lux, StartSetting.Min, ceiling));
	}

	/// <summary>Moves the head of the curve, which is two settings: the reading it happens at, and how bright it is.</summary>
	private async Task SetFull(double lux, double brightnessPct)
	{
		double floor = Settings.LuxBrightnessStartLux + 1;
		double bounded = Math.Clamp(lux, Math.Max(FullSetting.Min, floor), FullSetting.Max ?? LuxCurve.AxisMaxCeilingLux);

		await Raise(nameof(AreaSettings.LuxBrightnessFullLux), bounded).ConfigureAwait(true);
		await Raise(nameof(AreaSettings.LuxBrightnessMaxPct),
			Math.Clamp(brightnessPct, MaxSetting.Min, MaxSetting.Max ?? 100)).ConfigureAwait(true);
	}

	private Task SetGamma(double gamma) =>
		Raise(nameof(AreaSettings.LuxBrightnessGamma), Math.Clamp(gamma, ShapeSetting.Min, ShapeSetting.Max ?? 5));

	private Task Raise(string key, double value) => Changed.InvokeAsync(new CurveEdit(key, value));

	/// <summary>
	///     The keyboard half: the arrows move a handle by the setting's own step.
	/// </summary>
	/// <remarks>
	///     <para>
	///         Left and right move an illuminance, up and down a brightness or a shape — which is the axis each
	///         setting lives on, so the key that moves the picture is the key that moves the number. Lux steps
	///         multiply rather than add: a fixed 50 lx step needs two hundred presses to cross the top decade and
	///         cannot express the bottom one at all, and this axis is logarithmic precisely because the quantity is.
	///     </para>
	///     <para>
	///         <b>On the shaping handle, Up lowers the exponent.</b> That is backwards for an ARIA slider, whose
	///         convention is that Up increases the value — and it is deliberate: a lower exponent lifts the curve,
	///         so Up moves the handle up, which is what dragging it does. Keyboard and pointer disagreeing about
	///         direction on one handle would be the worse surprise, and it is the one a person using both would
	///         hit immediately. The cost is paid where it barely lands: a screen reader announces
	///         <c>aria-valuetext</c> in preference to <c>aria-valuenow</c>, and that text is the curve described in
	///         words, which moves the right way.
	///     </para>
	/// </remarks>
	private Task OnKey(Grip grip, KeyboardEventArgs args)
	{
		int direction = args.Key switch
		{
			"ArrowRight" or "ArrowUp" => 1,
			"ArrowLeft" or "ArrowDown" => -1,
			_ => 0
		};

		if (direction == 0)
			return Task.CompletedTask;

		bool horizontal = args.Key is "ArrowLeft" or "ArrowRight";

		return (grip, horizontal) switch
		{
			(Grip.Start, true) => SetStartLux(LuxCurve.RoundLux(Nudge(Settings.LuxBrightnessStartLux, direction))),
			(Grip.Full, true) => SetFull(LuxCurve.RoundLux(Nudge(Settings.LuxBrightnessFullLux, direction)), Settings.LuxBrightnessMaxPct),
			(Grip.Full, false) => SetFull(Settings.LuxBrightnessFullLux, Settings.LuxBrightnessMaxPct + (direction * MaxSetting.Step)),
			(Grip.Shape, false) => SetGamma(Settings.LuxBrightnessGamma - (direction * ShapeSetting.Step)),
			_ => Task.CompletedTask
		};
	}

	/// <summary>One keyboard step along a logarithmic axis: a quarter of a decade, which is about 1.8×.</summary>
	private static double Nudge(double lux, int direction) =>
		Math.Pow(10, Math.Log10(Math.Max(lux, LuxCurve.AxisMinLux)) + (direction * 0.25));

	/// <summary>
	///     Everything on the chart that is drawn rather than touched: the grid, the axes, the period's own
	///     ceiling, and the room's live reading.
	/// </summary>
	/// <remarks>
	///     Composed as a markup string rather than as Razor tags because Razor reserves <c>&lt;text&gt;</c> as a
	///     control-flow transition, so an SVG text element with attributes cannot be written inline — the same
	///     reason <c>DaylightChart</c> builds its whole picture this way. The interactive handles stay real Razor
	///     elements, since they carry event handlers and a live class.
	/// </remarks>
	private string Backdrop()
	{
		System.Text.StringBuilder svg = new();

		svg.Append(string.Create(CultureInfo.InvariantCulture,
			$"<g transform=\"translate({LuxCurve.PlotLeft},{LuxCurve.PlotTop})\">"));

		svg.Append(string.Create(CultureInfo.InvariantCulture,
			$"<rect x=\"0\" y=\"0\" width=\"{LuxCurve.PlotWidth}\" height=\"{LuxCurve.PlotHeight}\" class=\"luxc-field\" />"));

		// Brightness gridlines every 25 %, labelled at the quarters a person reads off: 0, 50, 100.
		foreach (int percent in new[] { 0, 25, 50, 75, 100 })
		{
			string y = LuxCurve.Num(LuxCurve.Y(percent));

			svg.Append($"<line x1=\"0\" y1=\"{y}\" x2=\"{LuxCurve.Num(LuxCurve.PlotWidth)}\" y2=\"{y}\" class=\"luxc-grid\" />");

			if (percent % 50 == 0)
				svg.Append($"<text x=\"-8\" y=\"{LuxCurve.Num(LuxCurve.Y(percent) + 4)}\" text-anchor=\"end\" class=\"luxc-axis\">{percent} %</text>");
		}

		// Decade gridlines. Labelled in the words a person uses for the light, not only as a number: the whole
		// point of the log axis is that each decade is a different kind of day.
		IReadOnlyList<double> decades = LuxCurve.Decades(_axisMax);

		for (int index = 0; index < decades.Count; index++)
		{
			double lux = decades[index];
			string x = LuxCurve.Num(LuxCurve.X(LuxCurve.FractionOf(lux, _axisMax)));

			// The end labels are anchored inward rather than centred on their line. Centred, the first and last
			// hang half their width outside the viewBox — which paints, but overlaps the card's own padding, and
			// is simply cut off in any screenshot of the chart alone.
			string anchor = index == 0 ? "start" : index == decades.Count - 1 ? "end" : "middle";

			// Every decade keeps its gridline, but a narrow card cannot label all six: measured at 390 px,
			// "10000 lx" and "100000 lx" ran together into one unreadable word. Alternate labels are marked so
			// the stylesheet can drop them there — it has to be CSS, because this SVG is built on the server
			// against a fixed viewBox and knows nothing about the viewport it will land in.
			//
			// Counted from the RIGHT so the top decade always survives: it is the one that says how far the
			// axis reaches, and losing it leaves the curve looking like it stopped somewhere else.
			string thin = (decades.Count - 1 - index) % 2 == 1 ? " luxc-thin" : string.Empty;

			svg.Append($"<line x1=\"{x}\" y1=\"0\" x2=\"{x}\" y2=\"{LuxCurve.Num(LuxCurve.PlotHeight)}\" class=\"luxc-grid\" />");
			svg.Append($"<text x=\"{x}\" y=\"{LuxCurve.Num(LuxCurve.PlotHeight + 16)}\" text-anchor=\"{anchor}\" class=\"luxc-axis{thin}\">{Escape(LuxCurve.Lux(lux))}</text>");

			if (DecadeWord(lux) is { Length: > 0 } word)
				svg.Append($"<text x=\"{x}\" y=\"{LuxCurve.Num(LuxCurve.PlotHeight + 29)}\" text-anchor=\"{anchor}\" class=\"luxc-decade{thin}\">{Escape(word)}</text>");
		}

		// The house's own number, standing on the curve. A curve read in the abstract is a shape; a curve with
		// "170 lx now" on it is a decision about this room.
		if (Reading is { } reading)
		{
			double x = LuxCurve.X(LuxCurve.FractionOf(reading, _axisMax));
			double y = LuxCurve.Y(LuxBrightnessCurve.Raise(BaseBrightnessPct, reading, Settings));

			svg.Append($"<line x1=\"{LuxCurve.Num(x)}\" y1=\"0\" x2=\"{LuxCurve.Num(x)}\" y2=\"{LuxCurve.Num(LuxCurve.PlotHeight)}\" class=\"luxc-now\" />");
			svg.Append($"<circle cx=\"{LuxCurve.Num(x)}\" cy=\"{LuxCurve.Num(y)}\" r=\"3.5\" class=\"luxc-now-dot\" />");

			// Nudged inside the plot at both ends, so a reading at 1 lx or on a bright day keeps its label on the chart.
			double labelX = Math.Clamp(x, 4, LuxCurve.PlotWidth - 4);
			string anchor = x > LuxCurve.PlotWidth - 80 ? "end" : x < 80 ? "start" : "middle";

			svg.Append($"<text x=\"{LuxCurve.Num(labelX)}\" y=\"-3\" text-anchor=\"{anchor}\" class=\"luxc-now-label\">{Escape($"{LuxCurve.Lux(reading)} now")}</text>");
		}

		svg.Append("</g>");

		return svg.ToString();
	}

	/// <summary>What a decade of illuminance is, in a word — the axis's real labels.</summary>
	private static string DecadeWord(double lux) => lux switch
	{
		1 => "night",
		100 => "dull room",
		1_000 => "overcast",
		10_000 => "bright day",
		_ => ""
	};

	/// <summary>
	///     The chart in words: the accessible name, the caption under it, and what a screen reader is told.
	/// </summary>
	/// <remarks>
	///     One string for all three, because they are one statement. A chart whose alternative text says something
	///     the caption does not is two claims about one picture.
	/// </remarks>
	private string Description
	{
		get
		{
			string from = PeriodName is { Length: > 0 } period
				? $"From {period}'s {TokenFormat.Percent(BaseBrightnessPct)}"
				: $"From {TokenFormat.Percent(BaseBrightnessPct)}";

			string line =
				$"{from}, this room climbs to {TokenFormat.Percent(Settings.LuxBrightnessMaxPct)} as the light outside "
				+ $"goes from {LuxCurve.Lux(Settings.LuxBrightnessStartLux)} to {LuxCurve.Lux(Settings.LuxBrightnessFullLux)} — "
				+ $"{CurvePath.Describe(Settings.LuxBrightnessGamma)}.";

			if (Reading is { } reading)
			{
				double raised = LuxBrightnessCurve.Raise(BaseBrightnessPct, reading, Settings);
				line += $" It reads {LuxCurve.Lux(reading)} right now, which asks for {TokenFormat.Percent(Math.Round(raised))}.";
			}
			else
			{
				line += " This room has no light-level sensor, so nothing lifts it.";
			}

			return line;
		}
	}

	private static string Escape(string text) =>
		text.Replace("&", "&amp;", StringComparison.Ordinal)
			.Replace("<", "&lt;", StringComparison.Ordinal)
			.Replace(">", "&gt;", StringComparison.Ordinal);

	/// <inheritdoc/>
	/// <remarks>
	///     The listeners are released before the .NET reference they call into is, so a pointer already down when
	///     the page is left cannot invoke a disposed component. A circuit that has already gone takes the
	///     listeners with it, which is why a failure here is logged rather than thrown.
	/// </remarks>
	public async ValueTask DisposeAsync()
	{
		if (_watching)
		{
			try
			{
				await Js.InvokeVoidAsync("adaptiveLightingCurve.release", _surface).ConfigureAwait(false);
			}
			catch (Exception exception) when (IsSurvivable(exception))
			{
				Logger.LogDebug(exception, "The daylight curve could not release its pointer handler.");
			}
		}

		_self?.Dispose();
	}
}
