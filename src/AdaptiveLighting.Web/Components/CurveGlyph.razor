@*
	A response curve, small enough to sit inside a sentence.

	For the settings that are a shape rather than a quantity — a shaping exponent, a blend, a ramp. The number
	stays in its token, where it can be changed; this sits beside it and says what the number means, which is
	something no wording of the sentence manages in fewer than three clauses.

	Drawn in the page's own stroke grammar rather than as a chart: a 2px accent line on a hairline baseline,
	the same two weights the board's now-line and its gridlines use. It is a mark, not a graph — no axes, no
	ticks, nothing to read off it.
*@

<svg class="curve-glyph @Class"
	 viewBox="0 0 40 20"
	 fill="none"
	 role="@(Label is { Length: > 0 } ? "img" : null)"
	 aria-label="@(Label is { Length: > 0 } ? Label : null)"
	 aria-hidden="@(Label is { Length: > 0 } ? null : "true")"
	 focusable="false">
	<line x1="0" y1="19.5" x2="40" y2="19.5" stroke="var(--grid)" stroke-width="1" />
	<line x1="0.5" y1="0" x2="0.5" y2="20" stroke="var(--grid)" stroke-width="1" />
	<path d="@CurvePath.Power(Exponent)" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>

@code {
	/// <summary>The shape. 1 is a straight rise; above 1 holds back and then climbs; below 1 lifts early.</summary>
	[Parameter, EditorRequired]
	public double Exponent { get; set; } = 1;

	/// <summary>What the curve means, for a screen reader. <c>CurvePath.Describe</c> words it if you have nothing better.</summary>
	[Parameter]
	public string? Label { get; set; }

	/// <summary>Extra classes, for a caller that wants it larger than the inline default.</summary>
	[Parameter]
	public string? Class { get; set; }
}
