@*
	The commissioning board's header: five counts, plus a chip when a house-mode select was adopted.

	The counts are the resolver's own, after the include label, the group preference and the ghost filter, so
	the strip reports what the engine will run, not what Home Assistant holds.
*@

<div class="comm-strip" role="list" aria-label="What setting up found">
	@foreach ((int Count, string Word) fact in Facts)
	{
		<div class="comm-fact" role="listitem">
			<div class="n">@fact.Count</div>
			<div class="w">@fact.Word</div>
		</div>
	}

	@* Absent, not zeroed, for a house with no select: a house without one is not missing anything. *@
	@if (HouseMode is { Length: > 0 } mode)
	{
		<div class="comm-fact mode" role="listitem">
			<Icon Name="@Glyph.Modes" />
			<div>
				<div class="n">@mode</div>
				<div class="w">house mode · adopted</div>
			</div>
		</div>
	}
</div>

@code {
	/// <summary>How many rooms discovery proposed.</summary>
	[Parameter]
	public int Rooms { get; set; }

	/// <summary>How many lights those rooms would command between them.</summary>
	[Parameter]
	public int Lights { get; set; }

	/// <summary>How many motion sensors they resolve.</summary>
	[Parameter]
	public int Motion { get; set; }

	/// <summary>How many illuminance sensors they resolve.</summary>
	[Parameter]
	public int LightLevel { get; set; }

	/// <summary>How many people decide Home and Away.</summary>
	[Parameter]
	public int People { get; set; }

	/// <summary>The adopted select's friendly name, not its entity id. <c>null</c> when this house has none.</summary>
	[Parameter]
	public string? HouseMode { get; set; }

	/// <summary>The five counted facts, in reading order, each with the word that agrees with its number.</summary>
	private IReadOnlyList<(int Count, string Word)> Facts =>
	[
		(Rooms, Rooms == 1 ? "room" : "rooms"),
		(Lights, Lights == 1 ? "light" : "lights"),
		(Motion, "motion"),
		(LightLevel, "light-level"),
		(People, People == 1 ? "person" : "people")
	];
}
