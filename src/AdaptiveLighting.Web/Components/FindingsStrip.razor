@*
	Orientation in five numbers, and a sixth chip when the helper adopted a house-mode select.

	It is the commissioning board's header rather than one of its steps: it asks nothing. The counts are the
	resolver's own — after the include label, the group preference and the ghost filter — which is what makes
	the strip a report of what the engine will actually run rather than an advertisement for what Home Assistant
	holds.

	Glyphless on purpose. ui-design-c §6.2 refused icons on report rows and kept them for sections; the one
	glyph here marks the one chip that is a fact rather than a count, so it reads as a different kind of thing
	instead of as the first of six decorations.
*@

<div class="comm-strip" role="list" aria-label="What setting up found">
	<div class="comm-fact" role="listitem">
		<div class="n">@Rooms</div>
		<div class="w">@(Rooms == 1 ? "room" : "rooms")</div>
	</div>
	<div class="comm-fact" role="listitem">
		<div class="n">@Lights</div>
		<div class="w">@(Lights == 1 ? "light" : "lights")</div>
	</div>
	<div class="comm-fact" role="listitem">
		<div class="n">@Motion</div>
		<div class="w">motion</div>
	</div>
	<div class="comm-fact" role="listitem">
		<div class="n">@LightLevel</div>
		<div class="w">light-level</div>
	</div>
	<div class="comm-fact" role="listitem">
		<div class="n">@People</div>
		<div class="w">@(People == 1 ? "person" : "people")</div>
	</div>

	@* Absent, not zeroed, for a house with no select. A chip reading "— house mode" would invent a missing
	   thing out of a house that simply has none, which is the cabin this board has to pass through cleanly. *@
	@if (HouseMode is { Length: > 0 } mode)
	{
		<div class="comm-fact mode" role="listitem">
			<Icon Name="@Glyph.Modes" />
			<div>
				<div class="n">@mode</div>
				<div class="w">house mode · adopted</div>
			</div>
		</div>
	}
</div>

@code {
	/// <summary>How many rooms discovery proposed.</summary>
	[Parameter]
	public int Rooms { get; set; }

	/// <summary>How many lights those rooms would command between them.</summary>
	[Parameter]
	public int Lights { get; set; }

	/// <summary>How many motion sensors they resolve.</summary>
	[Parameter]
	public int Motion { get; set; }

	/// <summary>How many illuminance sensors they resolve.</summary>
	[Parameter]
	public int LightLevel { get; set; }

	/// <summary>How many people decide Home and Away.</summary>
	[Parameter]
	public int People { get; set; }

	/// <summary>
	///     The adopted house-mode select's name, or <c>null</c> when this house has none.
	/// </summary>
	/// <remarks>
	///     The select's <i>friendly name</i>, not its entity id: the strip is read by somebody who has never seen
	///     an entity id and does not need to start now.
	/// </remarks>
	[Parameter]
	public string? HouseMode { get; set; }
}
