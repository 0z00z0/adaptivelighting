@*
	A collapsible group of settings: a header that says what the section is for, a fold that keeps a long
	page skimmable. The same <details> pattern as the area folds, so the page opens and closes one way.

	Collapsed by default, like the area, period and house-mode folds: a settings page reads as a short list of
	named groups you open the one you came for, not a wall of every knob at once. The open attribute is decided
	once, so Blazor's diff never overrides a fold a human toggled.
*@

<details class="panel group-fold" open="@_openInitially">
	<summary class="group-summary">
		<span class="group-title">@Title</span>
		@if (Description is { Length: > 0 })
		{
			<span class="group-desc">@Description</span>
		}
		<span class="area-chevron" aria-hidden="true"></span>
	</summary>

	<div class="group-body @(Flush ? "group-body-flush" : null)">
		@ChildContent
	</div>
</details>

@code {
	/// <summary>The group's name.</summary>
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	/// <summary>One line on what lives in the group, shown in the header so a skim reads it without opening.</summary>
	[Parameter]
	public string? Description { get; set; }

	/// <summary>Whether the fold starts open. Defaults to collapsed; read once.</summary>
	[Parameter]
	public bool Open { get; set; }

	/// <summary>
	///     Drops the body's own padding, for content that already spans the fold edge to edge — a bar with its
	///     own background, a block with a rule across it. Without this the content would be inset twice and the
	///     bar would stop short of the fold's border, which reads as a mistake rather than as a nested box.
	/// </summary>
	[Parameter]
	public bool Flush { get; set; }

	/// <summary>The fields inside.</summary>
	[Parameter, EditorRequired]
	public RenderFragment? ChildContent { get; set; }

	private bool _openInitially;

	/// <inheritdoc/>
	protected override void OnInitialized() => _openInitially = Open;
}
