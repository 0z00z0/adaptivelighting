@*
	One area.

	The shape of this component is an argument about what an area is. An area is, in the common case, a
	Home Assistant area id and nothing else — discovery finds the lights, the motion sensors and the lux sensor from the registry,
	and it keeps finding them after somebody renames a bulb. So the area picker is at the top, the discovery
	preview sits directly under it showing what that choice actually resolves to right now, and everything
	that overrides discovery is folded away behind "the area is wrong" — because reaching for it is a
	statement that Home Assistant's own area assignments are not to be trusted for this room, and that
	should feel like a decision rather than the default path.

	The preview is the real AreaEntityResolver, not a lookalike. What it says is what the engine will do.

	The whole area is a fold. Collapsed, it is a header — the switch, the name, the area id, and how far it
	strays from the all-rooms settings — because a settings page with six areas is read far more often than it
	is edited, and the reading case wants six lines, not six panels. An area with no area id yet starts open: it
	is not configured, and a fold that hides the one thing demanding attention would be tidiness at the expense
	of the task.

	The left edge carries the room's live state in the dashboard's own colour family, and flat grey when the
	room is switched off — so the two pages describe one house in one language rather than two.
*@

<details class="panel area-fold @EdgeClass" open="@_openInitially">
	@*
		The area's header is a header — a name to read, not a text box to squint at. The name is edited in
		the Name field inside; the summary just says who this is and how far it strays from the all-rooms
		settings, which is what you want a collapsed list of six areas to answer at a glance.

		The switch lives here, not four clicks down inside the override list, because turning a room off is the
		commonest decision after set-up. It stops the click reaching the fold: a thumb aiming at the switch must
		not also open the editor.
	*@
	<summary class="area-summary">
		<button type="button"
				class="switch @(IsEnabled ? "on" : null)"
				role="switch"
				aria-checked="@(IsEnabled ? "true" : "false")"
				aria-label="@($"Automatic lighting in {DisplayName}")"
				title="@ToggleTitle"
				@onclick="ToggleEnabled"
				@onclick:stopPropagation="true"
				@onclick:preventDefault="true">
			<span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
			<span class="switch-word">@(IsEnabled ? "on" : "off")</span>
		</button>
		<span class="area-title">@DisplayName</span>
		@if (Area.AreaId is { Length: > 0 } areaId)
		{
			<code class="area-slug">@areaId</code>
		}
		else
		{
			<span class="badge bad">no area</span>
		}
		<span class="area-summary-hint">@SummaryHint</span>
		<span class="area-chevron" aria-hidden="true"></span>
	</summary>

	<div class="field">
		<div class="field-head"><label class="field-label">Name</label></div>
		<div class="field-control">
			<input type="text" class="cell wide" @bind="Area.Name" @bind:event="oninput" placeholder="@(Area.AreaId ?? "Area name")" />
		</div>
		<div class="field-help">The room's name on the dashboard. Follows the area's name until you type one.</div>
	</div>

	<div class="field">
		<div class="field-head"><label class="field-label">Area</label></div>
		<div class="field-control">
			<AreaPicker Value="@Area.AreaId" ValueChanged="@OnAreaChanged" Areas="@Areas" />
		</div>
		<div class="field-help">
			Pick the room. That's normally all an area needs — lights and sensors are found automatically.
		</div>
	</div>

	@* ------------------------------------------------------------------------------------------------
	   The discovery preview. This is the thing that makes the area picker trustworthy: choose an area and
	   see the actual lights, sensors and lux source the engine will drive, before saving anything.
	   ------------------------------------------------------------------------------------------------ *@
	<div class="preview @(Preview.Resolved is null ? "preview-bad" : "preview-ok")">
		<div class="preview-head">What was found in this room</div>

		@if (Preview.Resolved is { } resolved)
		{
			<table>
				<tbody>
					<tr>
						<th>Lights</th>
						<td>
							<ul class="chips chips-plain">
								@foreach (string light in resolved.Lights)
								{
									<li class="chip">
										<span class="chip-name">@Name(light)</span><code class="chip-id">@light</code>
										<button type="button" class="chip-remove" title="Exclude this light from the room" @onclick="() => ExcludeEntity(light)">&times;</button>
									</li>
								}
							</ul>
						</td>
					</tr>
					<tr>
						<th>Motion</th>
						<td>
							<ul class="chips chips-plain">
								@foreach (string sensor in resolved.MotionSensors)
								{
									<li class="chip">
										<span class="chip-name">@Name(sensor)</span><code class="chip-id">@sensor</code>
										<button type="button" class="chip-remove" title="Exclude this sensor from the room" @onclick="() => ExcludeEntity(sensor)">&times;</button>
									</li>
								}
							</ul>
						</td>
					</tr>
					<tr>
						<th>Lux</th>
						<td>
							@if (resolved.LuxSensor is { Length: > 0 } lux)
							{
								<span class="chip-name">@Name(lux)</span> <code class="chip-id">@lux</code>
							}
							else
							{
								<span class="inherit">none — darkness is judged by the sun instead</span>
							}
						</td>
					</tr>
				</tbody>
			</table>
		}
		else
		{
			<div class="preview-error">@Preview.Error</div>
		}
	</div>

	<details class="advanced" open="@HasExplicitEntities">
		<summary>Pick lights and sensors by hand</summary>

		<p class="lede">
			Each list you fill in here <strong>replaces</strong> the automatic choice for that list only. Use it when
			Home Assistant's room assignments don't match reality — a hallway sensor that watches the living room, a
			lamp assigned to the wrong room. Fixing the room in Home Assistant is usually better.
		</p>

		@* ------------------------------------------------------------------------------------------------
		   The lists below offer this area's entities, because a living-room light picker that offered every
		   light in the house was offering an ESP dev board's status LED and a browser_mod screen as candidate
		   living-room lights, and burying the three real answers somewhere in the middle.

		   But it is a default, not a wall. This whole block exists for the case where HA's area assignment is
		   the thing that is wrong — a sensor in the hallway that watches this room is not in this area and
		   never will be — so widening the lists has to stay one click away. Anything already configured stays
		   listed and selected either way: a filter must never be the reason a stored value disappears.
		   ------------------------------------------------------------------------------------------------ *@
		@if (Area.AreaId is { Length: > 0 })
		{
			<div class="field">
				<div class="field-control checks">
					<label>
						<input type="checkbox" @bind:get="_showAllEntities" @bind:set="OnShowAllChanged" />
						show entities from other rooms too
					</label>
				</div>
				<div class="field-help">
					@if (_showAllEntities)
					{
						<text>Showing everything in the house.</text>
					}
					else
					{
						<text>
							Showing what's in this room. Anything already chosen stays listed even if it's elsewhere.
						</text>
					}
				</div>
			</div>
		}

		<div class="field">
			<div class="field-head"><label class="field-label">Lights</label></div>
			<div class="field-control">
				<EntityListPicker Value="@(Area.Lights ?? [])"
								  ValueChanged="@(value => SetList(value, list => Area.Lights = list))"
								  Options="@_lightOptions"
								  NameResolver="@Name"
								  KnownResolver="@Catalog.Knows"
								  EmptyLabel="Discovered from the area."
								  AddLabel="Add a light…"
								  EmptyNote="@EmptyNote("lights")"
								  Placeholder="light.example" />
			</div>
		</div>

		<div class="field">
			<div class="field-head"><label class="field-label">Motion sensors</label></div>
			<div class="field-control">
				<EntityListPicker Value="@(Area.MotionSensors ?? [])"
								  ValueChanged="@(value => SetList(value, list => Area.MotionSensors = list))"
								  Options="@_motionOptions"
								  NameResolver="@Name"
								  KnownResolver="@Catalog.Knows"
								  EmptyLabel="Discovered from the area."
								  AddLabel="Add a motion sensor…"
								  EmptyNote="@EmptyNote("motion sensors")"
								  Placeholder="binary_sensor.example" />
			</div>
			<div class="field-help">
				Sensors that report motion, occupancy or presence. A sensor with an odd type can be given the motion
				label in Home Assistant instead.
			</div>
		</div>

		<div class="field">
			<div class="field-head"><label class="field-label">Lux sensor</label></div>
			<div class="field-control">
				<EntityPicker Value="@Area.LuxSensor"
							  ValueChanged="@(value => Set(() => Area.LuxSensor = value))"
							  Options="@_luxOptions"
							  NoneLabel="(discovered from the area)"
							  EmptyNote="@EmptyNote("illuminance sensors")"
							  Placeholder="sensor.example_illuminance" />
			</div>
			<div class="field-help">
				Only needed when the room has more than one light-level sensor.
			</div>
		</div>

		<div class="field">
			<div class="field-head"><label class="field-label">Blocked while on</label></div>
			<div class="field-control">
				<EntityListPicker Value="@(Area.IgnoreWhenOn ?? [])"
								  ValueChanged="@(value => SetList(value, list => Area.IgnoreWhenOn = list))"
								  Options="@Blockers"
								  NameResolver="@Name"
								  KnownResolver="@Catalog.Knows"
								  EmptyLabel="Nothing blocks this area."
								  AddLabel="Add a blocker…"
								  Placeholder="binary_sensor.projector_is_on" />
			</div>
			<div class="field-help">
				While any of these is on, the lights won't turn on by themselves. A projector, a "do not disturb" switch.
			</div>
		</div>
	</details>

	<details class="advanced" open="@HasOverrides">
		<summary>Room-specific settings (@OverrideCount of @AreaView.OverridableSettingCount changed)</summary>

		<OverrideField Label="Lights stay on for"
					   IsOverridden="@(Area.VacancyTimeoutSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.VacancyTimeoutSeconds = on ? Defaults.VacancyTimeoutSeconds : null))"
					   InheritedText="@($"{Defaults.VacancyTimeoutSeconds} s")"
					   Help="After the last movement, how long the lights stay on before the warning dim.">
			<input class="cell num" type="number" min="1" @bind="AreaVacancyTimeout" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Warning dim lasts"
					   IsOverridden="@(Area.PreOffSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.PreOffSeconds = on ? Defaults.PreOffSeconds : null))"
					   InheritedText="@($"{Defaults.PreOffSeconds} s")"
					   Help="The grace in which movement still brings the lights back. Must be shorter than the time the lights stay on.">
			<input class="cell num" type="number" min="0" @bind="AreaPreOff" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Warning dim level"
					   IsOverridden="@(Area.PreOffBrightnessFactor is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.PreOffBrightnessFactor = on ? Defaults.PreOffBrightnessFactor : null))"
					   InheritedText="@($"{Defaults.PreOffBrightnessFactor:0.##} of target")"
					   Help="How deep the warning dim is. 0.5 means half the current brightness.">
			<input class="cell num" type="number" step="0.05" min="0" max="1" @bind="AreaPreOffFactor" />
		</OverrideField>

		<OverrideField Label="Hand changes hold for"
					   IsOverridden="@(Area.OverrideDurationMinutes is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.OverrideDurationMinutes = on ? Defaults.OverrideDurationMinutes : null))"
					   InheritedText="@($"{Defaults.OverrideDurationMinutes} min")"
					   Help="When someone adjusts a light by hand, their choice is left alone for this long.">
			<input class="cell num" type="number" min="0" @bind="AreaOverrideDuration" /> <span class="unit">min</span>
		</OverrideField>

		<OverrideField Label="After a manual off, wait"
					   IsOverridden="@(Area.VacancyResetMinutes is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.VacancyResetMinutes = on ? Defaults.VacancyResetMinutes : null))"
					   InheritedText="@($"{Defaults.VacancyResetMinutes} min")"
					   Help="After someone turns the lights off by hand, movement won't turn them back on until the room has been empty this long.">
			<input class="cell num" type="number" min="0" @bind="AreaVacancyReset" /> <span class="unit">min</span>
		</OverrideField>

		<OverrideField Label="How a room decides it's dark"
					   IsOverridden="@(Area.Darkness is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.Darkness = on ? Defaults.Darkness : null))"
					   InheritedText="@Defaults.Darkness.ToString()"
					   Help="Which signal decides the area is dark enough to light.">
			<select class="cell" @bind:get="_darkness" @bind:set="OnDarknessChanged">
				<option value="@nameof(DarknessSource.Lux)">Lux sensor (falls back to the sun if there is none)</option>
				<option value="@nameof(DarknessSource.Sun)">Sun height</option>
				<option value="@nameof(DarknessSource.Either)">Either — dark when either says so</option>
				<option value="@nameof(DarknessSource.Always)">Always — no daylight check (windowless rooms)</option>
			</select>
		</OverrideField>

		<OverrideField Label="Dark below"
					   IsOverridden="@(Area.LuxThreshold is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.LuxThreshold = on ? Defaults.LuxThreshold : null))"
					   InheritedText="@($"{Defaults.LuxThreshold} lx")"
					   Help="At or below this many lux the room counts as dark.">
			<input class="cell num" type="number" min="0" @bind="AreaLuxThreshold" /> <span class="unit">lx</span>
		</OverrideField>

		<OverrideField Label="Bright again above"
					   IsOverridden="@(Area.LuxHysteresis is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.LuxHysteresis = on ? Defaults.LuxHysteresis : null))"
					   InheritedText="@($"{Defaults.LuxHysteresis} lx")"
					   Help="The extra light needed to count as bright again (hysteresis), so a sensor sitting on the threshold cannot flap.">
			<input class="cell num" type="number" min="0" @bind="AreaLuxHysteresis" /> <span class="unit">lx</span>
		</OverrideField>

		<OverrideField Label="Dark when the sun is below"
					   IsOverridden="@(Area.SunElevationThreshold is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.SunElevationThreshold = on ? Defaults.SunElevationThreshold : null))"
					   InheritedText="@($"{Defaults.SunElevationThreshold}°")"
					   Help="Sun elevation below which the area counts as dark.">
			<input class="cell num" type="number" step="0.5" min="-90" max="90" @bind="AreaSunElevation" /> <span class="unit">°</span>
		</OverrideField>

		<OverrideField Label="Sun entity"
					   IsOverridden="@(Area.SunEntity is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.SunEntity = on ? Defaults.SunEntity : null))"
					   InheritedText="@Defaults.SunEntity">
			<EntityPicker Value="@Area.SunEntity"
						  ValueChanged="@(value => Set(() => Area.SunEntity = value))"
						  Options="@SunEntities"
						  NoneLabel="(none)"
						  Placeholder="sun.sun" />
		</OverrideField>

		<OverrideField Label="Day fade"
					   IsOverridden="@(Area.DayTransitionSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.DayTransitionSeconds = on ? Defaults.DayTransitionSeconds : null))"
					   InheritedText="@($"{Defaults.DayTransitionSeconds} s")"
					   Help="Fade length used while the area is not dark.">
			<input class="cell num" type="number" step="0.5" min="0" @bind="AreaDayFade" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Night fade"
					   IsOverridden="@(Area.NightTransitionSeconds is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.NightTransitionSeconds = on ? Defaults.NightTransitionSeconds : null))"
					   InheritedText="@($"{Defaults.NightTransitionSeconds} s")"
					   Help="Gentler, because eyes are dark-adapted.">
			<input class="cell num" type="number" step="0.5" min="0" @bind="AreaNightFade" /> <span class="unit">s</span>
		</OverrideField>

		<OverrideField Label="Respects sleep mode"
					   IsOverridden="@(Area.RespectSleepMode is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.RespectSleepMode = on ? Defaults.RespectSleepMode : null))"
					   InheritedText="@YesNo(Defaults.RespectSleepMode)"
					   Help="Clamps to the sleep period's caps while the house is asleep, whatever the clock says.">
			<select class="cell" @bind:get="_respectSleep" @bind:set="OnRespectSleepChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>

		<OverrideField Label="Sleep blocks auto-on"
					   IsOverridden="@(Area.SleepBlocksAutoOn is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.SleepBlocksAutoOn = on ? Defaults.SleepBlocksAutoOn : null))"
					   InheritedText="@YesNo(Defaults.SleepBlocksAutoOn)"
					   Help="Refuses to auto-on at all while sleep mode is on.">
			<select class="cell" @bind:get="_sleepBlocks" @bind:set="OnSleepBlocksChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>

		<OverrideField Label="Stays on when everyone leaves"
					   IsOverridden="@(Area.SkipAwaySweep is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.SkipAwaySweep = on ? Defaults.SkipAwaySweep : null))"
					   InheritedText="@YesNo(Defaults.SkipAwaySweep)"
					   Help="Porch and security lights are wanted precisely when nobody's home.">
			<select class="cell" @bind:get="_skipAway" @bind:set="OnSkipAwayChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>

		<OverrideField Label="Welcome home"
					   IsOverridden="@(Area.WelcomeHome is not null)"
					   IsOverriddenChanged="@(on => Set(() => Area.WelcomeHome = on ? Defaults.WelcomeHome : null))"
					   InheritedText="@YesNo(Defaults.WelcomeHome)"
					   Help="Lights up on first arrival when it is dark.">
			<select class="cell" @bind:get="_welcomeHome" @bind:set="OnWelcomeHomeChanged">
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</OverrideField>
	</details>

	@* At the bottom, deliberately: destroying an area should take a scroll past everything it is, not sit
	   one stray tap from its own header. Setting the room up again is destructive too — it throws away
	   everything above it — so it keeps the same company and the same warning-before-the-click rule. *@
	<div class="area-actions">
		@if (Area.AreaId is { Length: > 0 })
		{
			<button type="button" @onclick="SetUpAgain">Set this room up again</button>
		}
		<button type="button" class="danger" @onclick="Remove">Remove this room</button>
	</div>
</details>

@code {
	/// <summary>The area being edited, in place.</summary>
	[Parameter, EditorRequired]
	public AreaConfig Area { get; set; } = new();

	/// <summary>The document's defaults, for showing what each unset knob inherits.</summary>
	[Parameter, EditorRequired]
	public AreaSettings Defaults { get; set; } = new();

	/// <summary>The document's globals, which supply the discovery conventions the preview uses.</summary>
	[Parameter, EditorRequired]
	public GlobalConfig Global { get; set; } = new();

	/// <summary>The registry, for the pickers and the preview.</summary>
	[Parameter, EditorRequired]
	public HaCatalog Catalog { get; set; } = default!;

	/// <summary>Every area, hoisted to the page so one registry read serves every area.</summary>
	[Parameter]
	public IReadOnlyList<AreaOption> Areas { get; set; } = [];

	/// <summary>Every light in the house, for when the operator widens the pickers past the ones in this room.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> Lights { get; set; } = [];

	/// <summary>Every binary sensor in the house discovery would accept as motion.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> MotionSensors { get; set; } = [];

	/// <summary>Every illuminance sensor in the house.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> LuxSensors { get; set; } = [];

	/// <summary>Everything that can act as an auto-on blocker.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> Blockers { get; set; } = [];

	/// <summary>Every sun entity.</summary>
	[Parameter]
	public IReadOnlyList<EntityOption> SunEntities { get; set; } = [];

	/// <summary>Raised when the area changes, so the page can re-validate and re-preview.</summary>
	[Parameter]
	public EventCallback Changed { get; set; }

	/// <summary>Raised when the operator removes this area.</summary>
	[Parameter]
	public EventCallback Removed { get; set; }

	/// <summary>Raised when the operator asks for this one room to be set up again. The page runs the flow.</summary>
	[Parameter]
	public EventCallback SetUpAgainRequested { get; set; }

	/// <summary>
	///     What this room is doing right now, from the snapshot cache, or <c>null</c> when nothing has been heard.
	/// </summary>
	/// <remarks>
	///     Passed in rather than read here: one page-level lookup serves every room, and a component that reached
	///     for the cache itself would re-read it once per render per room for a purely decorative edge.
	/// </remarks>
	[Parameter]
	public AreaState? LiveState { get; set; }

	private AreaPreview Preview { get; set; } = new(null, null);

	/// <summary>
	///     Whether the fold starts open. Decided once: an area with no area id is unconfigured and demands
	///     attention, so it opens; a configured area starts folded to a header. After that the fold belongs
	///     to the operator — this renders the same value every time, so Blazor's diff never overrides a
	///     toggle a human made.
	/// </summary>
	private bool _openInitially;

	/// <summary>The header's name: whatever the dashboard would call this area.</summary>
	private string DisplayName =>
		Area.Name is { Length: > 0 } name ? name
		: Area.AreaId is { Length: > 0 } areaId ? areaId
		: "New area";

	/// <summary>Whether the engine may command this room, following the document's inheritance.</summary>
	private bool IsEnabled => AreaView.IsEnabled(Area, Defaults);

	/// <summary>The live-state edge colour, or flat grey while the room is switched off.</summary>
	private string EdgeClass => AreaView.EdgeClass(IsEnabled, LiveState);

	private string ToggleTitle => IsEnabled
		? "On — the lights in this room are managed. Switch off to leave them alone."
		: "Off — this room is watched but its lights are never changed.";

	/// <summary>
	///     One collapsed line on how far this area strays from the defaults — the question a folded list of
	///     areas should answer without being opened.
	/// </summary>
	/// <remarks>
	///     The explicit-entities case states what is pinned and counts it — "2 lights, 1 motion sensor set
	///     explicitly" — rather than the old "hand-picked entities", which implied the operator picked them by
	///     hand. Often nobody did: the lists may have been written by an import or an earlier tool, and a
	///     summary line is there to report the document, not to attribute intent.
	/// </remarks>
	private string SummaryHint
	{
		get
		{
			int overrides = OverrideCount;

			return (overrides, HasExplicitEntities) switch
			{
				(0, false) => "all automatic",
				(0, true) => $"{PinnedSummary} picked by hand",
				(_, false) => $"{overrides} of {AreaView.OverridableSettingCount} changed",
				_ => $"{PinnedSummary} picked by hand · {overrides} of {AreaView.OverridableSettingCount} changed"
			};
		}
	}

	/// <summary>Counts what the area lists instead of discovering: "2 lights, 1 motion sensor, lux sensor".</summary>
	private string PinnedSummary
	{
		get
		{
			List<string> parts = new List<string>(4);

			if (Area.Lights is { Count: > 0 } lights)
				parts.Add($"{lights.Count} light{(lights.Count == 1 ? "" : "s")}");

			if (Area.MotionSensors is { Count: > 0 } motion)
				parts.Add($"{motion.Count} motion sensor{(motion.Count == 1 ? "" : "s")}");

			if (Area.LuxSensor is { Length: > 0 })
				parts.Add("lux sensor");

			if (Area.IgnoreWhenOn is { Count: > 0 } blockers)
				parts.Add($"{blockers.Count} blocker{(blockers.Count == 1 ? "" : "s")}");

			return string.Join(", ", parts);
		}
	}

	/// <inheritdoc/>
	protected override void OnInitialized() => _openInitially = Area.AreaId is not { Length: > 0 };

	// Computed once per Refresh rather than read from the catalog in a getter: these are read during render,
	// and Blazor renders this component on every keystroke in it.
	private IReadOnlyList<EntityOption> _lightOptions = [];
	private IReadOnlyList<EntityOption> _motionOptions = [];
	private IReadOnlyList<EntityOption> _luxOptions = [];

	private bool _showAllEntities;

	/// <summary>Whether the pickers are filtered to this area's own entities. With no area id chosen there is nothing to filter to.</summary>
	private bool ScopeToArea => !_showAllEntities && Area.AreaId is { Length: > 0 };

	/// <summary>
	///     Whether the registry answered at all — the areas are hoisted from the page, so an empty list here means
	///     nothing came back rather than that this house has no areas.
	/// </summary>
	private bool RegistryAnswered => Areas.Count > 0;

	/// <summary>
	///     Why a picker has nothing to offer. Scoping to an area makes an empty list ordinary rather than alarming
	///     — most areas have no lux sensor — so it must not be reported as a broken connection.
	/// </summary>
	private string EmptyNote(string what) =>
		!RegistryAnswered ? "Waiting for Home Assistant — type an id for now."
		: ScopeToArea ? $"No {what} in this room. Tick “show entities from other rooms” to pick from the whole house."
		: $"No {what} found anywhere in Home Assistant — type an id if one is coming.";

	private bool HasExplicitEntities =>
		Area.Lights is { Count: > 0 } || Area.MotionSensors is { Count: > 0 }
		|| Area.LuxSensor is { Length: > 0 } || Area.IgnoreWhenOn is { Count: > 0 };

	/// <summary>
	///     How many of the per-room settings this area states for itself.
	/// </summary>
	/// <remarks>
	///     Asks <see cref="AreaSetupService.OverrideCount"/> rather than keeping a twin of it. This used to be a
	///     spelled-out list of its own, on the theory that two lists read side by side stay in step; they did not.
	///     The five daylight-brightness settings were added to the re-setup plan's copy and not to this one, so a
	///     room tuned solely through them summarised itself as "all automatic" while the warning correctly counted
	///     five. <c>Enabled</c> stays out of the count either way: the header switch owns it.
	/// </remarks>
	private int OverrideCount => AreaSetupService.OverrideCount(Area);

	private bool HasOverrides => OverrideCount > 0;

	// The nullable twins cannot be bound directly by @bind on a control that is only rendered while the
	// override is on: @bind on an int? input treats a cleared box as null, which would silently turn an
	// override back into "inherit" the moment somebody selected the text. These properties keep the null
	// question where it belongs — the override switch — and the input to a plain value.
	private int AreaVacancyTimeout { get => Area.VacancyTimeoutSeconds ?? Defaults.VacancyTimeoutSeconds; set => Assign(() => Area.VacancyTimeoutSeconds = value); }
	private int AreaPreOff { get => Area.PreOffSeconds ?? Defaults.PreOffSeconds; set => Assign(() => Area.PreOffSeconds = value); }
	private double AreaPreOffFactor { get => Area.PreOffBrightnessFactor ?? Defaults.PreOffBrightnessFactor; set => Assign(() => Area.PreOffBrightnessFactor = value); }
	private int AreaOverrideDuration { get => Area.OverrideDurationMinutes ?? Defaults.OverrideDurationMinutes; set => Assign(() => Area.OverrideDurationMinutes = value); }
	private int AreaVacancyReset { get => Area.VacancyResetMinutes ?? Defaults.VacancyResetMinutes; set => Assign(() => Area.VacancyResetMinutes = value); }
	private double AreaLuxThreshold { get => Area.LuxThreshold ?? Defaults.LuxThreshold; set => Assign(() => Area.LuxThreshold = value); }
	private double AreaLuxHysteresis { get => Area.LuxHysteresis ?? Defaults.LuxHysteresis; set => Assign(() => Area.LuxHysteresis = value); }
	private double AreaSunElevation { get => Area.SunElevationThreshold ?? Defaults.SunElevationThreshold; set => Assign(() => Area.SunElevationThreshold = value); }
	private double AreaDayFade { get => Area.DayTransitionSeconds ?? Defaults.DayTransitionSeconds; set => Assign(() => Area.DayTransitionSeconds = value); }
	private double AreaNightFade { get => Area.NightTransitionSeconds ?? Defaults.NightTransitionSeconds; set => Assign(() => Area.NightTransitionSeconds = value); }

	private string _darkness = nameof(DarknessSource.Either);
	private string _respectSleep = "false";
	private string _sleepBlocks = "false";
	private string _skipAway = "false";
	private string _welcomeHome = "false";

	/// <inheritdoc/>
	protected override void OnParametersSet()
	{
		_darkness = (Area.Darkness ?? Defaults.Darkness).ToString();
		_respectSleep = Lower(Area.RespectSleepMode ?? Defaults.RespectSleepMode);
		_sleepBlocks = Lower(Area.SleepBlocksAutoOn ?? Defaults.SleepBlocksAutoOn);
		_skipAway = Lower(Area.SkipAwaySweep ?? Defaults.SkipAwaySweep);
		_welcomeHome = Lower(Area.WelcomeHome ?? Defaults.WelcomeHome);

		Refresh();
	}

	private string Name(string entityId) => Catalog.FriendlyNameOf(entityId) ?? entityId;

	private static string YesNo(bool value) => value ? "yes" : "no";

	private static string Lower(bool value) => value ? "true" : "false";

	private async Task OnAreaChanged(string? areaId)
	{
		Area.AreaId = areaId;

		// The name follows the area unless somebody has typed one. An area called "stue" is worse than an area
		// called "Stue", and making them type it again is worse than both.
		if (string.IsNullOrWhiteSpace(Area.Name) && areaId is { Length: > 0 })
			Area.Name = Areas.FirstOrDefault(area => string.Equals(area.Id, areaId, StringComparison.Ordinal))?.Name ?? areaId;

		await Notify().ConfigureAwait(false);
	}

	private Task Set(Action mutate)
	{
		mutate();
		return Notify();
	}

	private Task SetList(IReadOnlyList<string> value, Action<List<string>?> assign)
	{
		// An empty list and a null list are different instructions: null means "discover", [] would mean "this
		// area has no lights", which is never what clearing the last chip meant.
		assign(value.Count == 0 ? null : [.. value]);
		return Notify();
	}

	private void Assign(Action mutate)
	{
		mutate();
		Refresh();
		_ = Changed.InvokeAsync();
	}

	private async Task Notify()
	{
		Refresh();
		await Changed.InvokeAsync().ConfigureAwait(false);
	}

	/// <summary>
	///     Drops one discovered entity from this room without switching it to a hand-picked list.
	/// </summary>
	/// <remarks>
	///     Adds the id to <see cref="AreaConfig.ExcludeEntities"/> — discovery keeps finding everything else, and the
	///     preview re-runs so the entity disappears from it. This is the per-entity escape hatch a household needs
	///     when one sensor in the room's area should not drive its lighting, without retyping the whole room as an
	///     explicit list. Like every other edit here it arms the save bar rather than saving, so the one write path
	///     stays the one write path; discarding unsaved changes is the undo.
	/// </remarks>
	private Task ExcludeEntity(string entityId)
	{
		List<string> excluded = Area.ExcludeEntities is { } existing ? [.. existing] : [];

		if (!excluded.Contains(entityId, StringComparer.Ordinal))
			excluded.Add(entityId);

		Area.ExcludeEntities = excluded;
		return Notify();
	}

	private Task Remove() => Removed.InvokeAsync();

	private Task SetUpAgain() => SetUpAgainRequested.InvokeAsync();

	/// <summary>
	///     Flips the room's power switch.
	/// </summary>
	/// <remarks>
	///     Writes an explicit <c>true</c> or <c>false</c>, never <c>null</c>: inheritance stays for documents that
	///     predate the switch, but a decision somebody just made with their thumb belongs in the file as itself.
	///     And it is an edit like any other — it arms the save bar rather than saving, so the one write path stays
	///     the one write path.
	/// </remarks>
	private Task ToggleEnabled()
	{
		Area.Enabled = !IsEnabled;
		return Notify();
	}

	// Each select writes straight through to the area rather than leaving the field to be swept up later:
	// a shadow field that is only reconciled on the next Refresh is a value that is briefly a lie, and the
	// discovery preview reads the area.
	private Task OnDarknessChanged(string value)
	{
		_darkness = value;
		if (Enum.TryParse<DarknessSource>(value, out DarknessSource darkness))
			Area.Darkness = darkness;

		return Notify();
	}

	private Task OnRespectSleepChanged(string value) { _respectSleep = value; Area.RespectSleepMode = IsYes(value); return Notify(); }

	private Task OnSleepBlocksChanged(string value) { _sleepBlocks = value; Area.SleepBlocksAutoOn = IsYes(value); return Notify(); }

	private Task OnSkipAwayChanged(string value) { _skipAway = value; Area.SkipAwaySweep = IsYes(value); return Notify(); }

	private Task OnWelcomeHomeChanged(string value) { _welcomeHome = value; Area.WelcomeHome = IsYes(value); return Notify(); }

	private static bool IsYes(string value) => string.Equals(value, "true", StringComparison.Ordinal);

	// Widening the pickers changes what they offer, so the lists have to be rebuilt rather than left showing
	// the area's entities under a checkbox that says otherwise. It changes no configured value, so the page is
	// not told: this is a view of the area, not an edit to it.
	private void OnShowAllChanged(bool showAll)
	{
		_showAllEntities = showAll;
		Refresh();
	}

	private void Refresh()
	{
		Preview = Catalog.PreviewArea(Area, Defaults, Global);

		AreaEntities inArea = Catalog.EntitiesInArea(Area.AreaId, Global);

		_lightOptions = Scope(inArea.Lights, Lights, Area.Lights);
		_motionOptions = Scope(inArea.MotionSensors, MotionSensors, Area.MotionSensors);
		_luxOptions = Scope(inArea.LuxSensors, LuxSensors, Area.LuxSensor is { Length: > 0 } lux ? [lux] : null);
	}

	/// <summary>
	///     The options one picker offers: the area's, unless the operator has widened them.
	/// </summary>
	/// <remarks>
	///     <paramref name="inArea"/> is discovery's own answer, so the scoped list cannot disagree with the
	///     preview above it — a ghost the engine drops is not offered here either.
	/// </remarks>
	private IReadOnlyList<EntityOption> Scope(
		IReadOnlyList<EntityOption> inArea,
		IReadOnlyList<EntityOption> everywhere,
		IReadOnlyList<string>? configured)
	{
		if (!ScopeToArea)
			return everywhere;

		// An entity already configured from outside the area stays listed and stays selected. A filter is a
		// default; it is never a reason to silently drop a value somebody chose on purpose, and "the area
		// assignment is wrong" is precisely why this list exists at all.
		IEnumerable<EntityOption> outsiders = configured is null
			? []
			: everywhere.Where(option =>
				configured.Contains(option.EntityId, StringComparer.Ordinal)
				&& !inArea.Any(local => string.Equals(local.EntityId, option.EntityId, StringComparison.Ordinal)));

		return [.. inArea.Concat(outsiders).OrderBy(option => option.FriendlyName, StringComparer.CurrentCulture)];
	}
}
