@* One line at the foot of the room's table, and the light list it opens. Nothing here writes to disk, and
   nothing is stored for the checkbox itself: the rows are the fact. *@

@if (Applies)
{
	<div class="llv">
		<label class="llv-toggle">
			<input type="checkbox" checked="@Open" @onchange="args => Toggle(args.Value is true)" />
			@ToggleLabel
		</label>

		@if (Open)
		{
			<div class="llv-list">
				@foreach (LightEntry entry in LightLevels.Entries(Periods, Resolved, Room))
				{
					LightEntry current = entry;

					<details class="llv-entry" @key="current.EntityId">
						<summary class="llv-head">
							<span class="llv-name">@Name(current.EntityId)</span>
							<span class="llv-says">@current.Summary</span>
							<span class="area-chevron" aria-hidden="true"></span>
						</summary>

						<div class="llv-body">
							@* A group is a flat list of the lights under it, once each. A group inside a group is not
							   a fold inside a fold: on a phone that is a page nobody can read. *@
							@if (current.IsGroup)
							{
								@foreach (string leaf in current.Leaves)
								{
									string light = leaf;

									<details class="llv-entry llv-leaf" @key="light">
										<summary class="llv-head">
											<span class="llv-name">@Name(light)</span>
											<span class="llv-says">@LightLevels.Line(Periods, Room, light).Summary</span>
											<span class="area-chevron" aria-hidden="true"></span>
										</summary>

										<div class="llv-body">
											@Table(light)
										</div>
									</details>
								}
							}
							else
							{
								@Table(current.EntityId)
							}
						</div>
					</details>
				}
			</div>

			@* Lights this room still pins and no longer commands: moved to another room, dropped from a group,
			   or renamed. Mirrors the orphan period rows above the list. *@
			@foreach (LightLevelOrphan orphan in LightLevels.Orphans(Resolved, Room))
			{
				LightLevelOrphan current = orphan;

				<div class="llv-entry llv-orphan" @key="@($"orphan:{current.EntityId}")">
					<div class="llv-head">
						<span class="llv-name">@Name(current.EntityId)</span>
						<span class="llv-says">
							this room does not command it any more &mdash;
							@current.PeriodCount @(current.PeriodCount == 1 ? "period" : "periods") still pinned
						</span>
						<button type="button" class="lvl-drop" @onclick="() => Drop(current.EntityId)">Remove it</button>
					</div>
				</div>
			}
		}
	</div>
}

@code {
	/// <summary>The document's period list, read here and never edited.</summary>
	[Parameter, EditorRequired]
	public List<TimePeriodConfig> Periods { get; set; } = [];

	/// <summary>The room being edited, in place.</summary>
	[Parameter, EditorRequired]
	public AreaConfig Room { get; set; } = new();

	/// <summary>What the engine makes of the room, which settles what a group is and what is inside one.</summary>
	[Parameter]
	public ResolvedArea? Resolved { get; set; }

	/// <summary>Whether this room commands any warmth at all; without it no light offers the question either.</summary>
	[Parameter]
	public bool NoColourTemperature { get; set; }

	/// <summary>Home Assistant's own name for an entity.</summary>
	[Parameter]
	public Func<string, string>? NameOf { get; set; }

	/// <summary>Raised after any change, so the page can re-validate and start its save timer.</summary>
	[Parameter]
	public EventCallback Changed { get; set; }

	// Ticked from the rows on load, then held here: unticking with rows present has to ask before dropping them,
	// and the question cannot be posed by a box that has already un-ticked itself.
	private bool? _open;

	private bool Applies => LightLevels.Applies(Resolved);

	private bool Open => _open ?? LightLevels.InUse(Room);

	// The label carries the warning, because a disabled control whose reason lives only in a tooltip is a control
	// nobody can find out about on a phone.
	private string ToggleLabel
	{
		get
		{
			int stating = LightLevels.StatingCount(Room);

			return Open && stating > 0
				? $"Untick to forget the {stating} {(stating == 1 ? "light's" : "lights'")} own levels"
				: "Adjust lights individually";
		}
	}

	private string Name(string entityId) => NameOf?.Invoke(entityId) ?? entityId;

	private Task Toggle(bool open)
	{
		_open = open;

		if (open || !LightLevels.InUse(Room))
			return Task.CompletedTask;

		LightLevels.Forget(Room);

		return Changed.InvokeAsync();
	}

	private Task Drop(string entityId)
	{
		if (!LightLevels.Remove(Room, entityId))
			return Task.CompletedTask;

		return Changed.InvokeAsync();
	}

	// No warmth select, no daylight chart and no Test column inside a light: warmth capability is a fact about
	// the room's fixtures, the chart belongs to the room, and the room's own Test already puts every light's own
	// level on the real lights.
	private RenderFragment Table(string entityId) => @<div class="llv-table">
		@foreach (LightLevelRow row in LightLevels.Rows(Periods, Room, entityId))
		{
			LightLevelRow current = row;

			<div class="lvl @(NoColourTemperature ? "lvl-nocolour" : null) @(current.IsOwn ? "lvl-own" : null)" @key="current.PeriodId">
				<div class="lvl-when">
					<span class="lvl-name">@PeriodName(current.Name)</span>
					<span class="lvl-start">@StartOf(current.PeriodId)</span>

					<label class="lvl-curve-toggle">
						<input type="checkbox" checked="@current.FollowsDaylightCurve"
							   @onchange="args => SetCurve(entityId, current, args.Value is true)" />
						Follow the daylight curve
					</label>
				</div>

				<div class="lvl-cell @(current.FollowsDaylightCurve ? "lvl-cell-curve" : null)">
					@if (!current.FollowsDaylightCurve)
					{
						<PresetSlider Value="@current.BrightnessPct"
									  AtDefault="@(!current.BrightnessIsOwn)"
									  Inheritable="true"
									  DefaultLabel="the room's"
									  Options="@Presets.BrightnessPct"
									  Unit="%"
									  Label="Brightness"
									  AriaLabel="@($"Brightness during {PeriodName(current.Name)}")"
									  FineAdjustable="true"
									  ValueChanged="@(value => SetBrightness(entityId, current.PeriodId, value))">
							<Mark>
								@if (current.BrightnessIsOwn)
								{
									<span class="tok-own-dot" title="This light's own setting" aria-hidden="true"></span>
								}
							</Mark>
						</PresetSlider>
					}
				</div>

				@if (!NoColourTemperature)
				{
					<div class="lvl-cell">
						<PresetSlider Value="@current.ColorTempKelvin"
									  AtDefault="@(!current.ColourIsOwn)"
									  Inheritable="true"
									  DefaultLabel="the room's"
									  Options="@Presets.ColorTempKelvin"
									  Unit="K"
									  ShowStepWording="true"
									  Label="Warmth"
									  AriaLabel="@($"Warmth during {PeriodName(current.Name)}")"
									  ValueChanged="@(value => SetColour(entityId, current.PeriodId, value))">
							<Mark>
								<span class="lvl-swatch" style="@Swatch(current.ColorTempKelvin)" title="@($"{current.ColorTempKelvin} K")" aria-hidden="true"></span>
								@if (current.ColourIsOwn)
								{
									<span class="tok-own-dot" title="This light's own setting" aria-hidden="true"></span>
								}
							</Mark>
						</PresetSlider>
					</div>
				}
			</div>
		}
	</div>;

	/// <summary>The same placeholder the schedule editor uses for an unnamed period.</summary>
	private static string PeriodName(string name) => name is { Length: > 0 } ? name : "unnamed period";

	private string StartOf(string periodId)
	{
		if (Periods.ByKey(periodId) is not { } found)
			return string.Empty;

		return PeriodStartText.Short(found.Start) is { Length: > 0 } boundary ? $"[{boundary}]" : "start not set";
	}

	// KelvinColour.Css writes its own invariant integers, so no decimal comma reaches the colour function.
	private static string Swatch(int kelvin) => $"--lvl-kelvin: {KelvinColour.Css(kelvin)}";

	private Task SetBrightness(string entityId, string periodId, double? value)
	{
		LightLevels.SetBrightness(Room, entityId, periodId, value);

		return Changed.InvokeAsync();
	}

	private Task SetColour(string entityId, string periodId, double? value)
	{
		LightLevels.SetColorTemp(
			Room,
			entityId,
			periodId,
			value is { } kelvin ? (int)Math.Round(kelvin, MidpointRounding.AwayFromZero) : null);

		return Changed.InvokeAsync();
	}

	private Task SetCurve(string entityId, LightLevelRow row, bool follow)
	{
		bool roomFollows = RoomLevels.Rows(Periods, Room)
			.Any(theRoom => theRoom.PeriodId == row.PeriodId && theRoom.FollowsDaylightCurve);

		LightLevels.SetFollowsDaylightCurve(Room, entityId, row.PeriodId, row.BrightnessPct, roomFollows, follow);

		return Changed.InvokeAsync();
	}
}
