@page "/room/{AreaId}"
@implements IDisposable
@inject LightingEngineHost Engine
@inject HaCatalog Catalog
@inject AreaSnapshotCache Cache
@inject ActivityLog Log
@inject NavigationManager Nav
@inject ILogger<Room> Logger
@inject IJSRuntime Js

@* Layout, styling and the wiring of presses to RoomPageModel. Every rule, sentence and write lives in the
   model, so a second design puts its own markup over the same page without writing any of it again. *@

<PageTitle>@_model.PageName &mdash; Adaptive lighting</PageTitle>

@* Only a refused save can be lost: anything else is written on the way out. *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="@_model.HasRefusedEdit" />

@if (_model.LoadError is { Length: > 0 } loadError)
{
	<h1>This room can't be shown</h1>
	<div class="notice bad">
		<strong>The configuration file couldn't be read.</strong>
		<p>@loadError</p>
		<p>Every room is in that one file, so nothing can be shown or changed until it parses. <a href="config">Open the Configuration page</a> to repair it.</p>
	</div>
}
else if (_model.Area is not { } room)
{
	<h1>No such room</h1>
	<div class="empty">
		<strong>Nothing here is set up as <code>@AreaId</code>.</strong>
		<p>The room may have been removed, or its Home Assistant area may have been changed.</p>
		<p><a href="">Back to the dashboard</a> &mdash; or <a href="config?section=areas">see every room</a>.</p>
	</div>
}
else
{
	<a class="room-back" href="">&lsaquo; Dashboard</a>

	<RoomHeader Model="@_model" GlowStyle="@GlowStyle" RingStyle="@RingStyle" CountdownTitle="@CountdownTitle" />

	@* A refused save stays until it is resolved: until then the file on disk is not what is on screen. *@
	@if (_model.Failure is { } failure)
	{
		<div class="notice bad">
			<strong>Not saved.</strong> @failure.Message
			@if (failure.Validation.Errors.Count > 0)
			{
				<ul>
					@foreach (string error in failure.Validation.Errors)
					{
						<li>@error</li>
					}
				</ul>
			}
			<div class="panel-actions">
				@* No retry on a conflict: the same save refuses again until the room is read afresh. *@
				@if (failure.Status is not SaveStatus.Conflicted)
				{
					<button type="button" class="primary" @onclick="_model.Commit">Try again</button>
				}
				<button type="button" class="@(failure.Status is SaveStatus.Conflicted ? "primary" : null)" @onclick="_model.Discard">
					@(failure.Status is SaveStatus.Conflicted ? "Reload this room" : "Discard my changes")
				</button>
			</div>
		</div>
	}
	else if (_model.AreaError is { } mine)
	{
		@* An area-level error costs this room, not the save. *@
		<div class="notice warn">
			<strong>This room will be skipped.</strong> @mine.Message
		</div>
	}

	<section class="panel room-card">
		<div class="room-card-head">
			<span class="room-card-title">How this room behaves</span>
			<span class="room-save @SaveClass" role="status">@_model.SaveLine</span>
			@if (_model.Dirty)
			{
				<button type="button" class="room-save-now" @onclick="_model.Commit">Save now</button>
			}
		</div>

		<div class="room-sentences">
			<SentenceView Sentences="@_model.Sentences"
						  Edited="@_model.OnEdited"
						  Reverted="@_model.Revert"
						  Note="@RoomPageModel.TokenNote" />
		</div>
	</section>

	<section class="panel room-card room-levels-card">
		<div class="room-card-head">
			<span class="room-card-title">Brightness &amp; warmth</span>
			@if (_model.OwnPeriodCount is > 0 and int chosen)
			{
				<span class="sgroup-count" title="Periods this room sets for itself">@chosen</span>
			}
			@* The first card head already announces the save. *@
			<span class="room-save @SaveClass" aria-hidden="true">@_model.SaveLine</span>
		</div>

		<p class="room-card-foot lvl-lede">@_model.LevelsLede</p>

		<LevelsEditor Periods="@_model.Periods"
					  Room="@room"
					  Defaults="@_model.Defaults"
					  Resolved="@_model.Resolved"
					  ActivePeriod="@_model.ActivePeriodId"
					  NameOf="@_model.NameOf"
					  TestRefusal="@_model.TestRefusal"
					  TestingPeriodId="@_model.TestingPeriod"
					  TestSecondsLeft="@_model.TestSecondsLeft"
					  TestSeconds="@RoomPageModel.TestSeconds"
					  Test="@_model.TestPeriod"
					  TestingLightId="@_model.TestingLight"
					  TestLight="@_model.TestLight"
					  Changed="@_model.MarkDirty" />

		@* Only where this room asked for it, for at least one period. With none the chart has nothing to
		   describe, and its handles would edit numbers that change nothing. *@
		@if (_model.CurvePeriodNames.Count > 0)
		{
			<div class="lvl-daylight">
				<div class="lvl-daylight-head">
					<span class="lvl-daylight-title">Daylight curve</span>
				</div>

				<LuxCurveChart Settings="@_model.Effective"
							   PeriodNames="@_model.CurvePeriodNames"
							   Reading="@_model.DaylightLux"
							   Changed="@_model.OnCurveEdited" />

				<p class="room-card-foot">@_model.DaylightSourceNote</p>
			</div>
		}
	</section>

	@* All settings, the gear and the log sit together at the foot of the page. *@
	<section class="panel room-card">
		<div class="room-morebar">
			<button type="button"
					class="room-more"
					aria-expanded="@(_model.ShowAll ? "true" : "false")"
					@onclick="_model.ToggleAll">
				All settings @(_model.ShowAll ? "▴" : "▾")
			</button>
			@* Kept short: at 390px this bar has 340px, and a longer sentence wraps to three lines. *@
			<span class="room-more-note">
				@_model.OwnLine
				<a href="config?section=house">house default settings</a>.
			</span>
		</div>

		@if (_model.ShowAll)
		{
			<AllSettingsPanel Settings="@_model.SettingsInput"
							  Toggled="@_model.Toggle"
							  Set="@_model.SetSetting"
							  Reverted="@_model.RevertSetting">
				<GroupExtra Context="group">
					@* Not overridable, so these have no twin in the defaults and cannot be rows above,
					   but they are movement rules and belong in this section. *@
					@if (string.Equals(group.Title, RoomSettings.MovementSection, StringComparison.Ordinal))
					{
						<SettingRow Label="Light dimly when these see movement"
									Help="Sensors outside this room: the front steps, the room next door. When one of them sees movement while this room is dark, empty and running by itself, the room lights at Dim light level of its usual level for Dim light lasts. Movement in the room then brings the lights up to their usual level; if nobody comes in, they go off again. Everything that stops movement lighting the room stops this too: daylight, away, sleep, Don't switch on while. A room already lit, or set or switched off by hand, takes no notice. Offered from the whole house.">
							<EntityListPicker Value="@_model.LeadInSensors"
											  ValueChanged="@_model.SetLeadInSensors"
											  Options="@_model.LeadInOptions"
											  Lookup="@_model.Lookup"
											  EmptyLabel="Nothing outside lights this room ahead of time."
											  AddLabel="Add a sensor…"
											  Placeholder="binary_sensor.front_steps_motion" />
						</SettingRow>

						<SettingRow Label="Don't switch on while"
									Help="The room won't light itself while any of these is on: a projector, a do-not-disturb switch. Movement is still noticed, and lights already on are left alone. Tick the box for the opposite, so it holds while they are off — for a “lighting allowed” switch you turn off. Offered from the whole house, since a blocker often belongs to no room.">
							<EntityListPicker Value="@_model.IgnoreWhenOn"
											  ValueChanged="@_model.SetIgnoreWhenOn"
											  Options="@_model.BlockerOptions"
											  Lookup="@_model.Lookup"
											  EmptyLabel="Nothing blocks this room."
											  AddLabel="Add a blocker…"
											  Placeholder="binary_sensor.projector_is_on" />

							@if (_model.IgnoreWhenOn is { Count: > 0 })
							{
								<label class="gate-invert">
									<input type="checkbox"
										   checked="@_model.IgnoreWhenOnInverted"
										   @onchange="@(args => _model.SetIgnoreWhenOnInverted(args.Value is true))" />
									while these are off instead
								</label>
							}
						</SettingRow>

						<SettingRow Label="Don't switch off while"
									Help="The room won't turn its own lights off while any of these is on, so the countdown, the dim light before switching off and the leaving sweep leave it alone: a meeting light, a guest switch. It never turns anything on, and switching off by hand still works. Tick the box for the opposite, so it holds while they are off.">
							<EntityListPicker Value="@_model.KeepLitWhenOn"
											  ValueChanged="@_model.SetKeepLitWhenOn"
											  Options="@_model.BlockerOptions"
											  Lookup="@_model.Lookup"
											  EmptyLabel="Nothing holds this room's lights on."
											  AddLabel="Add one…"
											  Placeholder="input_boolean.meeting" />

							@if (_model.KeepLitWhenOn is { Count: > 0 })
							{
								<label class="gate-invert">
									<input type="checkbox"
										   checked="@_model.KeepLitWhenOnInverted"
										   @onchange="@(args => _model.SetKeepLitWhenOnInverted(args.Value is true))" />
									while these are off instead
								</label>
							}
						</SettingRow>

						@* Inherits from the house's Fine tuning, not from the house default settings, so it is not one of the N of M. *@
						<SettingRow Label="Other automations count as manual changes"
									Help="Yes: when another Home Assistant automation changes these lights, the room stands back exactly as it does for somebody at the switch, for as long as Manual changes hold. No: the room leaves the change alone and carries on by itself, so its next re-check or movement sets its own level again. Unless set here, the room follows the house setting under House → Fine tuning."
									IsOwn="@_model.AutomationsAreOwn"
									HouseText="@_model.AutomationsHouseText"
									Reverted="@(() => _model.SetAutomationsAsManual(null))">
							<div class="seg" role="group" aria-label="Other automations count as manual changes">
								<button type="button"
										class="@(_model.AutomationsCountAsManual ? "cur" : null)"
										aria-pressed="@(_model.AutomationsCountAsManual ? "true" : "false")"
										@onclick="() => _model.SetAutomationsAsManual(true)">Yes</button>
								<button type="button"
										class="@(_model.AutomationsCountAsManual ? null : "cur")"
										aria-pressed="@(_model.AutomationsCountAsManual ? "false" : "true")"
										@onclick="() => _model.SetAutomationsAsManual(false)">No</button>
							</div>
						</SettingRow>

						<SettingRow Label="Run a scene instead, on movement"
									Help="When movement would light this room, it runs this scene instead of setting its own brightness and warmth, and leaves it alone afterwards. Everything that can refuse to light the room still refuses — the master switch, this room's switch, an away house, sleep, too much daylight, a blocker above. A scene is what happens instead of switching on, never a reason to.">
							<EntityPicker Value="@_model.SceneOnMotion"
										  ValueChanged="@_model.SetSceneOnMotion"
										  Options="@_model.SceneOptions"
										  Lookup="@_model.Lookup"
										  NoneLabel="(this room's own brightness and warmth)"
										  EmptyNote="No scenes in Home Assistant yet — type an id instead."
										  Placeholder="scene.stue_kveld" />
						</SettingRow>

						<SettingRow Label="Run a scene instead, when empty"
									Help="When the room has been empty long enough to go off, it runs this scene and stays there — atmospheric lighting rather than darkness. The dim light before switching off does not run, since nothing is about to go off. Leaving the house still switches the room off, and switching it off by hand still works.">
							<EntityPicker Value="@_model.SceneWhenEmpty"
										  ValueChanged="@_model.SetSceneWhenEmpty"
										  Options="@_model.SceneOptions"
										  Lookup="@_model.Lookup"
										  NoneLabel="(switch the lights off)"
										  EmptyNote="No scenes in Home Assistant yet — type an id instead."
										  Placeholder="scene.stue_natt" />
						</SettingRow>
					}
				</GroupExtra>

				<Extra>
					@* Not overridable: these are what the room is, not how it behaves. *@
					<div class="sgroup @(_model.IdentityOpen ? "sgroup-open" : null)">
						<button type="button"
								class="sgroup-head"
								aria-expanded="@(_model.IdentityOpen ? "true" : "false")"
								@onclick="_model.ToggleIdentity">
							<span class="sgroup-title">Room identity</span>
							<span class="sgroup-note">What this room is called, and which Home Assistant area it is</span>
							<span class="area-chevron" aria-hidden="true"></span>
						</button>

						@if (_model.IdentityOpen)
						{
							<div class="sgroup-body">
								<SettingRow Label="Name" Help="What this room is called everywhere here. Leave it empty and it follows the Home Assistant area's name, so renaming it there renames it here.">
									<input type="text"
										   class="cell wide"
										   value="@_model.OwnName"
										   placeholder="@_model.RoomName"
										   aria-label="Name"
										   @onchange="@(args => _model.SetOwnName(args.Value as string))" />
								</SettingRow>

								<SettingRow Label="Home Assistant area" Help="Which area this room is. Changing it looks for lights and sensors again, so what is found below changes with it, and this page moves to the new address.">
									<AreaPicker Value="@_model.AreaId" ValueChanged="@_model.ChangeArea" Areas="@_model.Areas" />
								</SettingRow>
							</div>
						}
					</div>
				</Extra>
			</AllSettingsPanel>
		}
	</section>

	<div class="room-columns">
		<RoomGearCard Model="@_model" />
		<RoomLogCard Model="@_model" />
	</div>

}

@code {
	/// <summary>The Home Assistant area id in the URL.</summary>
	[Parameter]
	public string AreaId { get; set; } = "";

	private RoomPageModel _model = default!;

	protected override void OnInitialized()
	{
		_model = new RoomPageModel(Engine, Catalog, Cache, Log, Logger, work => InvokeAsync(work));
		_model.Changed += StateHasChanged;
		_model.Navigated += Leave;
		_model.Start();
	}

	protected override void OnParametersSet() => _model.Show(AreaId);

	private void Leave(string href) => Nav.NavigateTo(href);

	private async Task ConfirmLeave(LocationChangingContext context)
	{
		if (_model.HasRefusedEdit
			&& !await Js.InvokeAsync<bool>("confirm", RoomPageModel.LeaveQuestion))
			context.PreventNavigation();
	}

	// The lamp glows at the warmth the room was commanded to. A hand-held room has levels the engine never chose,
	// so it glows violet.
	private string GlowStyle =>
		_model.Glow is not { } glow
			? string.Empty
			: $"--room-lamp: {(glow.HandHeld ? "var(--human)" : KelvinColour.Css(glow.Kelvin!.Value))}; "
				+ $"--room-lamp-spread: {glow.Spread.ToString(CultureInfo.InvariantCulture)}px;";

	// The ring drains to how much of the armed countdown is left.
	private string RingStyle =>
		_model.Countdown is { } remaining
			? $"--room-ring: {(remaining * 360).ToString("0.0", CultureInfo.InvariantCulture)}deg;"
			: string.Empty;

	private string CountdownTitle =>
		_model.NextChangeAt is { } due ? $"Next change {RoomFacts.In(due, _model.Now)}." : string.Empty;

	private string SaveClass => _model.SaveState switch
	{
		RoomSaveState.Refused => SaveNotice.Failed,
		RoomSaveState.Waiting => SaveNotice.Pending,
		RoomSaveState.Saved => SaveNotice.Done,
		_ => SaveNotice.Idle
	};

	public void Dispose()
	{
		_model.Changed -= StateHasChanged;
		_model.Navigated -= Leave;
		_model.Dispose();
	}
}
