@page "/activity"
@implements IDisposable
@inject ActivityLog Log
@inject AreaSnapshotCache Cache
@inject LightingEngineHost Engine
@inject ILogger<Activity> Logger

@* The timeline begins when the add-on started, not when the house did. One report is not one row: a
   house-wide event is published by every switched-on room, so ActivityView.Rows collapses a run of identical
   house-wide reports into one row. That affects rendering only; the counts, the chips and the log are all
   still about reports. *@

<PageTitle>Activity &mdash; Adaptive lighting</PageTitle>

<h1>Activity</h1>
<p class="lede">
	What each room decided, newest at top. Times come from the machine running adaptive lighting, which is
	not always the one you are reading this on.
</p>

@if (Model.Entries.Count > 0)
{
	@* Neither filter reaches the log; both narrow the list already read out of it. *@
	<div class="log-filters">
		<div class="log-bar">
			<label class="log-filter">
				<span class="log-filter-label">Room</span>
				<select class="cell wide" @bind:get="Model.Room" @bind:set="Model.SelectRoom">
					<option value="@ActivityView.AllRooms">All rooms</option>
					@foreach (ActivityRoomOption room in Model.RoomOptions)
					{
						<option value="@room.Key">@room.Name</option>
					}
				</select>
			</label>

			@* New reports are counted as they arrive but never inserted; the list only changes when this is
			   pressed. The count is of arrivals, not of arrivals matching the filters. *@
			@if (Model.Pending > 0)
			{
				<button type="button" class="log-new" @onclick="Model.ShowNew">@Model.PendingWord</button>
			}
		</div>

		@* Each chip's count is within the chosen room, not the house. *@
		<div class="log-cats" role="group" aria-label="Show these categories">
			<span class="log-filter-label">Show</span>

			@foreach (ActivityFilterChip chip in Model.Chips)
			{
				<button type="button"
						class="@ChipClass(chip)"
						aria-pressed="@(chip.IsOn ? "true" : "false")"
						title="@chip.Title"
						@onclick="() => Model.Toggle(chip.Category)">
					<span class="log-cat-mark" aria-hidden="true"></span>
					<span class="log-cat-name">@chip.Label</span>
					<span class="log-cat-count">@chip.Count</span>
				</button>
			}
		</div>

		@* Suppressed when everything is hidden: the empty panel below then carries the same sentence. *@
		@if (Model.Rows.Count > 0 && Model.HiddenNote is { Length: > 0 } hidden)
		{
			<p class="log-hidden">
				<span>@hidden</span>
				<button type="button" class="log-reset" @onclick="Model.ShowEverything">Show everything</button>
			</p>
		}
	</div>
}

@if (Model.Entries.Count == 0)
{
	<div class="empty">
		@if (!Engine.IsAttached)
		{
			<strong>Waiting for Home Assistant.</strong>
			<p>Reports reach this page through Home Assistant, so nothing can be recorded until the connection is up.</p>
			<p>This is normal for a minute after a restart.</p>
		}
		else if (!Engine.IsRunning)
		{
			<strong>Connected, but adaptive lighting isn't running.</strong>
			<p>@(Engine.Fault ?? "No reason was recorded.")</p>
			<p>See <a href="config">Configuration</a> for details.</p>
		}
		else
		{
			<strong>Nothing has happened yet.</strong>
			<p>
				Recording starts when adaptive lighting starts, and a room appears here the first time it
				decides something &mdash; movement, a change of house mode, or the light outside crossing the
				level it counts as dark.
			</p>
			<p>
				A quiet house can sit here for a long time. Rooms also start switched off after set-up, so if
				you have not turned any on yet there is nothing for the engine to decide &mdash;
				<a href="config?section=areas">choose the rooms it should look after</a>.
			</p>
		}
	</div>
}
else if (InRoom.Count == 0)
{
	@* The room has nothing left in the buffer at all, which is not the same as the categories hiding it. *@
	<div class="empty">
		<strong>Nothing from @Model.RoomName is still being held.</strong>
		<p>Its older reports may have been dropped to make room. The rest of the house is still here.</p>
		<p><button type="button" class="log-reset" @onclick="Model.ShowEverything">Show everything</button></p>
	</div>
}
else if (Model.Rows.Count == 0)
{
	<div class="empty">
		<strong>Every report is in a category you switched off.</strong>
		<p>
			@(InRoom.Count == 1
				? "1 report is being held"
				: $"{InRoom.Count} reports are being held")@(string.IsNullOrEmpty(Model.Room) ? "" : $" from {Model.RoomName}"),
			and none of them falls into the categories that are switched on.
		</p>
		<p><button type="button" class="log-reset" @onclick="Model.ShowEverything">Show everything</button></p>
	</div>
}
else
{
	@* Now is read at render time, not page load: a page left open past midnight must not keep heading
	   yesterday's entries Today. *@
	@foreach (ActivityDay day in ActivityView.GroupByDay(Model.Rows, DateTimeOffset.Now))
	{
		<div class="floor-head">
			<span class="floor-name">@day.Heading</span>
		</div>

		<ol class="log">
			@foreach (Presentation.ActivityRow row in day.Rows)
			{
				<ActivityRow @key="row.Sequence" Row="row" />
			}
		</ol>
	}

	<p class="log-foot">@Model.FootLine</p>
}

@code {
	private ActivityPageModel _model = default!;

	private ActivityPageModel Model => _model;

	// Not a model member: recomputed off the two the model already exposes, through the same public helper the
	// model itself filters with. Whether the room's own buffer is empty is a different question from whether the
	// category filter is hiding everything, and only this one needs its own room-only count on screen.
	private IReadOnlyList<ActivityEntry> InRoom => ActivityView.InRoomByKey(Model.Entries, Model.Room);

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		_model = new ActivityPageModel(Log, Cache, Logger, work => InvokeAsync(work));
		_model.Changed += StateHasChanged;
		_model.Start();
	}

	private static string ChipClass(ActivityFilterChip chip) =>
		$"log-cat{(chip.IsOn ? " on" : string.Empty)}{(chip.Count == 0 ? " empty" : string.Empty)}";

	/// <inheritdoc/>
	public void Dispose()
	{
		_model.Changed -= StateHasChanged;
		_model.Dispose();
	}
}
