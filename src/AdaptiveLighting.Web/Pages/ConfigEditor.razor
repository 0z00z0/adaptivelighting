@page "/config"
@implements IDisposable
@inject LightingEngineHost Engine
@inject HaCatalog Catalog
@inject ConfigLocation Location
@inject HomeLocation HomeGeo
@inject AreaSnapshotCache Cache
@inject ILogger<ConfigEditor> Logger

@*
	The House tab: everything that is not one room. Four sections behind a rail, one shown at a time.

	The rooms are a list, not an editor. Each row opens /room/{areaId}, which is the only place a room's settings
	are edited; a second inline editor here could not stay equivalent and did not.

	The write path is the save bar, not the room page's debounce. Every edit here changes something every room
	inherits, "switch on this floor" is a real batch whose warning promises nothing is written until Save, and
	several controls (the house name, the device-class set, the NetDaemon user id) are free text a debounce would
	write half-typed. Save goes to LightingEngineHost, which validates, writes one file, re-reads and rebuilds.

	Two properties this page must never lose:

	  - Token safety. It binds AdaptiveLightingConfig and nothing else, never IConfiguration: the root
	    configuration carries the Home Assistant long-lived token and this document does not. NetDaemonUserId is
	    rendered as set or not-set, never its value, in either direction.
	  - One write surface. Nothing on this page names a file path, and nothing it posts can.
*@

<PageTitle>The house &mdash; Adaptive lighting</PageTitle>

<h1>The house</h1>

@if (_loadError is { Length: > 0 })
{
	<div class="notice bad">
		<strong>The configuration file couldn't be read.</strong>
		<p>@_loadError</p>
		<p>
			The file is <code>@Location.Path</code>. Fix it by hand, or press <em>Start from scratch</em> &mdash;
			the old file is kept as <code>@Engine.Store.BackupPath</code> when you save.
		</p>
		<button type="button" @onclick="StartFromScratch">Start from scratch</button>
	</div>
}
else
{
	<p class="lede">
		Everything that isn't one room: what every room starts with, the day's schedule, the modes, the people
		and the engine itself. Changes apply as soon as you save &mdash; no restart needed.
	</p>

	@* Permanent, not a footnote: a document the next deploy silently reverts makes the UI look broken. *@
	@if (Location.Warning is { Length: > 0 })
	{
		<div class="notice warn">
			<strong>Edits here will not survive a deploy.</strong>
			<p>@Location.Warning</p>
		</div>
	}

	@*
		Above the rail, so it cannot hide with a section nobody is looking at. Both of these explain why an edit
		did not reach the house. The full detail lives under House.
	*@
	@if (!Engine.IsRunning || !HomeAssistantIsAnswering)
	{
		<div class="notice warn">
			@if (!Engine.IsRunning)
			{
				<div><strong>Adaptive lighting isn't running.</strong> @(Engine.Fault ?? "Not started yet.") Edits here are saved either way, and take effect when it starts.</div>
			}
			@if (!HomeAssistantIsAnswering)
			{
				<div>
					<strong>Waiting for Home Assistant.</strong> The pickers below have nothing to offer until it answers.
					You can still type ids by hand; they are not checked against Home Assistant if you save now.
				</div>
			}
		</div>
	}

	@* Only while there is something to say. It floats over the content, so it must not be permanent. *@
	@if (ShowSaveBar)
	{
	<div class="savebar">
		<button type="button" class="primary" @onclick="Save" disabled="@_busy">Save and apply</button>
		<button type="button" @onclick="Reload" disabled="@_busy">Discard changes</button>

		@* Errors and refused saves stay until resolved. Only the success confirmation below is transient. *@
		@if (_liveValidation is { IsValid: false })
		{
			<span class="savebar-note bad">
				@_liveValidation.Errors.Count @(_liveValidation.Errors.Count == 1 ? "problem" : "problems") to fix before saving.
			</span>
		}
		else if (_result is { Written: false } result)
		{
			<span class="savebar-note bad">@result.Message</span>
		}

		@if (_saveConfirmation is { Length: > 0 } confirmation)
		{
			<span class="savebar-note ok savebar-toast" role="status">@confirmation</span>
		}
	</div>
	}

	@* Validator messages verbatim, and above the rail: an error in a section you are not looking at still
	   refuses the save, so it must not hide with its section. *@
	@if (_liveValidation is { } validation && (validation.Errors.Count > 0 || validation.AreaErrors.Count > 0))
	{
		<div class="notice @(validation.IsValid ? "warn" : "bad")">
			@if (validation.Errors.Count > 0)
			{
				<strong>Fix these before saving:</strong>
				<ul>
					@foreach (string error in validation.Errors)
					{
						<li>@error</li>
					}
				</ul>
			}
			@if (validation.AreaErrors.Count > 0)
			{
				<strong>These rooms will be skipped &mdash; everything else still works, and you can still save:</strong>
				<ul>
					@foreach (AreaError areaError in validation.AreaErrors)
					{
						<li><b>@areaError.AreaName</b>: @areaError.Message</li>
					}
				</ul>
			}
		</div>
	}

	<div class="config-layout">
		@* A rail on a desktop, a row of chips on a phone. Each section's glyph repeats on its own header. *@
		<nav class="config-nav" aria-label="Configuration sections">
			<button type="button" class="config-nav-link @(ActiveClass(Section.Areas))" @onclick="() => Show(Section.Areas)">
				<Icon Name="@Glyph.Areas" Class="config-nav-icon" />
				<span class="config-nav-text">Areas</span>
				<span class="config-nav-count">@_config.Areas.Count</span>
			</button>
			<button type="button" class="config-nav-link @(ActiveClass(Section.Schedule))" @onclick="() => Show(Section.Schedule)">
				<Icon Name="@Glyph.Schedule" Class="config-nav-icon" />
				<span class="config-nav-text">Schedule</span>
				<span class="config-nav-count">@_config.Periods.Count</span>
			</button>
			<button type="button" class="config-nav-link @(ActiveClass(Section.HouseModes))" @onclick="() => Show(Section.HouseModes)">
				<Icon Name="@Glyph.Modes" Class="config-nav-icon" />
				<span class="config-nav-text">House modes</span>
				@if (_houseModeOptionValues.Count > 0)
				{
					<span class="config-nav-count">@_houseModeOptionValues.Count</span>
				}
			</button>
			<button type="button" class="config-nav-link @(ActiveClass(Section.House))" @onclick="() => Show(Section.House)">
				<Icon Name="@Glyph.House" Class="config-nav-icon" />
				<span class="config-nav-text">House</span>
			</button>
		</nav>

		<div class="config-body">
			@if (_section == Section.Areas)
			{
				<header class="section-head">
					<h2><Icon Name="@Glyph.Areas" Class="ic-head" />Areas</h2>
					<p class="lede">
						Rooms not listed here are never touched. Lights and sensors are found automatically from Home
						Assistant's areas &mdash; open a room to see what was found and to change how it behaves.
						@* Two groups moved to House; the thread says where, once, on the page they left. *@
						What every room starts with, and which lights count as a room's, are under
						<button type="button" class="thread" @onclick="() => Show(Section.House)">House</button>.
					</p>
				</header>

				<div class="panel-actions">
					<button type="button" @onclick="ToggleAddRoom" disabled="@(_setupScope is not null)">
						@(_addingRoom ? "Cancel" : "Add a room")
					</button>
					<button type="button" @onclick="OpenSetupForEveryRoom" disabled="@(!CanSetUpAgain)">Set up rooms again</button>
				</div>

				@if (!HomeAssistantIsAnswering)
				{
					<p class="hint">
						Setting rooms up again needs Home Assistant &mdash; each room is rebuilt from what the registry
						says right now.
					</p>
				}

				@* Adding a room is picking a Home Assistant area that has no room yet, so it arrives knowing what
				   it is and an existing room is never offered twice. *@
				@if (_addingRoom)
				{
					<div class="panel house-add">
						<div class="field">
							<div class="field-head"><label class="field-label">Which room?</label></div>
							<div class="field-control">
								<AreaPicker Value="@_addAreaId"
											ValueChanged="@AddRoom"
											Areas="@_addableAreas"
											NoneLabel="(pick a room)"
											EmptyNote="@AddEmptyNote" />
							</div>
							<div class="field-help">
								It arrives switched off, so nothing in it changes until you switch it on.
							</div>
						</div>
					</div>
				}

				@if (_setupNote is { Length: > 0 } setupNote)
				{
					<div class="notice ok">@setupNote</div>
				}

				@if (_setupScope is { } scope)
				{
					<SetupAgainPanel Config="@_config"
									 PreTicked="@scope"
									 PlanFor="@PlanSetup"
									 NameOf="@AreaName"
									 Confirmed="@ApplySetup"
									 Cancelled="@CloseSetup" />
				}

				@* Through the shared grouping helper, so this list and the board's lanes cannot disagree about which
				   room is upstairs. A house with no floors gets one unnamed group and no headers. *@
				@foreach (FloorGroup<AreaConfig> group in _areaGroups)
				{
					FloorGroup<AreaConfig> floor = group;

					@if (AreaView.ShowsHeader(_areaGroups.Count, floor.Floor))
					{
						<div class="floor-head">
							<span class="floor-name">@AreaView.FloorTitle(floor.Floor)</span>
							<button type="button" class="floor-bulk" @onclick="() => SwitchFloor(floor)">@FloorAction(floor)</button>
						</div>
					}

					<div class="room-rows">
						@foreach (AreaConfig area in floor.Items)
						{
							AreaConfig current = area;
							bool enabled = AreaView.IsEnabled(current, _config.Defaults);

							<div class="room-row @AreaView.EdgeClass(enabled, LiveStateOf(current))" @key="current">
								@* Outside the link: a control inside an anchor is invalid markup and cannot be tapped
								   without also navigating. *@
								<button type="button"
										class="switch @(enabled ? "on" : null)"
										role="switch"
										aria-checked="@(enabled ? "true" : "false")"
										aria-label="@($"Automatic lighting in {RoomName(current)}")"
										title="@ToggleTitle(enabled)"
										@onclick="() => ToggleEnabled(current)">
									<span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
									<span class="switch-word">@(enabled ? "on" : "off")</span>
								</button>

								@if (RoomLink(current) is { Length: > 0 } href)
								{
									<a class="room-open" href="@href">
										<span class="area-title">@RoomName(current)</span>
										<code class="area-slug">@current.AreaId</code>
										<span class="area-summary-hint">@HouseView.RoomSummary(current)</span>
										<span class="room-open-chevron" aria-hidden="true"></span>
									</a>
								}
								else
								{
									@* No page to open: the room names no area, or it does but is unsaved, and the room
									   page reads the file rather than this document. *@
									<span class="room-open room-open-shut">
										<span class="area-title">@RoomName(current)</span>
										@if (current.AreaId is { Length: > 0 } pending)
										{
											<code class="area-slug">@pending</code>
											<span class="area-summary-hint">save to open this room</span>
										}
										else
										{
											@* Only a hand-edited document reaches this state; every path that proposes a room
											   gives it an area id. The picker is the way back, so such a document does not
											   become uneditable. *@
											<span class="badge bad">no area</span>
											<span class="area-summary-hint">@HouseView.RoomSummary(current)</span>
											<span class="room-adopt">
												<AreaPicker Value="@current.AreaId"
															ValueChanged="@(areaId => AdoptArea(current, areaId))"
															Areas="@_addableAreas"
															NoneLabel="(pick this room's area)"
															EmptyNote="@AddEmptyNote" />
											</span>
											<button type="button" class="danger room-drop" @onclick="() => RemoveArea(current)">Remove</button>
										}
									</span>
								}
							</div>

							@* A sibling of the row, not a child: the row is a switch beside a link, and a block of
							   chips inside it breaks both. *@
							@if (SwitchOnNoteFor(current) is { } switchOn)
							{
								<SwitchOnNoteView Note="@switchOn" Dismissed="@(() => DismissSwitchOnNote(current))" />
							}
						}
					</div>
				}

				@if (_config.Areas.Count == 0)
				{
					<div class="empty">No rooms yet. Add one to get started.</div>
				}

				@* Where the board's footer thread lands. Counts them; the list above already names them. *@
				@if (HouseView.SwitchedOffLine(_config.Areas, _config.Defaults) is { Length: > 0 } switchedOff)
				{
					<p class="rooms-off">@switchedOff</p>
				}
			}
			else if (_section == Section.Schedule)
			{
				<header class="section-head">
					<h2><Icon Name="@Glyph.Schedule" Class="ic-head" />Schedule</h2>
					<p class="lede">
						How bright and how warm the lights are through the day. One schedule for the whole house.
					</p>
				</header>

				@* No glyph on this card head: the section header a hundred pixels above already carries it. *@
				<section class="panel room-card house-card">
					<div class="room-card-head">
						<span class="room-card-title">Through the day</span>
						<span class="room-card-note">one rhythm for the whole house</span>
					</div>

					<div class="house-chart">
						<DaylightChart Periods="@_config.Periods" Location="@_homeLocation" />
					</div>

					@* One token, not a switch beside a number: blending off and blending over nothing are the same
					   instruction. *@
					<div class="room-sentences">
						<SentenceView Sentences="@_blendSentence"
									  Edited="@OnGlobalEdited"
									  Note="@TokenNote"
									  ShowLegend="false" />
					</div>
				</section>

				<PeriodsEditor Periods="@_config.Periods"
							   Changed="@Revalidate"
							   HouseModeOptions="@_houseModeOptionValues"
							   HouseMode="@_config.Global.HouseMode"
							   Global="@_config.Global" />

				@* Under the table, and open only when already in use: then it is what decides what the table means. *@
				<GroupFold Title="Connect existing Selection from Home Assistant (must be an Input-Select)"
						   Description="@PeriodSelectSummary"
						   Open="@(_config.Global.PeriodSelect?.EntityId is not null)">
					<PeriodSelectPanel Global="@_config.Global"
									   Periods="@_config.Periods"
									   InputSelects="@_inputSelects"
									   LiveOptions="@_livePeriodSelectOptions"
									   ActiveValue="@_activePeriodValue"
									   IsAvailable="@Catalog.Knows(_config.Global.PeriodSelect?.EntityId)"
									   IsReady="@HomeAssistantIsAnswering"
									   EmptyNote="@EmptyNote("No dropdown helpers yet — make one in Home Assistant under Settings → Devices & services → Helpers, or type an id.")"
									   NameResolver="@Name"
									   KnownResolver="@Catalog.Knows"
									   EntityChanged="@SetPeriodSelectEntity"
									   Changed="@Revalidate" />
				</GroupFold>
			}
			else if (_section == Section.HouseModes)
			{
				@* One dropdown helper carries the house's modes; each option is tagged with what it means. *@
				<header class="section-head">
					<h2><Icon Name="@Glyph.Modes" Class="ic-head" />House modes</h2>
					<p class="lede">
						The house mode lives in a Home Assistant dropdown helper. Pick the helper, then say what each
						of its options means &mdash; Normal, Sleep, Away or Guest. You switch modes on the
						<a href="/">dashboard</a>.
					</p>
				</header>

				<div class="panel">
					@* The same picker and direction switch the period select carries, and for the same reason: which
					   side owns the dropdown decides what everything under it means. *@
					<SelectAuthorityPanel Label="House mode"
										  Entity="@_config.Global.HouseMode?.Entity"
										  EntityChanged="@SetHouseModeEntity"
										  Entities="@_inputSelects"
										  NameResolver="@Name"
										  KnownResolver="@Catalog.Knows"
										  NoneLabel="(none — the house has no modes)"
										  EmptyNote="@EmptyNote("No dropdown helpers yet — make one in Home Assistant under Settings → Devices & services → Helpers, or type an id.")"
										  Placeholder="input_select.husmodus"
										  Group="housemode-authority"
										  AuthorityLabel="Changes to the house mode are set by:"
										  HomeAssistant="@(_config.Global.HouseMode?.Authority == HouseModeAuthority.HomeAssistant)"
										  HomeAssistantChanged="@SetHouseModeAuthority"
										  AuthorityNote="@HouseModeAuthorityNote"
										  UnavailableNote="@HouseModeUnavailableNote"
										  IsAvailable="@Catalog.Knows(_config.Global.HouseMode?.EntityId)"
										  IsReady="@HomeAssistantIsAnswering"
										  LiveOptions="@_liveSelectOptions">
						<LabelHelp>
							Which dropdown helper holds this house's modes. Picking one reads its options into the
							cards below: an option the new helper also offers keeps its settings, the rest are dropped.
							No helper yet? Make one in Home Assistant under <strong>Settings → Devices &amp; services →
							Helpers → Create helper → Dropdown</strong>, add your options, then pick it here.
						</LabelHelp>
						<Note>
							Without one the house is always in everyday lighting. Say below what each option means.
						</Note>
						<AuthorityHelp>
							<strong>Home Assistant</strong> means the dropdown is the only thing that moves the house:
							the engine reads it, applies whatever the option means, and never writes it back.
							<strong>Adaptive lighting</strong> means the engine may set the mode itself &mdash; from a
							period, from a switch you name, or after a long enough quiet spell &mdash; and keeps the
							dropdown pointing at the answer.
						</AuthorityHelp>
						<Body Context="state">
							@{
								string modeEntity = _config.Global.HouseMode?.EntityId ?? "";
							}

							@*
								Where the helper's list and this one part company. It reports and offers; it never adopts by
								itself, because the thing it would rewrite unasked is the list every mode hangs off.

								All three states render, including the two that ask for nothing: an unreachable Home Assistant
								cannot tell an empty helper from no answer, so it must say so instead of showing a stale offer.
							*@
							@if (_helperDiff.Differs)
							{
								<div class="notice warn modes-sync">
									<strong>@HouseModeSync.Title(_helperDiff)</strong>
									@* The entity leads the sentence: a <code> chip's own padding floats a trailing full
									   stop a space away from it. *@
									<span>The helper <code>@modeEntity</code> now offers something else. @HouseModeSync.Summary(_helperDiff)</span>
									<span>
										An option the helper still offers keeps everything you set on it &mdash; what it
										means, its scene, its resets.
									</span>
									<div class="panel-actions">
										<button type="button" class="primary" @onclick="UseHelperOptions">
											Use the helper's options
										</button>
									</div>
									<span class="hint">
										Nothing is written until you press <em>Save and apply</em> &mdash;
										<em>Discard changes</em> undoes it.
									</span>
								</div>
							}
							else if (_helperDiff.Matches)
							{
								<p class="hint"><code>@modeEntity</code> offers exactly these options.</p>
							}
							else
							{
								<p class="hint">
									Home Assistant hasn't said which options <code>@modeEntity</code> has, so this list
									can't be compared with it. Nothing here is out of date &mdash; it simply can't be
									checked until the connection is back.
								</p>
							}

							@* Named, not merely counted: a rule that has quietly stopped firing is what somebody comes
							   back here to work out, and the controls for these live on three different cards. *@
							@if (DormantRules.Any)
							{
								<div class="notice warn mode-dormant-rules">
									<strong>These are set up but not firing while Home Assistant decides:</strong>
									<ul>
										@foreach (string rule in DormantRules.Names)
										{
											<li>@rule</li>
										}
									</ul>
									<span>
										They are kept as they are and start working again the moment you hand the house
										mode back to adaptive lighting.
									</span>
								</div>
							}
						</Body>
					</SelectAuthorityPanel>
				</div>

				@* One sentence per mode, over the field-by-field editor. The two tunable durations are tokens; a
				   scene and a period are prose, because they are picked from what Home Assistant has. *@
				@if (_modeLines.Count > 0)
				{
					<section class="panel room-card house-card">
						<div class="room-card-head">
							<span class="room-card-title">What each mode does</span>
							<span class="room-card-note">@_config.Global.HouseMode?.Entity</span>
						</div>

						<div class="house-rules">
							@foreach (ModeLine line in _modeLines)
							{
								ModeLine mode = line;

								<div class="house-rule">
									<b class="house-rule-name">@mode.Name</b>
									<SentenceView Sentences="@mode.Sentences"
												  Edited="@OnModeEdited"
												  Note="@TokenNote"
												  ShowLegend="false" />
									@if (IsActiveMode(mode))
									{
										<span class="house-rule-now">active now</span>
									}
								</div>
							}
						</div>
					</section>
				}

				@* At section level, not inside a .field-control, so the cards stretch to full width. *@
				@if (_config.Global.HouseMode?.Entity is { Length: > 0 })
				{
					<header class="section-head subsection">
						<h3>Mode options
							<InfoPopover Label="Mode options">
								Each option means one thing: Normal, Sleep, Away or Guest. Picking a kind shows only that
								kind's settings. Exactly one option should be Normal — it's what the house returns to.
							</InfoPopover>
						</h3>
					</header>

					<HouseModeOptions HouseMode="@_config.Global.HouseMode"
									  LiveOptions="@_liveSelectOptions"
									  ActiveValue="@_activeModeValue"
									  Periods="@_config.Periods"
									  Scenes="@_scenes"
									  PresenceSensors="@_presenceEntities"
									  DateTimes="@_dateTimes"
									  ActivationEntities="@_activationEntities"
									  NameResolver="@Name"
									  KnownResolver="@Catalog.Knows"
									  IsReady="@HomeAssistantIsAnswering"
									  HomeAssistantDecides="@HouseModeIsHomeAssistants"
									  Changed="@OnHouseModeOptionsChanged" />
				}
			}
			else
			{
				@*
					House holds the settings there is exactly one of. That is the membership rule: there is one
					Defaults block and one of each label and device-class setting in the whole document, and no
					per-room twin of any of them.

					Every group here is a GroupFold, with no exceptions and none open by default: the section is its
					own table of contents. Ordered by what you come back to, then what you set once, then what you
					read only when something looks wrong.

					The engine and connection warning and the validation errors stay above the section rail, where a
					fault cannot hide inside a group nobody opened.
				*@
				<header class="section-head">
					<h2><Icon Name="@Glyph.House" Class="ic-head" />House</h2>
					<p class="lede">
						The settings there is one of: what every room starts with, which lights count as a room's,
						what this house is called, who lives in it, and the one switch that pauses everything.
					</p>
				</header>

				@* Flush, because everything inside already spans the fold. *@
				<GroupFold Title="Every room starts with these"
						   Description="How long lights stay on, how a room decides it's dark, and how it behaves. A room's own settings win."
						   Flush="true">
					<div class="room-sentences">
						<SentenceView Sentences="@AreaSentences.ForDefaults(_config.Defaults)"
									  Edited="@OnDefaultEdited"
									  Note="@TokenNote"
									  ShowLegend="false" />
					</div>

					<div class="room-morebar">
						<button type="button"
								class="room-more"
								aria-expanded="@(_showAllRooms ? "true" : "false")"
								@onclick="() => _showAllRooms = !_showAllRooms">
							All settings @(_showAllRooms ? "▴" : "▾")
						</button>
						<span class="room-more-note">@HouseView.StrayLine(_config.Areas, Catalog.AreaRegistry)</span>
					</div>

					@if (_showAllRooms)
					{
						<div class="room-groups">
							@foreach (RoomSettingGroup group in RoomSettings.Groups)
							{
								RoomSettingGroup current = group;
								bool open = IsOpen(current);

								<div class="sgroup @(open ? "sgroup-open" : null)">
									<button type="button"
											class="sgroup-head"
											aria-expanded="@(open ? "true" : "false")"
											@onclick="() => Toggle(current)">
										<span class="sgroup-title">@current.Title</span>
										<span class="sgroup-note">@current.Note</span>
										<span class="area-chevron" aria-hidden="true"></span>
									</button>

									@if (open)
									{
										<div class="sgroup-body">
											@* These values are the house, so there is no inherit tag and no road back:
											   a SettingRow with no house text renders neither. *@
											@foreach (RoomSetting setting in current.Settings.Where(item => item.AppliesTo(_config.Defaults)))
											{
												RoomSetting item = setting;

												<SettingRow Label="@item.Label" Help="@item.Help">
													@switch (item.Control)
													{
														case RoomControl.Flag:
															<button type="button"
																	class="switch @(RoomSettings.Flag(null, _config.Defaults, item.Key) ? "on" : null)"
																	role="switch"
																	aria-checked="@(RoomSettings.Flag(null, _config.Defaults, item.Key) ? "true" : "false")"
																	aria-label="@item.Label"
																	@onclick="() => SetHouseFlag(item.Key, !RoomSettings.Flag(null, _config.Defaults, item.Key))">
																<span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
															</button>
															break;

														case RoomControl.Choice:
															<div class="seg" role="group" aria-label="@item.Label">
																@foreach (TokenChoice option in RoomSettings.DarknessOptions)
																{
																	TokenChoice choice = option;
																	<button type="button"
																			class="@(IsCurrentChoice(item.Key, choice) ? "cur" : null)"
																			aria-pressed="@(IsCurrentChoice(item.Key, choice) ? "true" : "false")"
																			@onclick="() => SetHouseChoice(item.Key, choice.Value)">@choice.Text</button>
																}
															</div>
															break;

														case RoomControl.Entity:
															<EntityPicker Value="@RoomSettings.Entity(null, _config.Defaults, item.Key)"
																		  ValueChanged="@(value => SetHouseEntity(item.Key, value))"
																		  Options="@_sunEntities"
																		  NoneLabel="(none — the engine needs one)"
																		  EmptyNote="@EmptyNote("No sun entity found — type an id (normally sun.sun).")"
																		  Placeholder="sun.sun" />
															break;

														default:
															<Stepper Value="@RoomSettings.Shown(null, _config.Defaults, item.Key)"
																	 Text="@RoomSettings.Describe(null, _config.Defaults, item.Key)"
																	 Label="@item.Label"
																	 Step="@item.Step"
																	 Min="@item.Min"
																	 Max="@item.Max"
																	 IsOwn="true"
																	 ValueChanged="@(value => SetHouseNumber(item.Key, value))" />

															@if (string.Equals(item.Key, nameof(AreaSettings.LuxBrightnessGamma), StringComparison.Ordinal))
															{
																@* A shape, not a quantity: the stepper changes it, the glyph says what it means. *@
																<CurveGlyph Exponent="@RoomSettings.Shown(null, _config.Defaults, item.Key)"
																			Label="@CurvePath.Describe(RoomSettings.Shown(null, _config.Defaults, item.Key))" />
															}
															break;
													}
												</SettingRow>
											}
										</div>
									}
								</div>
							}
						</div>
					}
				</GroupFold>

				<GroupFold Title="Finding lights &amp; sensors"
						   Description="Which lights this app may manage, what counts as a sensor, and where the house reads the daylight."
						   Open="@(Engine.SharedLights.Count > 0)">
					@*
						Bulbs more than one room commands, found by the engine as it builds and hung off
						LightingEngineHost.SharedLights. The fold opens itself when there is one; a warning inside a
						closed drawer is shown to nobody.

						"More than one room", not "two": the engine flags a bulb from two claimants upward.
					*@
					@if (Engine.SharedLights is { Count: > 0 } sharedLights)
					{
						<div class="notice warn">
							<strong>
								@(sharedLights.Count == 1
									? "One light is commanded by more than one room."
									: $"{sharedLights.Count} lights are commanded by more than one room.")
							</strong>
							<ul>
								@foreach (SuspectLight shared in sharedLights)
								{
									@* Id beside the name, as SwitchOnNoteView orders it: the reason ends in advice,
									   and a trailing entity id reads as part of that advice. *@
									<li><strong>@shared.Name</strong> <code>@shared.EntityId</code> &mdash; @shared.Reason</li>
								}
							</ul>
						</div>
					}

					<div class="field">
						<div class="field-head">
							<label class="field-label">Only manage lights with (label)
								<InfoPopover Label="Only manage lights with (label)">
									Set it and every light without this label stops being managed, in every room &mdash; useful
									when a room resolves to status LEDs and colour channels as well as lamps. Lights you named
									by hand in a room are managed either way, and <em>Never touch</em> below still wins.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<LabelPicker Value="@_config.Global.IncludeLabel"
										 ValueChanged="@SetIncludeLabel"
										 Options="@_labelOptions"
										 NoneLabel="(none — manage every light that's found)"
										 UnknownNote="No light carries this label yet, so no room will resolve. Label the lights in Home Assistant, or clear this."
										 Placeholder="adaptive" />
						</div>
						<div class="field-help">Empty is the usual answer: every light found is managed.</div>
					</div>

					<div class="field">
						<div class="field-head">
							<label class="field-label">Never touch (label)
								<InfoPopover Label="Never touch (label)">
									Anything carrying this label stops being found: never discovered, never commanded, never
									counted. Put it on the fridge lamp and the router's status LED. A light you named by hand
									in a room is the one thing it does not reach.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<LabelPicker Value="@_config.Global.ExcludeLabel"
										 ValueChanged="@SetExcludeLabel"
										 Options="@_labelOptions"
										 NoneLabel="(none — nothing is excluded)"
										 UnknownNote="Nothing carries this label, so nothing is excluded — that's fine."
										 Placeholder="adaptive-exclude" />
						</div>
						<div class="field-help">This beats the label above: carrying both means the light is left alone.</div>
					</div>

					<div class="field">
						<div class="field-head">
							<label class="field-label">Counts as motion (label)
								<InfoPopover Label="Counts as motion (label)">
									A sensor carrying this label wakes the lights in its room whatever Home Assistant thinks it
									measures. For the odd door or vibration sensor that is really a presence sensor. It adds to
									the device classes below rather than replacing them.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<LabelPicker Value="@_config.Global.MotionLabel"
										 ValueChanged="@SetMotionLabel"
										 Options="@_labelOptions"
										 NoneLabel="(none — device classes decide)"
										 UnknownNote="Nothing carries this label yet, so only the device classes below decide."
										 Placeholder="adaptive-motion" />
						</div>
					</div>

					@* The outdoor sensor lives here, not under the all-rooms Darkness group: it is an input the house
					   discovers darkness with. *@
					<div class="field">
						<div class="field-head">
							<label class="field-label">Outdoor light-level sensor
								<InfoPopover Label="Outdoor light-level sensor">
									Where the house reads the daylight, so darkness follows the clouds rather than the clock.
									A room reads it only when the settings file gives that room <code>FollowOutdoorLux: true</code>
									&mdash; there is no control for that here. A room with a light-level sensor of its own always
									uses that instead.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<EntityPicker Value="@_config.Global.OutdoorLuxSensor"
										  ValueChanged="@(value => SetOutdoorLux(value))"
										  Options="@_luxSensors"
										  NoneLabel="(none — no room can follow the house's daylight)"
										  EmptyNote="@EmptyNote("No light-level sensors found — type an id.")"
										  Placeholder="sensor.ute_lux" />
						</div>
					</div>

					<details class="advanced">
						<summary>Advanced &mdash; what counts as a sensor</summary>

						<div class="field">
							<div class="field-head">
								<label class="field-label">What counts as a motion sensor
									<InfoPopover Label="What counts as a motion sensor">
										Which kinds of binary sensor wake the lights. The built-in set &mdash; motion, occupancy,
										presence &mdash; suits nearly every house. Ticking anything <strong>replaces</strong> that
										set rather than adding to it, so a room can go silent by losing a class you forgot to tick.
									</InfoPopover>
								</label>
							</div>
							<div class="field-control checks">
								@foreach (string deviceClass in _motionDeviceClassChoices)
								{
									string current = deviceClass;
									<label>
										<input type="checkbox"
											   checked="@_config.Global.MotionDeviceClasses.Contains(current, StringComparer.OrdinalIgnoreCase)"
											   @onchange="args => ToggleMotionDeviceClass(current, args.Value is true)" />
										@current
									</label>
								}
							</div>
							<div class="field-help">
								Ticking nothing means the built-in set
								(<code>@string.Join(", ", GlobalConfig.DefaultMotionDeviceClasses)</code>), which is usually right.
								Ticking anything <strong>replaces</strong> that set rather than adding to it, so tick every class
								you want &mdash; including the built-in ones you still need. Currently in effect:
								<code>@string.Join(", ", _config.Global.EffectiveMotionDeviceClasses)</code>.
							</div>
						</div>

						<div class="field">
							<div class="field-head">
								<label class="field-label">What counts as a light-level sensor
									<InfoPopover Label="What counts as a light-level sensor">
										Which kind of sensor a room takes its light reading from. <code>illuminance</code> is
										nearly always right; change it and rooms whose sensor reports something else start
										reading the daylight, and rooms that were reading it stop.
									</InfoPopover>
								</label>
							</div>
							<div class="field-control">
								<select class="cell wide" @bind="_config.Global.IlluminanceDeviceClass">
									@foreach (string deviceClass in _sensorDeviceClasses)
									{
										<option value="@deviceClass">@deviceClass</option>
									}
									@if (!_sensorDeviceClasses.Contains(_config.Global.IlluminanceDeviceClass, StringComparer.OrdinalIgnoreCase))
									{
										<option value="@_config.Global.IlluminanceDeviceClass">@_config.Global.IlluminanceDeviceClass — no sensor here reports this</option>
									}
								</select>
							</div>
							<div class="field-help">What makes a sensor count as a room's light-level reading.</div>
						</div>
					</details>
				</GroupFold>

				@* The sentence carries how long everyone must be gone; the field carries who counts at all. *@
				<GroupFold Title="People"
						   Description="Whose presence decides Home and Away, and how long before the house counts as empty.">
					<SentenceView Sentences="@_awaySentence"
								  Edited="@OnGlobalEdited"
								  Note="@TokenNote"
								  ShowLegend="false" />

					<div class="field">
						<div class="field-head">
							<label class="field-label">Who lives here
								<InfoPopover Label="Who lives here">
									Whose presence decides Home and Away. Empty means everyone Home Assistant knows, including
									people added later &mdash; usually right. Name people only to leave someone out: a car
									tracker or a guest phone that would otherwise keep the house from ever counting as empty.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<EntityListPicker Value="@_config.Global.Persons"
											  ValueChanged="@SetPersons"
											  Options="@_persons"
											  NameResolver="@Name"
											  KnownResolver="@Catalog.Knows"
											  EmptyLabel="Empty — everyone Home Assistant knows, including people added later."
											  AddLabel="Watch someone…"
											  EmptyNote="@EmptyNote("No people found in Home Assistant — type an id.")"
											  Placeholder="person.example" />
						</div>
					</div>
				</GroupFold>

				@* Picked from whatever Home Assistant has: a hand-made helper, or the enable switch NetDaemon's state
				   manager publishes for this app, which is the built-in default when nothing is chosen. *@
				<GroupFold Title="Master switch"
						   Description="Which switch pauses all automatic lighting, and which way round it reads.">
					<p class="group-note">
						On means lights adjust automatically; off pauses everything at once &mdash; nothing is turned off,
						changes just stop. This is the same switch as the On/Off control on the dashboard.
					</p>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Master switch
								<InfoPopover Label="Master switch">
									Which Home Assistant switch pauses everything. Left unset it uses this app's own switch,
									which is what the dashboard's On/Off control flips. Point it at your own toggle to gate the
									app on something else &mdash; an alarm state, a holiday helper.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<EntityPicker Value="@_config.Global.KillSwitchEntity"
										  ValueChanged="@(value => Set(() => _config.Global.KillSwitchEntity = value))"
										  Options="@_switches"
										  NoneLabel="(default — this app's own enable switch)"
										  EmptyNote="@EmptyNote("No switches or toggle helpers found — type an id.")"
										  Placeholder="input_boolean.adaptive_lighting_enabled" />
						</div>
						@if (string.IsNullOrWhiteSpace(_config.Global.KillSwitchEntity))
						{
							@* The built-in switch is an enabled-flag by definition, so the polarity dropdown is hidden
							   and the concrete id shown instead. *@
							<div class="field-help">
								@if (_config.Global.EffectiveKillSwitchEntity is { Length: > 0 } builtIn)
								{
									<span>
										Using <code>@builtIn</code> — the app's own switch in Home Assistant. Turning it off
										pauses the whole app, this page included.
									</span>
								}
								else
								{
									<span>
										Will default to this app's own enable switch once the host has connected to Home Assistant.
									</span>
								}
							</div>
						}
						else
						{
							@* Bound through strings, not straight to the bool: @bind writes "True"/"False", neither
							   option matches, and the select renders with nothing chosen. *@
							<div class="field-control">
								<select class="cell wide"
										@bind:get="@(_config.Global.KillSwitchActiveWhenOff ? "true" : "false")"
										@bind:set="SetKillSwitchPolarity">
									<option value="true">on lets lights adjust, off pauses everything</option>
									<option value="false">off lets lights adjust, on pauses everything</option>
								</select>
							</div>
							<div class="field-help">
								Which way round this switch reads. Get it backwards and the house pauses exactly when it
								should be working. This switch replaces the app's own.
							</div>
						}
					</div>
				</GroupFold>

				@* One field, and a fold of its own: a name is not a tuning knob. *@
				<GroupFold Title="House name"
						   Description="What this house is called in logs and notifications.">
					<div class="field">
						<div class="field-head">
							<label class="field-label">House name
								<InfoPopover Label="House name">
									A label for logs and notifications, so two houses can be told apart.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control"><input class="cell wide" @bind="_config.ConfigName" placeholder="Adaptive lighting" /></div>
					</div>
				</GroupFold>

				<GroupFold Title="Fine tuning"
						   Description="How often rooms re-check, how the engine tells its own changes from a person's, and how close is close enough.">
					@* NetDaemonUserId is write-only: rendered as set or not-set, never as its value, in either
					   direction. The input starts empty and overwrites the stored value only when typed into. *@
					<div class="field">
						<div class="field-head">
							<label class="field-label">NetDaemon user id
								<InfoPopover Label="NetDaemon user id">
									The Home Assistant user this app connects as &mdash; find it under Settings → People, on
									the token's user. Naming it lets a light change be recognised as the app's own by who made
									it. Left unset, that is judged by timing alone, so a person at a switch during the window
									below can be mistaken for the app.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							@if (string.IsNullOrWhiteSpace(_config.Global.NetDaemonUserId))
							{
								<span class="badge">not set</span>
								<span class="hint">manual changes are told apart by timing alone.</span>
							}
							else
							{
								<span class="badge ok">set</span>
								<span class="hint">the stored value is never shown, in either direction.</span>
								<button type="button" @onclick="ClearUserId">Clear</button>
							}
						</div>
						<div class="field-control">
							<input class="cell wide" type="password" autocomplete="off" placeholder="type a new value to replace it" @bind="_userIdInput" />
						</div>
					</div>

					<div class="field">
						<div class="field-head">
							<label class="field-label">Re-check the rooms every
								<InfoPopover Label="Re-check the rooms every">
									How often each room re-reads the time of day and the light outside, in seconds. 60 is
									plenty; shorter makes dusk arrive sooner but costs a pass over every room each time.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<input class="cell num" type="number" min="1" @bind="_config.Global.CircadianTickSeconds" /> <span class="unit">s</span>
						</div>
					</div>

					<div class="field">
						<div class="field-head">
							<label class="field-label">Recognise own changes for
								<InfoPopover Label="Recognise own changes for">
									A light that changes within this many seconds of one of the app's own commands is read as
									the echo of that command, not as somebody at a switch. Too short and the app mistakes
									itself for a person and backs off; too long and a real manual change is ignored. 8 s suits
									most houses.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control">
							<input class="cell num" type="number" min="0" @bind="_config.Global.SelfEchoWindowSeconds" /> <span class="unit">s</span>
						</div>
					</div>

					<div class="field">
						<div class="field-head">
							<label class="field-label">Other automations count as manual changes
								<InfoPopover Label="Other automations count as manual changes">
									Ticked, a light another automation changes is treated as a manual change: this app stands
									back for as long as <em>Manual changes hold for</em> says. Unticked, it corrects the light on
									the next re-check and keeps winning.
								</InfoPopover>
							</label>
						</div>
						<div class="field-control checks">
							<label><input type="checkbox" @bind="_config.Global.TreatAutomationsAsManual" /> a change from another automation counts as a manual change</label>
						</div>
					</div>

				</GroupFold>

				<GroupFold Title="This installation"
						   Description="Whether the engine is running, whether Home Assistant is answering, and where the settings file is kept.">
					<div class="status-row">
						<span class="status-label">Engine</span>
						@if (Engine.IsRunning)
						{
							<span class="badge ok">running</span>
							<span>@Engine.RunningAreaCount @(Engine.RunningAreaCount == 1 ? "room" : "rooms") managed.</span>
						}
						else
						{
							<span class="badge bad">not running</span>
							<span>@(Engine.Fault ?? "Not started yet.")</span>
						}
					</div>
					<div class="status-row">
						<span class="status-label">File</span>
						<code>@Location.Path</code>
						<span class="badge">@Describe(Location.Source)</span>
						@if (Engine.Store.HasBackup)
						{
							<span class="hint">previous version kept at <code>@Engine.Store.BackupPath</code></span>
						}
					</div>
					<div class="status-row">
						<span class="status-label">Home Assistant</span>
						@if (HomeAssistantIsAnswering)
						{
							<span class="badge ok">connected</span>
							<span>@_areas.Count @(_areas.Count == 1 ? "area" : "areas") known.</span>
						}
						else
						{
							<span class="badge bad">not connected</span>
							<span>You can still type ids by hand; they are not checked against Home Assistant if you save now.</span>
						}
					</div>
				</GroupFold>
			}
		</div>
	</div>
}

@code {
	/// <summary>The page's four sections. One is shown at a time; the rail switches.</summary>
	private enum Section
	{
		Areas,
		Schedule,
		HouseModes,
		House
	}

	// SentenceView has no default for this on purpose: only the page knows whether a pick waits behind a save bar.
	private const string TokenNote = "Applies when you save. Discard changes puts it back.";

	private AdaptiveLightingConfig _config = new();
	private ValidationResult? _liveValidation;
	private SaveResult? _result;
	private string? _loadError;
	private string? _userIdInput;
	private bool _busy;
	private Section _section = Section.Areas;

	// Only the success confirmation is transient. Errors and failed saves render through _liveValidation and
	// _result, and stay until resolved.
	private string? _saveConfirmation;
	private CancellationTokenSource? _confirmationCts;

	// Read once per page load, not once per area: the lists are identical for every area.
	private IReadOnlyList<AreaOption> _areas = [];
	private IReadOnlyList<AreaOption> _addableAreas = [];
	private IReadOnlyList<EntityOption> _luxSensors = [];
	private IReadOnlyList<EntityOption> _sunEntities = [];
	private IReadOnlyList<EntityOption> _persons = [];
	private IReadOnlyList<EntityOption> _switches = [];
	private IReadOnlyList<EntityOption> _inputSelects = [];
	private IReadOnlyList<EntityOption> _scenes = [];
	private IReadOnlyList<EntityOption> _motionSensors = [];
	private IReadOnlyList<EntityOption> _presenceEntities = [];
	private IReadOnlyList<EntityOption> _dateTimes = [];
	private IReadOnlyList<EntityOption> _activationEntities = [];
	private IReadOnlyList<string> _liveSelectOptions = [];
	private IReadOnlyList<string> _houseModeOptionValues = [];
	private string? _activeModeValue;

	// Read separately from the house mode's: two different helpers, and comparing one document's option strings
	// against the other's list reports renames that never happened.
	private IReadOnlyList<string> _livePeriodSelectOptions = [];
	private string? _activePeriodValue;

	// Starts as "cannot compare", which is what a page that has read nothing yet knows.
	private HouseModeOptionsDiff _helperDiff = new(false, [], []);
	private (double Latitude, double Longitude)? _homeLocation;
	private IReadOnlyList<LabelOption> _labelOptions = [];
	private IReadOnlyList<string> _sensorDeviceClasses = [];
	private IReadOnlyList<string> _motionDeviceClassChoices = [];

	// Rebuilt with the document, not during render: this page re-renders on every keystroke.
	private IReadOnlyList<Sentence> _blendSentence = [];
	private IReadOnlyList<Sentence> _awaySentence = [];
	private IReadOnlyList<ModeLine> _modeLines = [];

	// Also rebuilt with the document: grouping asks the registry for a floor per area.
	private IReadOnlyList<FloorGroup<AreaConfig>> _areaGroups = [];

	private readonly Dictionary<AreaConfig, string> _roomNames = [];

	// Keyed by area id with a name fallback, the same join the snapshot cache uses. Read from the cache, never
	// subscribed to: a live re-render mid-edit costs the thing being edited.
	private IReadOnlyDictionary<string, AreaState> _liveStates = new Dictionary<string, AreaState>(StringComparer.Ordinal);

	// Null means the re-setup panel is closed; otherwise these are the rooms it opens with ticked.
	private IReadOnlyCollection<string>? _setupScope;
	private string? _setupNote;

	// _unsaved holds rooms added since the last save. They cannot be opened: the room page reads the document from
	// disk, not from here.
	private bool _addingRoom;
	private string? _addAreaId;
	private readonly HashSet<string> _unsaved = new(StringComparer.Ordinal);

	// Per visit, never persisted: advice about the house as it is right now.
	private readonly Dictionary<string, SwitchOnNote> _switchOnNotes = new(StringComparer.Ordinal);
	private readonly HashSet<string> _switchOnRead = new(StringComparer.Ordinal);

	// The all-rooms detail view: revealed on demand, and the sections a reader has opened or closed inside it.
	private bool _showAllRooms;
	private readonly HashSet<string> _openedGroups = new(StringComparer.Ordinal);

	/// <summary>
	///     Whether Home Assistant is answering, as opposed to merely not throwing.
	/// </summary>
	/// <remarks>
	///     <see cref="HaCatalog.IsHomeAssistantReady"/> only reports whether a read threw. The registry does not throw
	///     when it has nothing; it answers with an empty list. Checking that something came back covers both.
	/// </remarks>
	private bool HomeAssistantIsAnswering =>
		Catalog.IsHomeAssistantReady && (_areas.Count > 0 || _luxSensors.Count > 0 || _switches.Count > 0);

	/// <summary>
	///     Which section to open on load, from <c>?section=</c>. Read once; after that the rail owns the choice.
	/// </summary>
	[Parameter]
	[SupplyParameterFromQuery(Name = "section")]
	public string? SectionQuery { get; set; }

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		Reload();

		if (Resolve(SectionQuery) is { } requested)
			_section = requested;
	}

	/// <summary>
	///     The section a <c>?section=</c> value names, or <c>null</c> when it names none.
	/// </summary>
	/// <remarks>
	///     Renamed sections keep answering to their old names, each alias pointing at wherever its contents are now.
	///     Old bookmarks land somewhere sensible instead of looking broken.
	/// </remarks>
	private static Section? Resolve(string? query)
	{
		if (string.IsNullOrWhiteSpace(query))
			return null;

		if (Enum.TryParse(query, ignoreCase: true, out Section requested) && Enum.IsDefined(requested))
			return requested;

		return query.Trim().ToLowerInvariant() switch
		{
			"periods" => Section.Schedule,
			"defaults" => Section.House,
			"rooms" => Section.Areas,
			"advanced" => Section.House,
			"people" => Section.House,
			_ => null
		};
	}

	private void Show(Section section) => _section = section;

	private string? ActiveClass(Section section) => _section == section ? "active" : null;

	private void Reload()
	{
		_result = null;
		_userIdInput = null;
		CloseSetup();
		CloseAdd();
		_unsaved.Clear();
		_setupNote = null;

		try
		{
			_config = Engine.Store.Load();
			_loadError = null;
		}
		catch (LightingConfigException exception)
		{
			_loadError = exception.Message;
			return;
		}

		LoadCatalog();
		Revalidate();
		MarkClean();

		// After the catalog, which it needs; after MarkClean, because raising a note must not arm the save bar.
		RaiseStandingNotes();
	}

	private void StartFromScratch()
	{
		_config = new AdaptiveLightingConfig();
		_loadError = null;
		LoadCatalog();
		Revalidate();
	}

	private void LoadCatalog()
	{
		// The catalog caches discovery per load, so a re-read document needs a re-read registry.
		Catalog.Invalidate();

		// Areas are labelled with what discovery resolves in each, so the conventions come from the document being
		// edited, not from a default.
		_areas = Catalog.Areas(_config.Global);
		_labelOptions = Catalog.LabelOptions();
		_sunEntities = Catalog.EntitiesInDomains("sun");
		_persons = Catalog.EntitiesInDomains("person", "device_tracker");
		_switches = Catalog.EntitiesInDomains("input_boolean", "switch");
		_inputSelects = Catalog.EntitiesInDomains("input_select");
		_scenes = Catalog.EntitiesInDomains("scene");
		_dateTimes = Catalog.DateTimeEntities();
		_activationEntities = Catalog.EntitiesInDomains("input_boolean", "switch", "binary_sensor");
		_liveSelectOptions = Catalog.SelectOptionsOf(_config.Global.HouseMode?.Entity);
		_activeModeValue = Catalog.CurrentStateOf(_config.Global.HouseMode?.Entity);
		_houseModeOptionValues = HouseModeOptionValues();
		_livePeriodSelectOptions = Catalog.SelectOptionsOf(_config.Global.PeriodSelect?.EntityId);
		_activePeriodValue = Catalog.CurrentStateOf(_config.Global.PeriodSelect?.EntityId);
		_homeLocation = HomeGeo.TryRead();
		_sensorDeviceClasses = Catalog.SensorDeviceClasses();

		// Offer what discovery would accept, so an explicit list corrects discovery instead of listing every binary
		// sensor in the house.
		_motionSensors = Catalog.EntitiesWithDeviceClass("binary_sensor", [.. _config.Global.EffectiveMotionDeviceClasses]);
		_luxSensors = Catalog.EntitiesWithDeviceClass("sensor", [_config.Global.IlluminanceDeviceClass]);

		// The presence-reset override picker: discovered motion sensors plus person entities.
		_presenceEntities = [.. _motionSensors.Concat(Catalog.EntitiesInDomains("person"))];

		// Union with the engine's defaults, so the built-in classes stay tickable in a house that reports none of
		// them today.
		_motionDeviceClassChoices =
		[
			.. Catalog.BinarySensorDeviceClasses()
				.Concat(GlobalConfig.DefaultMotionDeviceClasses)
				.Distinct(StringComparer.OrdinalIgnoreCase)
				.OrderBy(deviceClass => deviceClass, StringComparer.Ordinal)
		];
	}

	/// <summary>
	///     Whether the document in memory differs from the one on disk.
	/// </summary>
	/// <remarks>
	///     Compared against a serialised snapshot, never set by a flag each edit path remembers. A dozen paths change
	///     this document, and one that forgot the flag would leave an edit with no way to save it.
	/// </remarks>
	private bool _dirty;

	/// <summary>The serialised document as it was when it last matched the file, or <c>null</c> if it never has.</summary>
	private string? _cleanDocument;

	/// <summary>
	///     Whether the save bar has anything to say: an unsaved edit, a refusal that has not been resolved, or a
	///     confirmation still on screen.
	/// </summary>
	/// <remarks>
	///     <see cref="_userIdInput"/> is checked separately: it is not part of the document until the save applies it,
	///     so a typed id leaves <see cref="_dirty"/> false and would otherwise have no way to be written.
	/// </remarks>
	private bool ShowSaveBar =>
		_dirty
		|| !string.IsNullOrWhiteSpace(_userIdInput)
		|| _saveConfirmation is { Length: > 0 }
		|| _result is { Written: false };

	/// <summary>Records the document as matching the file, after a load and after a save that wrote.</summary>
	private void MarkClean()
	{
		_cleanDocument = Snapshot();
		_dirty = false;
	}

	/// <summary>
	///     The document as text, or <c>null</c> when it cannot be serialised.
	/// </summary>
	/// <remarks>Null counts as changed, so the bar shows and the save reports the real error.</remarks>
	private string? Snapshot()
	{
		try
		{
			return LightingConfigDocument.Serialize(_config);
		}
		catch (LightingConfigException)
		{
			return null;
		}
	}

	private void Revalidate()
	{
		string? current = Snapshot();
		_dirty = current is null || _cleanDocument is null || !string.Equals(current, _cleanDocument, StringComparison.Ordinal);

		_liveValidation = Engine.Validate(_config);
		_blendSentence = [HouseSentences.Blend(_config.Global)];
		_awaySentence = [HouseSentences.AwayDebounce(_config.Global)];
		_modeLines = HouseSentences.Modes(_config.Global.HouseMode, _config.Periods);

		// Recomputed here, not at each place that could move it: they all end in a Revalidate, and a comparison
		// refreshed at only some of them outlives what it was calling for.
		_helperDiff = HouseModeSync.Compare(_config.Global.HouseMode, _liveSelectOptions);
		_addableAreas = HouseView.Unconfigured(_areas, _config.Areas);
		RegroupAreas();
		RefreshLiveStates();
	}

	/// <summary>
	///     Groups the rooms by floor through the helper the board shares, so the two pages can never disagree.
	/// </summary>
	/// <remarks>
	///     A registry that has not connected throws instead of answering, so GroupOrFlat degrades to one unnamed
	///     group and the list renders flat instead of not at all.
	/// </remarks>
	private void RegroupAreas()
	{
		_areaGroups = FloorGrouping.GroupOrFlat(_config.Areas, area => area.AreaId, Catalog.AreaRegistry);

		// Names come from the same registry read as the floors, and go stale at the same moment: the next edit.
		_roomNames.Clear();

		foreach (AreaConfig area in _config.Areas)
			_roomNames[area] = HouseView.DisplayName(area, Catalog.AreaRegistry);
	}

	/// <summary>The live state of each room the cache has heard from, keyed by area id and falling back to its name.</summary>
	private void RefreshLiveStates()
	{
		Dictionary<string, AreaState> states = new(StringComparer.Ordinal);

		foreach (AreaSnapshot snapshot in Cache.Snapshots)
			states[snapshot.AreaId is { Length: > 0 } areaId ? areaId : snapshot.AreaName] = snapshot.State;

		_liveStates = states;
	}

	/// <summary>
	///     What a room is doing right now, or <c>null</c> when nothing has been heard about it.
	/// </summary>
	/// <remarks>
	///     By area id first: ids do not change while a page is open and display names do. The name fallback covers a
	///     room configured with explicit entities and events from builds whose snapshots carried no id.
	/// </remarks>
	private AreaState? LiveStateOf(AreaConfig area)
	{
		if (area.AreaId is { Length: > 0 } areaId && _liveStates.TryGetValue(areaId, out AreaState byId))
			return byId;

		return _liveStates.TryGetValue(RoomName(area), out AreaState byName) ? byName : null;
	}

	// ===================== the room list =====================

	/// <summary>
	///     A room's own page, or <c>null</c> when there is nothing to open yet.
	/// </summary>
	/// <remarks>
	///     A room with no area has no route. A room added since the last save has none yet: the room page loads from
	///     disk, so the link would land on "no such room".
	/// </remarks>
	private string? RoomLink(AreaConfig area) =>
		area.AreaId is { Length: > 0 } areaId && !_unsaved.Contains(areaId) ? HouseView.RoomHref(areaId) : null;

	/// <summary>
	///     What a room is called in this list, matching the board, the log and the room's own page.
	/// </summary>
	/// <remarks>
	///     Read from the map built with the document, not per render: each row asks three times, this page re-renders
	///     on every keystroke, and the registry throws until Home Assistant has connected. A room added since the last
	///     rebuild falls back to the document alone, one render behind and never wrong.
	/// </remarks>
	private string RoomName(AreaConfig area) =>
		_roomNames.TryGetValue(area, out string? name) ? name : HouseView.DisplayName(area, null);

	private static string ToggleTitle(bool enabled) => enabled
		? "On — the lights in this room are managed. Switch off to leave them alone."
		: "Off — this room is watched but its lights are never changed.";

	/// <summary>
	///     Flips a room's power switch, writing an explicit true or false and never null.
	/// </summary>
	/// <remarks>An edit like any other: it arms the save bar, it does not save.</remarks>
	private void ToggleEnabled(AreaConfig area)
	{
		bool switchingOn = !AreaView.IsEnabled(area, _config.Defaults);
		area.Enabled = switchingOn;
		Revalidate();

		if (switchingOn)
			RaiseSwitchOnNote(area);
		else
			_switchOnNotes.Remove(KeyOf(area));
	}

	/// <summary>
	///     Rebuilds every standing note: the note for a room that is already on, when what it commands looks wrong.
	/// </summary>
	/// <remarks>
	///     The bar is higher here than on the press. A press raises a note for any room commanding more than one
	///     light; opening the page is not a question, so only <see cref="SwitchOnNote.IsWarning"/> earns a panel.
	///
	///     It clears first, and every path that re-reads the document must call it: a note describes the document as
	///     it was when raised, so one held across a re-read is a claim about a file that is no longer open.
	///     <see cref="_switchOnRead"/> survives the rebuild; re-reading a file is not the reader changing their mind.
	/// </remarks>
	private void RaiseStandingNotes()
	{
		_switchOnNotes.Clear();

		foreach (AreaConfig area in _config.Areas)
		{
			if (!AreaView.IsEnabled(area, _config.Defaults))
				continue;

			string key = KeyOf(area);

			if (_switchOnRead.Contains(key))
				continue;

			if (NoteFor(area) is { IsWarning: true } note)
				_switchOnNotes[key] = note;
		}
	}

	/// <summary>
	///     What this room's switch has to say for itself, or <c>null</c> when there is nothing worth saying.
	/// </summary>
	/// <remarks>
	///     One place: the standing pass and the press ask the same question and differ only in which answers they
	///     surface. A second copy of the argument list drifts on the first change to how a room's lights resolve.
	/// </remarks>
	private SwitchOnNote? NoteFor(AreaConfig area) => SwitchOnWarning.For(
		RoomName(area),
		Catalog.LightsIn(area, _config.Defaults, _config.Global),
		_config.Global.IncludeLabel);

	// ===================== what switching a room on will command =====================

	/// <summary>
	///     Works out what a room now commands and, when there is something to say, says it under the room's row.
	/// </summary>
	/// <remarks>
	///     Advisory and after the fact: the switch has already taken effect. A room switched on by "Switch on this
	///     floor" raises nothing, because six notes at once is a wall.
	///
	///     Computed on the press, never during render: it runs the engine's resolver over the room, reading a state
	///     per candidate entity.
	/// </remarks>
	private void RaiseSwitchOnNote(AreaConfig area)
	{
		string key = KeyOf(area);

		if (_switchOnRead.Contains(key))
			return;

		if (NoteFor(area) is { } note)
			_switchOnNotes[key] = note;
	}

	private SwitchOnNote? SwitchOnNoteFor(AreaConfig area) => _switchOnNotes.GetValueOrDefault(KeyOf(area));

	/// <summary>Puts one room's note away for the rest of this visit.</summary>
	private void DismissSwitchOnNote(AreaConfig area)
	{
		string key = KeyOf(area);

		_switchOnNotes.Remove(key);
		_switchOnRead.Add(key);
	}

	/// <summary>
	///     How a room is keyed while the page is open: its area id, or its position for a row that names none.
	/// </summary>
	/// <remarks>A positional key moves when a row is removed. See <see cref="ForgetPositionalNotes"/>.</remarks>
	private string KeyOf(AreaConfig area) =>
		area.AreaId is { Length: > 0 } areaId ? areaId : $"#{_config.Areas.IndexOf(area)}";

	/// <summary>What the floor's bulk action offers: switching a floor off once every room on it is already on.</summary>
	private string FloorAction(FloorGroup<AreaConfig> floor) =>
		AreaView.AllEnabled(floor.Items, _config.Defaults) ? "Switch off this floor" : "Switch on this floor";

	/// <summary>Switches every room on a floor, as an edit: the save bar arms, nothing reaches disk.</summary>
	private void SwitchFloor(FloorGroup<AreaConfig> floor)
	{
		AreaView.SwitchAll(floor.Items, !AreaView.AllEnabled(floor.Items, _config.Defaults));
		Revalidate();
	}

	private void ToggleAddRoom()
	{
		if (_addingRoom)
			CloseAdd();
		else
		{
			_setupNote = null;
			_addingRoom = true;
		}
	}

	private void CloseAdd()
	{
		_addingRoom = false;
		_addAreaId = null;
	}

	/// <summary>
	///     Adds a room for one Home Assistant area.
	/// </summary>
	/// <remarks>
	///     Switched off explicitly, as discovery proposes rooms. The area's name is not copied in: names resolve from
	///     the registry wherever they are shown, so writing one would freeze the room at today's name. What is written
	///     is an area id and a switch, nothing else.
	/// </remarks>
	private void AddRoom(string? areaId)
	{
		if (areaId is not { Length: > 0 })
			return;

		CloseAdd();

		_config.Areas.Add(new AreaConfig { AreaId = areaId, Enabled = false });
		_unsaved.Add(areaId);
		_setupNote = $"{AreaName(areaId)} added, switched off. Save and apply, then open it to set it up.";

		Revalidate();
	}

	/// <summary>
	///     Gives a room with no Home Assistant area one, which is also what gives it a page.
	/// </summary>
	/// <remarks>
	///     Marked unsaved like a newly added room: the room page reads from disk, so the link works only once the file
	///     agrees. The area's name is not copied in, for the reason given on <see cref="AddRoom"/>.
	/// </remarks>
	private void AdoptArea(AreaConfig area, string? areaId)
	{
		if (areaId is not { Length: > 0 })
			return;

		area.AreaId = areaId;
		_unsaved.Add(areaId);
		Revalidate();
	}

	/// <summary>
	///     Takes a room out of the document, and with it every note keyed by where a room sits.
	/// </summary>
	/// <remarks>
	///     Removing a room is normally the room page's act; this covers a room with no area, which has no page. The
	///     removal moves every row after it, and <see cref="KeyOf"/> falls back to a row's position, so the survivor
	///     that slides into the removed index would inherit its note and its dismissal. Positions cannot be re-keyed.
	/// </remarks>
	private void RemoveArea(AreaConfig area)
	{
		_config.Areas.Remove(area);
		ForgetPositionalNotes();
		Revalidate();
	}

	/// <summary>Drops every note and dismissal keyed by a row's position instead of an area id.</summary>
	private void ForgetPositionalNotes()
	{
		foreach (string key in _switchOnNotes.Keys.Where(IsPositional).ToList())
			_switchOnNotes.Remove(key);

		_switchOnRead.RemoveWhere(IsPositional);
	}

	private static bool IsPositional(string key) => key.StartsWith('#');

	// ===================== the all-rooms settings =====================

	/// <summary>Whether a section of the detail view is open. None are, until one is opened.</summary>
	private bool IsOpen(RoomSettingGroup group) => _openedGroups.Contains(group.Title);

	private void Toggle(RoomSettingGroup group)
	{
		if (!_openedGroups.Remove(group.Title))
			_openedGroups.Add(group.Title);
	}

	private bool IsCurrentChoice(string key, TokenChoice choice) =>
		string.Equals(RoomSettings.Choice(null, _config.Defaults, key).ToString(), choice.Value, StringComparison.Ordinal);

	/// <summary>
	///     Applies one edit from the all-rooms sentences. A key it cannot apply means the sentence and the page have
	///     drifted apart, so it is logged instead of silently ignored.
	/// </summary>
	private void OnDefaultEdited(SentenceEdit edit)
	{
		if (!RoomSettings.Apply(_config.Defaults, edit))
		{
			Logger.LogWarning("A sentence offered an edit to {Key}, which the House tab does not know how to apply.", edit.Key);
			return;
		}

		Revalidate();
	}

	private void SetHouseNumber(string key, double value)
	{
		RoomSettings.SetShown(_config.Defaults, key, value);
		Revalidate();
	}

	private void SetHouseFlag(string key, bool value)
	{
		RoomSettings.SetFlag(_config.Defaults, key, value);
		Revalidate();
	}

	private void SetHouseChoice(string key, string value)
	{
		if (!Enum.TryParse(value, out DarknessSource source))
			return;

		_config.Defaults.Darkness = source;
		Revalidate();
	}

	private void SetHouseEntity(string key, string? value)
	{
		RoomSettings.SetEntity(_config.Defaults, key, value);
		Revalidate();
	}

	// ===================== the house's own sentences =====================

	/// <summary>
	///     Applies an edit from a house-wide sentence: the schedule's blend and the away debounce.
	/// </summary>
	/// <remarks>
	///     Blending is one value across two properties. Zero minutes means the lights step at the boundary, which is
	///     what <c>SmoothTransitions</c> off already meant, and the minute count is left alone when it is switched
	///     off so turning it back on restores what it was.
	/// </remarks>
	private void OnGlobalEdited(SentenceEdit edit)
	{
		switch (edit.Key)
		{
			case nameof(GlobalConfig.BlendMinutes):
				int minutes = edit.Integer;
				_config.Global.SmoothTransitions = minutes > 0;

				if (minutes > 0)
					_config.Global.BlendMinutes = minutes;

				break;

			case nameof(GlobalConfig.AwayDebounceMinutes):
				_config.Global.AwayDebounceMinutes = edit.Minutes;
				break;

			default:
				Logger.LogWarning("A house sentence offered an edit to {Key}, which the House tab does not know how to apply.", edit.Key);
				return;
		}

		Revalidate();
	}

	/// <summary>
	///     Applies an edit from a mode sentence. The key carries which option it belongs to.
	/// </summary>
	/// <remarks>Decoded by <see cref="HouseSentences.TryReadModeKey"/>, never parsed here: one file owns both halves.</remarks>
	private void OnModeEdited(SentenceEdit edit)
	{
		if (!HouseSentences.TryReadModeKey(edit.Key, out int index, out string property)
			|| _config.Global.HouseMode is not { } houseMode
			|| index < 0
			|| index >= houseMode.Options.Count)
		{
			Logger.LogWarning("A mode sentence offered an edit to {Key}, which names no option on this document.", edit.Key);
			return;
		}

		HouseModeOptionConfig option = houseMode.Options[index];

		switch (property)
		{
			case nameof(HouseModeOptionConfig.ActivateAfterNoMotionMinutes):
				option.ActivateAfterNoMotionMinutes = edit.Minutes;
				break;

			case nameof(HouseModeOptionConfig.ResetPresenceGraceMinutes):
				option.ResetPresenceGraceMinutes = edit.Minutes;
				break;

			default:
				Logger.LogWarning("A mode sentence offered an edit to {Property}, which the House tab does not know how to apply.", property);
				return;
		}

		Revalidate();
	}

	/// <summary>Whether the house is standing on this mode right now, as Home Assistant reports it.</summary>
	private bool IsActiveMode(ModeLine mode) =>
		_activeModeValue is { Length: > 0 } active
		&& string.Equals(active.Trim(), mode.Name.Trim(), StringComparison.OrdinalIgnoreCase);

	// ===================== setting rooms up again =====================

	/// <summary>
	///     Whether setting rooms up again can be offered. It rebuilds from the registry, so a registry that is not
	///     answering would produce an empty plan.
	/// </summary>
	private bool CanSetUpAgain => HomeAssistantIsAnswering && _setupScope is null;

	private void OpenSetupForEveryRoom()
	{
		_setupNote = null;
		CloseAdd();
		_setupScope = [.. _config.Areas.Select(area => area.AreaId).OfType<string>().Where(areaId => areaId.Length > 0)];
	}

	private void CloseSetup() => _setupScope = null;

	/// <summary>Plans a setup run for the panel. Pure; nothing changes until the plan is confirmed.</summary>
	private SetupPlan PlanSetup(IReadOnlyCollection<string> scope) => Catalog.PlanSetup(_config, scope);

	/// <summary>
	///     Carries out a confirmed setup run against the in-memory document, arming the save bar like any other edit.
	/// </summary>
	private void ApplySetup(SetupPlan plan)
	{
		AreaSetupService.Apply(_config, plan);
		CloseSetup();

		List<string> done = [];

		if (plan.Rebuilds.Count > 0)
			done.Add($"{Rooms(plan.Rebuilds.Count)} rebuilt");

		if (plan.NewAreas.Count > 0)
		{
			done.Add($"{Rooms(plan.NewAreas.Count)} added, switched off");

			foreach (AreaConfig added in plan.NewAreas)
			{
				if (added.AreaId is { Length: > 0 } areaId)
					_unsaved.Add(areaId);
			}
		}

		_setupNote = done.Count == 0
			? "Nothing changed."
			: $"{string.Join(" · ", done)}. Nothing is written yet — press Save and apply, or Discard changes to undo.";

		Revalidate();

		static string Rooms(int count) => $"{count} {(count == 1 ? "room" : "rooms")}";
	}

	/// <summary>The name Home Assistant shows for an area id, for rooms the document does not have yet.</summary>
	private string AreaName(string areaId) =>
		_areas.FirstOrDefault(area => string.Equals(area.Id, areaId, StringComparison.Ordinal))?.Name ?? areaId;

	// ===================== the write path =====================

	private void Save()
	{
		_busy = true;

		// Drop any lingering success toast, so a refused save is never shown next to a stale confirmation.
		_confirmationCts?.Cancel();
		_saveConfirmation = null;

		try
		{
			// Only if something was typed: an untouched box must leave the stored value alone, since the page never
			// had it to give back.
			if (!string.IsNullOrWhiteSpace(_userIdInput))
			{
				_config.Global.NetDaemonUserId = _userIdInput.Trim();
				_userIdInput = null;
			}

			// Read before the save, so the confirmation below can check the file's timestamp actually advanced.
			DateTimeOffset? writtenBefore = Engine.Store.LastWrittenUtc;

			_result = Engine.Save(_config);
			_liveValidation = _result.Validation;

			if (_result.Written)
			{
				DateTimeOffset? writtenAfter = Engine.Store.LastWrittenUtc;
				string savedAt = writtenAfter is { } utc ? utc.ToLocalTime().ToString("HH:mm:ss") : "now";
				bool advanced = writtenAfter is { } a && (writtenBefore is not { } b || a >= b);

				// _result is cleared so the persistent note never restates the toast. A refused save keeps it.
				ShowSaveConfirmation(advanced
					? $"Saved ✓  Written to {System.IO.Path.GetFileName(Engine.Store.FilePath)} at {savedAt}."
					: "Saved, but the file timestamp did not change — check the log.");
				_result = null;

				// Everything on disk now has a page to open.
				_unsaved.Clear();
				_setupNote = null;

				// Re-read so the page shows what is on disk, formatting and all.
				_config = Engine.Store.Load();
				LoadCatalog();
				Revalidate();
				MarkClean();

				// Same order and same reason as Reload: after the catalog, after MarkClean.
				RaiseStandingNotes();
			}
		}
		catch (LightingConfigException exception)
		{
			_loadError = exception.Message;
		}
		finally
		{
			_busy = false;
		}
	}

	/// <summary>
	///     Shows the success confirmation, then clears it after a few seconds.
	/// </summary>
	/// <remarks>A fresh token supersedes any in-flight timer, so rapid saves cannot clear a later confirmation.</remarks>
	private void ShowSaveConfirmation(string message)
	{
		_saveConfirmation = message;

		_confirmationCts?.Cancel();
		_confirmationCts?.Dispose();
		_confirmationCts = new CancellationTokenSource();
		CancellationToken token = _confirmationCts.Token;

		_ = DismissConfirmationAfterDelay(token);
	}

	private async Task DismissConfirmationAfterDelay(CancellationToken token)
	{
		try
		{
			await Task.Delay(TimeSpan.FromSeconds(3.5), token).ConfigureAwait(false);
		}
		catch (TaskCanceledException)
		{
			return;
		}

		_saveConfirmation = null;
		await InvokeAsync(StateHasChanged).ConfigureAwait(false);
	}

	/// <inheritdoc/>
	public void Dispose()
	{
		_confirmationCts?.Cancel();
		_confirmationCts?.Dispose();
	}

	// ===================== the small print =====================

	private void ClearUserId()
	{
		_config.Global.NetDaemonUserId = null;
		Revalidate();
	}

	private void Set(Action mutate)
	{
		mutate();
		Revalidate();
	}

	/// <summary>Which way round the master switch reads, written from the segment the select stands on.</summary>
	private void SetKillSwitchPolarity(string? value) =>
		Set(() => _config.Global.KillSwitchActiveWhenOff = string.Equals(value, "true", StringComparison.Ordinal));

	private void SetOutdoorLux(string? value) =>
		Set(() => _config.Global.OutdoorLuxSensor = string.IsNullOrWhiteSpace(value) ? null : value);

	private void SetIncludeLabel(string? value) => SetLabel(() => _config.Global.IncludeLabel = value);

	// Exclude and motion are non-nullable in the model, so "none" is written as an empty string, not null. The
	// resolver already reads empty as no label: no entity can carry a nameless label, so nothing matches.
	private void SetExcludeLabel(string? value) => SetLabel(() => _config.Global.ExcludeLabel = value ?? string.Empty);

	private void SetMotionLabel(string? value) => SetLabel(() => _config.Global.MotionLabel = value ?? string.Empty);

	/// <summary>
	///     Writes a label field and rebuilds what depends on it.
	/// </summary>
	/// <remarks>
	///     Discovery reads these labels, so an area's counts are only true for the labels in effect when they were
	///     counted. The catalog's cache keys on the labels and notices by itself; the area list is this page's own
	///     snapshot and has to be retaken.
	/// </remarks>
	private void SetLabel(Action mutate)
	{
		mutate();
		_areas = Catalog.Areas(_config.Global);
		Revalidate();
	}

	private void SetPersons(IReadOnlyList<string> persons) =>
		Set(() => _config.Global.Persons = [.. persons]);

	/// <summary>The option values a period's "sets mode" dropdown may reference: live ∪ configured, deduped.</summary>
	private IReadOnlyList<string> HouseModeOptionValues() =>
	[
		.. _liveSelectOptions
			.Concat(_config.Global.HouseMode?.Options.Select(option => option.Value) ?? [])
			.Where(value => !string.IsNullOrWhiteSpace(value))
			.Select(value => value.Trim())
			.Distinct(StringComparer.OrdinalIgnoreCase)
	];

	private void SetHouseModeEntity(string? value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			// Leave the object (its option tags may still be wanted); ConfigNormalizer drops it on save if empty.
			if (_config.Global.HouseMode is { } existing)
				existing.Entity = null;
		}
		else
		{
			// Lazily created the first time an entity is picked, so a never-adopted document acquires no block.
			(_config.Global.HouseMode ??= new HouseModeConfig()).Entity = value;
		}

		_liveSelectOptions = Catalog.SelectOptionsOf(_config.Global.HouseMode?.Entity);
		AdoptHelperOptions();
		_activeModeValue = Catalog.CurrentStateOf(_config.Global.HouseMode?.Entity);
		_houseModeOptionValues = HouseModeOptionValues();
		Revalidate();
	}

	/// <summary>Sets which side owns the house mode. Every option keeps what it means in both directions.</summary>
	// Creating the block here is safe: ConfigNormalizer drops one carrying nothing but a non-default Authority.
	private void SetHouseModeAuthority(bool homeAssistant)
	{
		(_config.Global.HouseMode ??= new HouseModeConfig()).Authority =
			homeAssistant ? HouseModeAuthority.HomeAssistant : HouseModeAuthority.AdaptiveLighting;

		Revalidate();
	}

	/// <summary>Whether Home Assistant owns the house mode, so the engine's own ways of setting it stand down.</summary>
	private bool HouseModeIsHomeAssistants => ModeAuthority.HomeAssistantDecides(_config.Global);

	/// <summary>What the document still configures that the authority has stood down.</summary>
	private DormantModeRules DormantRules => ModeAuthority.Dormant(_config.Global, _config.Periods);

	private string HouseModeAuthorityNote => HouseModeIsHomeAssistants
		? "The engine reads this dropdown and never writes it. It still applies what each option means — the scene, "
			+ "the sleep dimming, the sweep — but nothing here moves the house between them."
		: "The engine may set this dropdown itself, from a period, a switch you name, or a quiet house, and applies "
			+ "what the option means either way. Moving it by hand still works.";

	private string HouseModeUnavailableNote => HouseModeIsHomeAssistants
		? "Until it appears, the house stays in everyday lighting and nothing can change the mode. Check the id for a typo."
		: "Until it appears, the engine has nowhere to write the mode, so it stays in everyday lighting. Check the id for a typo.";

	/// <summary>
	///     Picks the helper that carries the time of day, and re-reads what that helper offers.
	/// </summary>
	/// <remarks>
	///     The panel writes every other <c>PeriodSelect</c> field itself. This one is here because it changes what the
	///     panel is drawn from, and only the page reads the catalog.
	///
	///     The mappings are not rebuilt from the new helper, where the house-mode picker does adopt. A period mapping
	///     is one string pointing at another, so adopting would invent mappings nobody chose.
	/// </remarks>
	private void SetPeriodSelectEntity(string? value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			// Leave the object; the mappings may still be wanted. ConfigNormalizer drops it on save if empty.
			if (_config.Global.PeriodSelect is { } existing)
				existing.Entity = null;
		}
		else
		{
			// Lazily created the first time a helper is picked, so a never-adopted document acquires no block.
			(_config.Global.PeriodSelect ??= new PeriodSelectConfig()).Entity = value;
		}

		_livePeriodSelectOptions = Catalog.SelectOptionsOf(_config.Global.PeriodSelect?.EntityId);
		_activePeriodValue = Catalog.CurrentStateOf(_config.Global.PeriodSelect?.EntityId);
		Revalidate();
	}

	/// <summary>
	///     The period-select fold's header line. It carries the direction, because that is what decides whether the
	///     start times in the table above mean anything.
	/// </summary>
	private string PeriodSelectSummary
	{
		get
		{
			if (_config.Global.PeriodSelect?.EntityId is not { } entity)
				return "not connected — the schedule's start times decide the time of day";

			int mapped = _config.Global.PeriodSelect.Options.Count(option => !option.IsEmpty);
			string rows = mapped == 1 ? "1 option mapped" : $"{mapped} options mapped";

			return Schedule.HomeAssistantDecides(_config.Global)
				? $"{entity} decides the time of day · {rows}"
				: $"{entity} is kept in step with the schedule · {rows}";
		}
	}

	/// <summary>
	///     Rebuilds the mode list from the helper, on the pick and on request from the panel.
	/// </summary>
	/// <remarks>
	///     The merge is <see cref="HouseModeSync.Adopt"/>, never a copy of it. Both callers must keep a surviving
	///     option's whole configuration and both must refuse an empty live list; this is the one edit that can destroy
	///     a mode's settings.
	/// </remarks>
	private void AdoptHelperOptions() => HouseModeSync.Adopt(_config.Global.HouseMode, _liveSelectOptions);

	/// <summary>
	///     Takes the helper's option list on request: the explicit half of what picking a helper does silently.
	/// </summary>
	/// <remarks>
	///     Reachable only from the panel, which appears only when the lists differ and Home Assistant has answered.
	///     <see cref="AdoptHelperOptions"/> refuses an empty live list on its own account too, so a connection lost
	///     between render and click cannot empty the list.
	/// </remarks>
	private void UseHelperOptions()
	{
		AdoptHelperOptions();
		OnHouseModeOptionsChanged();
	}

	private void OnHouseModeOptionsChanged()
	{
		_houseModeOptionValues = HouseModeOptionValues();
		Revalidate();
	}

	private void ToggleMotionDeviceClass(string deviceClass, bool on)
	{
		if (on)
		{
			if (!_config.Global.MotionDeviceClasses.Contains(deviceClass, StringComparer.OrdinalIgnoreCase))
				_config.Global.MotionDeviceClasses.Add(deviceClass);
		}
		else
		{
			_config.Global.MotionDeviceClasses.RemoveAll(existing =>
				string.Equals(existing, deviceClass, StringComparison.OrdinalIgnoreCase));
		}

		// All three depend on the class set: the motion picker's contents, the area labels discovery counts, and the
		// presence override picker, which is built from the motion sensors.
		_motionSensors = Catalog.EntitiesWithDeviceClass("binary_sensor", [.. _config.Global.EffectiveMotionDeviceClasses]);
		_presenceEntities = [.. _motionSensors.Concat(Catalog.EntitiesInDomains("person"))];
		_areas = Catalog.Areas(_config.Global);
		Revalidate();
	}

	private string Name(string entityId) => Catalog.FriendlyNameOf(entityId) ?? entityId;

	/// <summary>
	///     The empty-picker note. This page knows why a list is empty and the component does not, so a lost connection
	///     is not reported as an empty domain.
