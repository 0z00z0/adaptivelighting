@page "/config"
@implements IDisposable
@inject LightingEngineHost Engine
@inject HaCatalog Catalog
@inject ConfigLocation Location
@inject HomeLocation HomeGeo
@inject AreaSnapshotCache Cache
@inject ILogger<HousePageModel> Logger
@inject IJSRuntime Js

@* The rooms are a list and not an editor: each row opens /room/{areaId}, the only place a room's settings are
   edited. The write path is the save bar and never a debounce, because every edit here changes something every
   room inherits and several controls are free text a debounce would write half-typed.

   Everything this page knows and does lives in HousePageModel, in the presentation layer, so a second design
   puts its own markup over the same rules. What is left here is markup, styling and the wiring of events to
   that model.

   Two properties this page must never lose. Token safety: the model binds AdaptiveLightingConfig and nothing
   else, never IConfiguration, which carries the Home Assistant long-lived token. One write surface: nothing here names a file path, and
   nothing it posts can. *@

<PageTitle>The house &mdash; Adaptive lighting</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="@Model.HasUnsavedEdits" />

<h1 class="info-host">
	<span class="info-line">
		The house
		<InfoPopover Label="The house">
			Everything that isn't one room: what every room starts with, the day's schedule, the modes, the people
			and the engine itself. Changes apply as soon as they are saved &mdash; no restart needed.
		</InfoPopover>
	</span>
</h1>

@if (Model.LoadError is { Length: > 0 } loadError)
{
	<div class="notice bad info-host">
		<span class="info-line">
			<strong>Settings file unreadable</strong>
			<InfoPopover Label="Settings file" Severity="InfoSeverity.Bad">
				<span class="info-para">@loadError</span>
				<span class="info-para">
					The file is <code>@Model.ConfigFilePath</code>. Fix it by hand, or press <em>Start from scratch</em> &mdash;
					the old file is kept as <code>@Model.BackupPath</code> on save.
				</span>
			</InfoPopover>
		</span>
		<button type="button" @onclick="Model.StartFromScratch">Start from scratch</button>
	</div>
}
else
{
	@* Permanent, not a footnote: a document the next deploy silently reverts makes the UI look broken. *@
	@if (Model.LocationWarning is { Length: > 0 } locationWarning)
	{
		<div class="notice warn info-host">
			<span class="info-line">
				<strong>A deploy overwrites these edits</strong>
				<InfoPopover Label="Settings file" Severity="InfoSeverity.Warn">@locationWarning</InfoPopover>
			</span>
		</div>
	}

	@* Above the rail, so it cannot hide with a section nobody is looking at. *@
	@if (!Model.EngineIsRunning || !Model.HomeAssistantIsAnswering)
	{
		<div class="notice warn info-host">
			@if (!Model.EngineIsRunning)
			{
				<span class="info-line">
					<strong>Adaptive lighting isn't running</strong>
					<InfoPopover Label="Not running" Severity="InfoSeverity.Bad">
						@Model.EngineFault Edits here are saved either way, and take effect when it starts.
					</InfoPopover>
				</span>
			}
			@if (!Model.HomeAssistantIsAnswering)
			{
				<span class="info-line">
					<strong>Waiting for Home Assistant</strong>
					<InfoPopover Label="Waiting" Severity="InfoSeverity.Bad">
						The pickers below have nothing to offer until it answers. Ids can still be typed by hand; they
						are not checked against Home Assistant on a save now.
					</InfoPopover>
				</span>
			}
		</div>
	}

	@* Only while there is something to say. It floats over the content, so it must not be permanent. *@
	@if (Model.ShowSaveBar)
	{
	<div class="savebar">
		<button type="button" class="primary" @onclick="Model.Save" disabled="@Model.IsBusy">Save and apply</button>
		<button type="button" @onclick="Model.Reload" disabled="@Model.IsBusy">Discard changes</button>

		@* Errors and refused saves stay until resolved. Only the success confirmation below is transient. *@
		@if (Model.SaveBarProblems is { Length: > 0 } problems)
		{
			<span class="savebar-note bad">@problems</span>
		}
		else if (Model.Result is { Written: false } result)
		{
			<span class="savebar-note bad">@result.Message</span>
		}

		@* Read at render against the page's own clock, so nothing has to clear it. *@
		@if (Model.SaveConfirmation.TextAt(Model.Now) is { Length: > 0 } confirmation)
		{
			<span class="savebar-note ok savebar-toast" role="status">@confirmation</span>
		}
	</div>
	}

	@* Validator messages verbatim, and above the rail: an error in an unopened section still refuses the save,
	   so it must not hide with its section. *@
	@if (Model.HasValidationNotice && Model.Validation is { } validation)
	{
		<div class="notice @(validation.IsValid ? "warn" : "bad") info-host validation-lines">
			@if (validation.Errors.Count > 0)
			{
				<span class="info-line">
					<strong>@ValidationHeadline.Errors(validation.Errors.Count)</strong>
					<InfoPopover Label="Fix before saving" Severity="InfoSeverity.Bad">
						@foreach (string error in validation.Errors)
						{
							<span class="info-para">@ValidationWording.Plain(error)</span>
						}
					</InfoPopover>
				</span>
			}
			@if (validation.AreaErrors.Count > 0)
			{
				<span class="info-line">
					<strong>@ValidationHeadline.SkippedRooms(validation.AreaErrors.Count)</strong>
					<InfoPopover Label="Skipped rooms" Severity="InfoSeverity.Warn">
						<span class="info-para">Everything else still works, and saving still works.</span>
						@foreach (AreaError areaError in validation.AreaErrors)
						{
							<span class="info-para"><b>@areaError.AreaName</b>: @ValidationWording.Plain(areaError.Message)</span>
						}
					</InfoPopover>
				</span>
			}
			@if (validation.Warnings.Count > 0)
			{
				<span class="info-line">
					<strong>@ValidationHeadline.Warnings(validation.Warnings.Count)</strong>
					<InfoPopover Label="Worth knowing" Severity="InfoSeverity.Warn">
						<span class="info-para">None of these stops anything.</span>
						@foreach (string warning in validation.Warnings)
						{
							<span class="info-para">@ValidationWording.Plain(warning)</span>
						}
					</InfoPopover>
				</span>
			}
		</div>
	}

	<div class="config-layout">
		<nav class="config-nav" aria-label="Configuration sections">
			@foreach (HouseSection section in HousePageModel.Sections)
			{
				HouseSection item = section;

				<button type="button" class="config-nav-link @(Model.IsActive(item) ? "active" : null)" @onclick="() => Model.Show(item)">
					<Icon Name="@IconOf(item)" Class="config-nav-icon" />
					<span class="config-nav-text">@HousePageModel.TitleOf(item)</span>
					@if (Model.CountOf(item) is { } count)
					{
						<span class="config-nav-count">@count</span>
					}
				</button>
			}
		</nav>

		<div class="config-body">
			@if (Model.IsActive(HouseSection.Areas))
			{
				<HouseRoomsSection Model="@Model" />
			}
			else if (Model.IsActive(HouseSection.Schedule))
			{
				<HouseScheduleSection Model="@Model" />
			}
			else if (Model.IsActive(HouseSection.HouseModes))
			{
				<HouseModesSection Model="@Model" />
			}
			else
			{
				<HouseFoldsSection Model="@Model" />
			}
		</div>
	</div>
}

@code {
	private HousePageModel? _model;

	/// <summary>Which section to open on load; read once, after which the rail owns the choice.</summary>
	[Parameter]
	[SupplyParameterFromQuery(Name = "section")]
	public string? SectionQuery { get; set; }

	private HousePageModel Model => _model!;

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		_model = new HousePageModel(Engine, Catalog, Location, HomeGeo, Cache, Logger);
		_model.Changed += Redraw;
		_model.Start(SectionQuery);
	}

	/// <summary>The icon this design gives a section.</summary>
	private static string IconOf(HouseSection section) => section switch
	{
		HouseSection.Areas => Glyph.Areas,
		HouseSection.Schedule => Glyph.Schedule,
		HouseSection.HouseModes => Glyph.Modes,
		_ => Glyph.House
	};

	/// <summary>Asks the browser before an unsaved edit is walked away from.</summary>
	private async Task ConfirmLeave(LocationChangingContext context)
	{
		if (!Model.HasUnsavedEdits)
			return;

		if (!await Js.InvokeAsync<bool>("confirm", HousePageModel.LeaveQuestion))
			context.PreventNavigation();
	}

	// The model's clock runs off the render thread, so the hop back onto it belongs here.
	private void Redraw() => _ = InvokeAsync(StateHasChanged);

	/// <inheritdoc/>
	public void Dispose()
	{
		if (_model is null)
			return;

		_model.Changed -= Redraw;
		_model.Dispose();
	}
}
