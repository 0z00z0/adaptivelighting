	/// <summary>
	///     Whether a section of the detail view is open — which, until somebody opens one, is none of them.
	/// </summary>
	/// <remarks>
	///     The same rule the room page's <i>All settings</i> follows, and for the same reason: folded, the headings
	///     are what a reader meets, and the structure is legible before any of it has to be read.
	/// </remarks>
	private bool IsOpen(RoomSettingGroup group) => _openedGroups.Contains(group.Title);

	private void Toggle(RoomSettingGroup group)
	{
		if (!_openedGroups.Remove(group.Title))
			_openedGroups.Add(group.Title);
