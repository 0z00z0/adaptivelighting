@page "/"
@page "/modes"
@implements IDisposable
@inject AreaSnapshotCache Cache
@inject ActivityLog Log
@inject LightingEngineHost Engine
@inject DocumentCache Documents
@inject ModeService Service
@inject HaCatalog Catalog
@inject ILogger<Dashboard> Logger

@* The layout rules live in BoardView so a test can hold them, and everything this page knows and does lives in
   DashboardPageModel, so a second design puts its own markup over the same rules. What is left here is markup,
   styling and the wiring of presses to that model. Read-only about configuration: the house-mode selector
   commands Home Assistant through ModeService, and nothing here writes the document. The master switch itself
   lives under Configuration &rarr; House, not here — see the "Master switch" fold. The /modes route is kept so
   old bookmarks land here. *@

<PageTitle>Dashboard &mdash; Adaptive lighting</PageTitle>

@* Off the clock: these two are drawn again only when one of them has actually moved. *@
<div class="housebar">
	@* Read at render against the page's own clock, so nothing has to clear it. *@
	<HouseModePanel HouseMode="_model.HouseMode" Message="@_model.ModeMessage" Confirmation="@_model.ModeConfirmation.TextAt(_model.Now)" OnSelect="_model.SelectMode" />
	<WhoIsHomePanel People="_model.People" />
</div>

@if (_model.KillSwitchActive)
{
	<div class="notice bad info-host">
		<span class="info-line">
			<strong>Adaptive lighting is paused</strong>
			<InfoPopover Label="Paused" Severity="InfoSeverity.Bad">
				Nothing was turned off, but no lights will change until it is turned back on above.
			</InfoPopover>
		</span>
	</div>
}
else if (!_model.EngineIsRunning && _model.HasData)
{
	<div class="notice bad info-host">
		<span class="info-line">
			<strong>Adaptive lighting has stopped</strong>
			<InfoPopover Label="Stopped" Severity="InfoSeverity.Bad">
				@if (_model.EngineFault is { Length: > 0 } fault)
				{
					<span class="info-para">@fault</span>
				}
				<span class="info-para">The timeline below shows what each room was doing when it stopped.</span>
			</InfoPopover>
		</span>
	</div>
}

@* The empty states, in precedence order: a broken connection and a stopped engine are answered before the
   first-run state, so neither is dressed up as onboarding. *@
@if (!_model.HasData && !_model.EngineIsAttached)
{
	<div class="empty info-host">
		<strong>
			Connecting to Home Assistant&hellip;
			<InfoPopover Label="Connecting">Normal for a minute after a restart. If it doesn't clear, the connection is down.</InfoPopover>
		</strong>
	</div>
}
else if (!_model.HasData && !_model.EngineIsRunning)
{
	<div class="empty info-host">
		<strong>
			Adaptive lighting isn't running
			<InfoPopover Label="Not running" Severity="InfoSeverity.Bad">
				Connected to Home Assistant. @(_model.EngineFault ?? "No reason was recorded.")
			</InfoPopover>
		</strong>
		<p><a href="config">Configuration</a></p>
	</div>
}
else if (_model.AwaitingRoomChoice)
{
	@* A state and not a route: the moment the commit lands the condition above is false and this same page
	   renders the live board. CommissioningBoard owns the draft and its single Save, so it stays off the clock. *@
	<CommissioningBoard People="_model.People" Committed="_model.OnCommissioned" />
}
else if (!_model.HasData)
{
	<div class="empty info-host">
		<strong>
			Starting up&hellip;
			<InfoPopover Label="Starting up">Waiting for the first report from the rooms. This normally takes a few seconds.</InfoPopover>
		</strong>
	</div>
}
else if (_model.Lanes.Count == 0)
{
	@* Reports have arrived, but none from a room that is switched on. *@
	<div class="empty info-host">
		<strong>
			No room has reported yet
			<InfoPopover Label="No reports">None of the rooms switched on has reported yet. Each one gets a lane here as it checks in.</InfoPopover>
		</strong>
	</div>
}
else
{
	@* On the clock: the now-line walks, every countdown drains and every log row is dated relative to now. *@
	<TickRegion Clock="@_model">
	<div class="tray">
		@foreach (AreaSnapshot area in _model.Exceptions)
		{
			<a class="tray-chip @TrayEdge(area.State)" href="@HouseView.RoomHref(area.AreaId)">
				<StateChip State="area.State" Kelvin="area.ColorTempKelvin" Bare="true" IsLeadIn="@(area.IsLeadIn ?? false)" IsOff="@StateGlyph.IsOffByLevel(area)" />
				<span class="tray-text"><b>@area.AreaName</b> &mdash; @_model.ExceptionLine(area)</span>
			</a>
		}
		<span class="tray-quiet">@_model.QuietRoomsLine</span>
	</div>

	<section class="board">
		<div class="board-head">
			<h2 class="board-title"><Icon Name="@Glyph.Lanes" Class="ic-head" />Timeline</h2>
			<span class="board-span">@_model.WindowStartClock &rarr; @_model.WindowEndClock</span>
			<span class="board-since">@_model.SinceLine</span>
		</div>

		@* The axis, the band and every lane share one grid, so a block, its hour and its period line up. *@
		<div class="board-scroll">
			<div class="board-grid" style="--hour-w: @Pct(100.0 / _model.Window.Hours)%">
				<div class="board-axis">
					<div class="board-gutter"></div>
					<div class="board-track board-track-bare">
						@* An hour the now-tag sits on is skipped, so the two do not overlap. *@
						@for (int index = 0; index < _model.Ticks.Count; index++)
						{
							double at = index * 100.0 / _model.Window.Hours;

							@if (Math.Abs(at - _model.NowPercent) >= 3.5)
							{
								<span class="board-tick @TickClass(index)" style="left: @Pct(at)%">
									@_model.Ticks[index].ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)
								</span>
							}
						}
					</div>
				</div>

				<div class="board-band">
					<div class="board-gutter"></div>
					<div class="board-track board-track-bare">
						@if (_model.Band.Count == 0)
						{
							<span class="board-band-none">no schedule could be placed</span>
						}
						@foreach (BandSegment segment in _model.Band)
						{
							<span class="band-seg"
								  style="left: @Pct(segment.LeftPct)%; width: @Pct(segment.WidthPct)%; background: @KelvinColour.Css(segment.Kelvin)"
								  title="@($"{segment.Name} — {segment.Kelvin} K")"></span>

							@if (DashboardPageModel.IsLabelled(segment))
							{
								<span class="band-name" style="left: @Pct(segment.LeftPct)%">@segment.Name</span>
							}
						}
					</div>
				</div>

				<div class="board-lanes">
					@foreach (FloorGroup<BoardLane> group in _model.Groups)
					{
						IReadOnlyList<BoardLane> busy = [.. group.Items.Where(lane => !_model.IsQuiet(lane))];

						@* A floor is headed only when it has a busy lane to head. *@
						@if (busy.Count > 0 && _model.ShowsFloorHeader(group))
						{
							<div class="board-floor">
								<span class="board-floor-name">@DashboardPageModel.FloorTitle(group.Floor)</span>
							</div>
						}

						@foreach (BoardLane lane in busy)
						{
							<a class="lane" href="@HouseView.RoomHref(lane.AreaId)" title="@_model.LaneTitle(lane)" @key="lane.Key">
								<span class="lane-name">
									<StateChip State="lane.Latest.State" Kelvin="lane.Latest.ColorTempKelvin" Bare="true" IsLeadIn="@(lane.Latest.IsLeadIn ?? false)" IsOff="@StateGlyph.IsOffByLevel(lane.Latest)" />
									<span class="lane-room">@lane.Name</span>
									@if (DashboardPageModel.HasWarning(lane.Latest))
									{
										<span class="lane-dropout" aria-hidden="true">!</span>
									}
								</span>
								<span class="board-track">
									@foreach (LaneBlock block in lane.Blocks)
									{
										<span class="blk blk-@block.Kind.ToString().ToLowerInvariant()"
											  style="left: @Pct(block.LeftPct)%; width: @Pct(block.WidthPct)%@(block.Kelvin is { } kelvin ? $"; --blk: {KelvinColour.Css(kelvin)}" : null)"></span>
									}
									@* After the blocks, so a refusal inside a lit stretch is not painted over, and before
									   the future mark, which sits above everything. aria-hidden because these are inside
									   the room's link, and each title would otherwise join the link's accessible name. *@
									@foreach (LaneRefusal refusal in lane.Refusals ?? [])
									{
										@* Past two thirds across the label opens leftwards: the track clips overflow
										   silently, so a reason near the right edge is cut mid-word. *@
										<span class="lane-refusal @(refusal.LeftPct > 66 ? "lane-refusal-late" : null)"
											  style="left: @Pct(refusal.LeftPct)%"
											  title="@refusal.Label" aria-hidden="true"><i>@refusal.Label</i></span>
									}
									@if (lane.Next is { } next)
									{
										<span class="lane-mark" style="left: @Pct(next.LeftPct)%"><i>@next.Label</i></span>
									}
								</span>
							</a>
						}
					}
				</div>

				@* Offset past the sticky name column so it stands where the tracks begin. *@
				<span class="board-now" style="left: @NowOffset"></span>
				<span class="board-now-tag" style="left: @NowOffset">@_model.NowClock</span>
			</div>
		</div>

		@if (_model.Quiet.Count > 0)
		{
			<div class="board-quiet">
				<span class="board-quiet-lab">Quiet since @_model.WindowStartClock</span>
				@foreach (FloorGroup<BoardLane> group in _model.Groups)
				{
					IReadOnlyList<BoardLane> resting = [.. group.Items.Where(lane => _model.IsQuiet(lane))];

					@if (resting.Count > 0)
					{
						@if (_model.ShowsFloorHeader(group))
						{
							<span class="board-quiet-floor">@DashboardPageModel.FloorTitle(group.Floor)</span>
						}

						@foreach (BoardLane lane in resting)
						{
							<a class="quiet-chip" href="@HouseView.RoomHref(lane.AreaId)" title="@_model.LaneTitle(lane)" @key="lane.Key">
								<StateChip State="lane.Latest.State" Kelvin="lane.Latest.ColorTempKelvin" Bare="true" IsLeadIn="@(lane.Latest.IsLeadIn ?? false)" IsOff="@StateGlyph.IsOffByLevel(lane.Latest)" />
								@lane.Name
								@if (DashboardPageModel.HasWarning(lane.Latest))
								{
									<span class="lane-dropout" aria-hidden="true">!</span>
								}
							</a>
						}
					}
				}
			</div>
		}

		@if (_model.Entries.Count == 0)
		{
			<p class="board-note info-host">
				<span class="info-line">
					Nothing recorded yet
					<InfoPopover Label="Timeline">Recording starts when adaptive lighting starts, and a room appears the first time it decides something.</InfoPopover>
				</span>
			</p>
		}

		@* The legend explains marks, so it appears only when the board has marks. *@
		<div class="board-foot">
			@if (_model.HasMarks)
			{
				<span class="board-key"><StateChip State="AreaState.AutoActive" Bare="true" Kelvin="2700" /><span class="board-swatch blk-lit" style="--blk: @KelvinColour.Css(2700)"></span> lit (colour = warmth)</span>
				<span class="board-key"><StateChip State="AreaState.OverriddenOn" Bare="true" /><span class="board-swatch blk-hand"></span> set manually</span>
				<span class="board-key"><StateChip State="AreaState.PreOff" Bare="true" /><span class="board-swatch blk-dimming"></span> warning dim</span>
				<span class="board-key"><StateChip State="AreaState.SuppressedOff" Bare="true" /><span class="board-swatch blk-held"></span> off manually</span>
				<span class="board-key"><span class="board-swatch board-swatch-refusal"></span> movement refused</span>
				<span class="board-key"><span class="board-swatch board-swatch-next"></span> what happens next</span>
			}
			<span class="board-foot-end info-host">
				<InfoPopover Label="Timeline">
					Tap a room for its page. Hover a refused movement for why. The colour of a lit block is the warmth the lights actually had.
				</InfoPopover>
			</span>
		</div>
	</section>

	@if (_model.HiddenRooms is { } hidden)
	{
		<p class="rooms-off">
			@hidden.Lead
			<a href="config?section=areas">@hidden.LinkText</a>.
		</p>
	}

	@* Filtered to ActivityView.SummaryCategories and not the Activity page's opening set, the board above
	   having drawn the routine already. The budget is spent after the filter, never before it. *@
	<div class="board-loghead">
		<h2 class="board-title">Worth knowing</h2>
		<span class="board-since">@_model.LogFoot</span>
	</div>

	@if (_model.Entries.Count == 0)
	{
		<div class="empty info-host">
			<strong>
				Nothing has happened yet
				<InfoPopover Label="Worth knowing">
					A quiet house can sit here for a long time. Each room appears the first time it decides
					something &mdash; movement, a change of house mode, or the light outside crossing the level it
					counts as dark.
				</InfoPopover>
			</strong>
		</div>
	}
	else if (_model.LogRows.Count == 0)
	{
		@* Reports exist, but not of the kind this summary carries. *@
		<div class="empty info-host">
			<strong>
				Nothing important yet
				<InfoPopover Label="Worth knowing">@_model.BackgroundOnlyLine</InfoPopover>
			</strong>
			<p><a href="activity">Activity</a></p>
		</div>
	}
	else
	{
		<ol class="log log-compact">
			@foreach (Presentation.ActivityRow row in _model.LogRows)
			{
				<ActivityRow @key="row.Sequence" Row="row" LinkRoom="true" />
			}
		</ol>

		<p class="log-foot"><a href="activity">All activity &rsaquo;</a></p>
	}
	</TickRegion>
}

@code {
	private DashboardPageModel _model = default!;

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		_model = new DashboardPageModel(Cache, Log, Engine, Documents, Service, Catalog, Logger, work => InvokeAsync(work));
		_model.Changed += StateHasChanged;
		_model.Start();
	}

	/// <summary>Which edge a tray chip carries: the warning dim is about to act, the other three are standing.</summary>
	private static string TrayEdge(AreaState state) => state == AreaState.PreOff ? "tray-warn" : "tray-human";

	/// <summary>Past the sticky name column, then the fraction of the track already elapsed.</summary>
	/// <remarks>The column width is a token, so the phone override moves the line with it.</remarks>
	private string NowOffset => $"calc(var(--lane-name) + (100% - var(--lane-name)) * {Pct(_model.NowPercent / 100.0)})";

	/// <summary>The first tick hangs off the left edge and the last off the right, so neither is clipped.</summary>
	private string? TickClass(int index) =>
		index == 0 ? "board-tick-first" : index == _model.Window.Ticks.Count - 1 ? "board-tick-last" : null;

	// Invariant, always. Under nb-NO a double renders 62,5 and "left: 62,5%" is not a length, so the
	// declaration is dropped and every block on the board stacks at the left edge.
	private static string Pct(double value) => InvariantNumber.Format(value, 3);

	/// <inheritdoc/>
	public void Dispose()
	{
		_model.Changed -= StateHasChanged;
		_model.Dispose();
	}
}
