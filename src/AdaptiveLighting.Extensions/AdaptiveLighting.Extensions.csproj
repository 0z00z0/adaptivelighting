<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Named apart from upstream's NetDaemon.Extensions.* packages, so this DLL is never mistaken for one of theirs. -->
    <AssemblyName>AdaptiveLighting.Extensions</AssemblyName>
    <RootNamespace>AdaptiveLighting.Extensions</RootNamespace>
    <PackageId>AdaptiveLighting.Extensions</PackageId>
    <Description>Small, host-agnostic extension methods over NetDaemon's HassModel - reading entity state and attributes tolerantly, on/off and availability checks, service calls, area/registry lookups and safe observable subscriptions. Used by AdaptiveLighting, and useful on its own in any NetDaemon app. References no generated entity types.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NetDaemon.HassModel carries the whole extension surface. NetDaemon.AppModel is here only for
      AppConfigurationLocationSetting, which Persistence/StateRepository binds. No host project and no
      generated entity types. Keep 26.36.0 in step with the rest of the graph (NU1605).
    -->
    <PackageReference Include="NetDaemon.AppModel" Version="26.36.0" />
    <PackageReference Include="NetDaemon.HassModel" Version="26.36.0" />
  </ItemGroup>

</Project>
