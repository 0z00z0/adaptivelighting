<Project Sdk="Microsoft.NET.Sdk">

	<!-- Framework, nullability and the package metadata come from Directory.Build.props. -->
	<PropertyGroup>
		<RootNamespace>AdaptiveLighting.NetDaemon</RootNamespace>
		<PackageId>AdaptiveLighting.NetDaemon</PackageId>
		<Description>Binds AdaptiveLighting into a NetDaemon host in one line. Registers the engine, the Blazor UI, static web assets, antiforgery and a DataProtection key ring that survives a deploy, and stamps the log with an ISO timestamp. A house supplies its own AdaptiveLighting:ConfigPath and port; everything else the library knows about hosting itself lives here rather than in each host's program.cs.</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- Same reasoning as AdaptiveLighting.Web: the host owns which ASP.NET Core it runs on. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Serilog rather than the abstractions: this package replaces the logger NetDaemon configures, and
			the whole point is the output template. Kept in step with the host's own Serilog by the shared
			framework only insofar as ASP.NET Core does; a mismatch here would show up as a build error, not
			as silent double logging.
		-->
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AdaptiveLighting.Web\AdaptiveLighting.Web.csproj" />
	</ItemGroup>

</Project>
