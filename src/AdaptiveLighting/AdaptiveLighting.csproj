<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AdaptiveLighting</PackageId>
    <Description>Motion- and daylight-driven adaptive lighting for Home Assistant, as a NetDaemon library. Per-room state machines, a house-wide circadian schedule, lux/sun darkness gating, manual-override detection and house modes (Normal/Sleep/Away/Guest) with scenes. Configured from YAML or the companion web UI; references no generated entity types, so it runs against any Home Assistant instance.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only what the engine compiles against: NetDaemon.AppModel for the app-model and logging abstractions,
      NetDaemon.HassModel for IHaContext and the entity and registry types. The engine schedules on
      System.Reactive's IScheduler and logs through Microsoft.Extensions.Logging, so no NetDaemon.Extensions.*
      package is needed here; hosts reference the ones they use.
    -->
    <PackageReference Include="NetDaemon.AppModel" Version="26.36.0" />
    <PackageReference Include="NetDaemon.HassModel" Version="26.36.0" />
    <!--
      Explicit: LightingConfigDocument compiles against YamlDotNet directly. 18.1.0 is the floor
      NetDaemon.AppModel 26.36.0 declares; below it, restore fails with NU1605.
    -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaptiveLighting.Extensions\AdaptiveLighting.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdaptiveLighting.Tests" />
  </ItemGroup>

</Project>
