@using AdaptiveLighting.Lamplight.Components.Kit

<section aria-label="Rooms">
	<h2 class="sec-h">Rooms</h2>

	<div class="tiles">
		@foreach (RoomTile room in Rooms)
		{
			@if (room.Lamp.IsLit)
			{
				<a class="tile lit lamp-glow" href="@HouseView.RoomHref(room.AreaId)" style="@Paint(room.Lamp)" @key="@(room.AreaId ?? room.Name)">
					<b>@room.Name</b>
					@if (room.Lamp.IsHandHeld)
					{
						<Chip Kind="hand" Word="by hand" />
					}
					<span class="pct">
						<i class="lampdot" aria-hidden="true"></i>
						@if (room.Lamp.BrightnessPct is { } pct)
						{
							<span>@pct&nbsp;%</span>
						}
						else
						{
							<span>lit</span>
						}
						@if (room.Lamp.Kelvin is { } kelvin)
						{
							<small>@kelvin&nbsp;K</small>
						}
					</span>
				</a>
			}
			else
			{
				<a class="tile dark" href="@HouseView.RoomHref(room.AreaId)" @key="@(room.AreaId ?? room.Name)">
					<b>@room.Name</b>
					<span class="pct"><i class="lampdot dark" aria-hidden="true"></i>off</span>
				</a>
			}
		}
	</div>

	@if (Hidden is { } hidden)
	{
		<p class="d2-hidden">@hidden.Lead <a href="settings?section=areas">@hidden.LinkText</a>.</p>
	}
</section>

@code {
	[Parameter, EditorRequired]
	public IReadOnlyList<RoomTile> Rooms { get; set; } = [];

	[Parameter]
	public HiddenRoomsNote? Hidden { get; set; }

	private static string? Paint(RoomLamp lamp) => LampPaint.Style(lamp.IsLit, lamp.BrightnessPct, lamp.Kelvin);
}
