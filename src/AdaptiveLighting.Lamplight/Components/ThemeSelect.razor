@inject IJSRuntime Js
@inject ILogger<ThemeSelect> Logger

@* Stored in the browser and never in the document; LamplightThemes owns the list and the fallback for an
	unknown id. Native select: nothing here needs an EntityPicker's search or a popover, and both are
	composition this package does not reuse. *@
<label class="theme-picker">
	<span class="theme-picker-label">Theme</span>
	<select class="theme-select" @bind:get="_selected" @bind:set="OnPicked">
		<option value="@LamplightThemes.System.Id">@LamplightThemes.System.Name</option>
		<optgroup label="Dark">
			@foreach (LamplightTheme theme in LamplightThemes.All.Skip(1).Where(theme => theme.IsDark))
			{
				<option value="@theme.Id">@theme.Name</option>
			}
		</optgroup>
		<optgroup label="Light">
			@foreach (LamplightTheme theme in LamplightThemes.All.Skip(1).Where(theme => !theme.IsDark))
			{
				<option value="@theme.Id">@theme.Name</option>
			}
		</optgroup>
	</select>
</label>

@code {
	// The first paint happens before any circuit exists, so the server cannot know what this browser stored.
	// lamplight-theme.js has already painted by then, and only the select's chosen option needs correcting.
	private string _selected = LamplightThemes.System.Id;

	// An exception out of OnAfterRenderAsync or an event handler is an unhandled circuit exception, and this
	// component sits in the layout, so it would take every page down.
	private static bool IsSurvivable(Exception exception) =>
		exception is JSDisconnectedException or JSException or OperationCanceledException;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		string? stored;

		try
		{
			stored = await Js.InvokeAsync<string?>("lamplightTheme.stored");
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			Logger.LogDebug(exception, "Could not read the stored theme; the picker keeps its default selection.");
			return;
		}

		LamplightTheme theme = LamplightThemes.Resolve(stored);

		if (theme.Id == _selected)
		{
			return;
		}

		_selected = theme.Id;
		StateHasChanged();
	}

	// Resolved before storing, so the id written is one this build ships; the head script applies the same rule.
	private async Task OnPicked(string picked)
	{
		LamplightTheme theme = LamplightThemes.Resolve(picked);
		_selected = theme.Id;

		try
		{
			await Js.InvokeVoidAsync("lamplightTheme.apply", theme.Id);
		}
		catch (Exception exception) when (IsSurvivable(exception))
		{
			// The pick is lost, not the page; the top bar has no surface to report it on.
			Logger.LogWarning(exception, "Could not apply the theme '{Theme}' in the browser.", theme.Id);
		}
	}
}
