@page "/"
@implements IDisposable
@using AdaptiveLighting.Lamplight.Components.Dashboard
@using AdaptiveLighting.Web.Components
@inject AreaSnapshotCache Cache
@inject ActivityLog Log
@inject LightingEngineHost Engine
@inject DocumentCache Documents
@inject ModeService Service
@inject HaCatalog Catalog
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard &mdash; Adaptive lighting</PageTitle>

<h1 class="sr-only">Dashboard</h1>

<DashboardNotices Model="_model" />

@if (_model.AwaitingRoomChoice)
{
	<p class="glass lede">No room has been switched on for adaptive lighting yet. Rooms are chosen on the first design&rsquo;s dashboard.</p>
}
else
{
	<HouseCard Model="_model" />

	@* On the clock: the now-line walks and the tiles follow each report. *@
	<TickRegion Clock="@_model">
		<Timeline Model="_model" />
		<RoomTiles Rooms="_model.Rooms" Hidden="_model.HiddenRooms" />
		<WorthKnowing Model="_model" />
	</TickRegion>
}

@code {
	private DashboardPageModel _model = default!;

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		_model = new DashboardPageModel(Cache, Log, Engine, Documents, Service, Catalog, Logger, work => InvokeAsync(work));
		_model.Changed += StateHasChanged;
		_model.Start();
	}

	/// <inheritdoc/>
	public void Dispose()
	{
		_model.Changed -= StateHasChanged;
		_model.Dispose();
	}
}
