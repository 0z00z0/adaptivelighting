@page "/settings"
@implements IDisposable
@using Microsoft.JSInterop
@using AdaptiveLighting.Configuration
@using AdaptiveLighting.Lamplight.Components.Settings
@using AdaptiveLighting.Lamplight.Components.Kit
@inject LightingEngineHost Engine
@inject HaCatalog Catalog
@inject ConfigLocation Location
@inject HomeLocation HomeGeo
@inject AreaSnapshotCache Cache
@inject ModeService Modes
@inject ILogger<HousePageModel> Logger
@inject IJSRuntime Js

<PageTitle>Settings &mdash; Adaptive lighting</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="@Model.HasUnsavedEdits" />

<h1 class="sr-only">Settings</h1>

@if (Model.LoadError is { Length: > 0 } loadError)
{
	<div class="notice bad">
		<span class="info-line">
			<strong>Settings file unreadable</strong>
			<Info Label="Settings file" Severity="InfoSeverity.Bad">
				<span class="info-para">@loadError</span>
				<span class="info-para">
					The file is <code>@Model.ConfigFilePath</code>. Fix it by hand, or press <em>Start from scratch</em>
					&mdash; the old file is kept as <code>@Model.BackupPath</code> when saved.
				</span>
			</Info>
		</span>
		<button type="button" @onclick="Model.StartFromScratch">Start from scratch</button>
	</div>
}
else
{
	@if (Model.LocationWarning is { Length: > 0 } locationWarning)
	{
		<div class="notice warn">
			<span class="info-line">
				<strong>A deploy overwrites these edits</strong>
				<Info Label="Settings file" Severity="InfoSeverity.Warn">@locationWarning</Info>
			</span>
		</div>
	}

	@if (!Model.EngineIsRunning || !Model.HomeAssistantIsAnswering)
	{
		<div class="notice warn">
			@if (!Model.EngineIsRunning)
			{
				<span class="info-line">
					<strong>Adaptive lighting isn&rsquo;t running</strong>
					<Info Label="Not running" Severity="InfoSeverity.Bad">
						@Model.EngineFault Edits here are saved either way, and take effect when it starts.
					</Info>
				</span>
			}
			@if (!Model.HomeAssistantIsAnswering)
			{
				<span class="info-line">
					<strong>Waiting for Home Assistant</strong>
					<Info Label="Waiting" Severity="InfoSeverity.Bad">
						The pickers below have nothing to offer until it answers. Ids can still be typed by hand; they are
						not checked against Home Assistant if saved now.
					</Info>
				</span>
			}
		</div>
	}

	@if (Model.HasValidationNotice && Model.Validation is { } validation)
	{
		<div class="notice @(validation.IsValid ? "warn" : "bad")">
			@if (validation.Errors.Count > 0)
			{
				<span class="info-line">
					<strong>@ValidationHeadline.Errors(validation.Errors.Count)</strong>
					<Info Label="Fix before saving" Severity="InfoSeverity.Bad">
						@foreach (string error in validation.Errors)
						{
							<span class="info-para">@ValidationWording.Plain(error)</span>
						}
					</Info>
				</span>
			}
			@if (validation.AreaErrors.Count > 0)
			{
				<span class="info-line">
					<strong>@ValidationHeadline.SkippedRooms(validation.AreaErrors.Count)</strong>
					<Info Label="Skipped rooms" Severity="InfoSeverity.Warn">
						<span class="info-para">Everything else still works, and can still be saved.</span>
						@foreach (AreaError areaError in validation.AreaErrors)
						{
							<span class="info-para"><strong>@areaError.AreaName</strong>: @ValidationWording.Plain(areaError.Message)</span>
						}
					</Info>
				</span>
			}
			@if (validation.Warnings.Count > 0)
			{
				<span class="info-line">
					<strong>@ValidationHeadline.Warnings(validation.Warnings.Count)</strong>
					<Info Label="Worth knowing" Severity="InfoSeverity.Warn">
						<span class="info-para">None of these stops anything.</span>
						@foreach (string warning in validation.Warnings)
						{
							<span class="info-para">@ValidationWording.Plain(warning)</span>
						}
					</Info>
				</span>
			}
		</div>
	}

	<nav class="subnav" aria-label="Settings">
		<a href="settings?section=house" class="@(HouseTabActive ? "cur" : null)" @onclick="() => Model.Show(HouseSection.House)" @onclick:preventDefault="true">House</a>
		<a href="settings?section=schedule" class="@(Model.IsActive(HouseSection.Schedule) ? "cur" : null)" @onclick="() => Model.Show(HouseSection.Schedule)" @onclick:preventDefault="true">Schedule</a>
		<a href="settings?section=housemodes" class="@(Model.IsActive(HouseSection.HouseModes) ? "cur" : null)" @onclick="() => Model.Show(HouseSection.HouseModes)" @onclick:preventDefault="true">House modes</a>
	</nav>

	@if (HouseTabActive)
	{
		<HouseOverview Model="@Model" />
	}
	else if (Model.IsActive(HouseSection.Schedule))
	{
		<ScheduleTab Model="@Model" />
	}
	else
	{
		<ModesTab Model="@Model" />
	}

	@if (Model.ShowSaveBar)
	{
		<div class="savebar-fixed">
			<button type="button" class="primary" @onclick="Model.Save" disabled="@Model.IsBusy">Save and apply</button>
			<button type="button" @onclick="Model.Reload" disabled="@Model.IsBusy">Discard changes</button>

			@if (Model.SaveBarProblems is { Length: > 0 } problems)
			{
				<span class="savebar-note bad">@problems</span>
			}
			else if (Model.Result is { Written: false } result)
			{
				<span class="savebar-note bad">@result.Message</span>
			}

			@if (Model.SaveConfirmation.TextAt(Model.Now) is { Length: > 0 } confirmation)
			{
				<span class="savebar-note ok savebar-toast" role="status">@confirmation</span>
			}
		</div>
	}
}

@code {
	private HousePageModel? _model;

	/// <summary>Which section to open on load; read once, after which the sub-navigation owns the choice.</summary>
	[Parameter]
	[SupplyParameterFromQuery(Name = "section")]
	public string? SectionQuery { get; set; }

	private HousePageModel Model => _model!;

	// The former "Areas" tab is folded into Lamplight's "House" body, so a link built for it
	// (the dashboard's hidden-rooms note points at ?section=areas) still lands somewhere.
	private bool HouseTabActive => Model.IsActive(HouseSection.House) || Model.IsActive(HouseSection.Areas);

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		_model = new HousePageModel(Engine, Catalog, Location, HomeGeo, Cache, Modes, Logger);
		_model.Changed += Redraw;
		_model.Start(SectionQuery);
	}

	private async Task ConfirmLeave(LocationChangingContext context)
	{
		if (!Model.HasUnsavedEdits)
			return;

		if (!await Js.InvokeAsync<bool>("confirm", HousePageModel.LeaveQuestion))
			context.PreventNavigation();
	}

	private void Redraw() => _ = InvokeAsync(StateHasChanged);

	/// <inheritdoc/>
	public void Dispose()
	{
		if (_model is null)
			return;

		_model.Changed -= Redraw;
		_model.Dispose();
	}
}
