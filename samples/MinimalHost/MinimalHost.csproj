<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>MinimalHost</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!--
		AdaptiveLighting.NetDaemon brings AdaptiveLighting, AdaptiveLighting.Web and
		AdaptiveLighting.Extensions transitively, plus the NetDaemon.AppModel/HassModel versions they
		were built against. Only the NetDaemon pieces this host calls directly are listed here.
	-->
	<ItemGroup>
		<PackageReference Include="AdaptiveLighting.NetDaemon" Version="2.0.0-preview.4" />
		<PackageReference Include="NetDaemon.Runtime" Version="26.21.0" />
		<PackageReference Include="NetDaemon.Extensions.Logging" Version="26.21.0" />
		<PackageReference Include="NetDaemon.Extensions.Scheduling" Version="26.21.0" />
	</ItemGroup>

</Project>
